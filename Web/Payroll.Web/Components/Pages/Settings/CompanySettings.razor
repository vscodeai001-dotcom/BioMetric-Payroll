@page "/settings/company"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Web.Components.Pages.Settings
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject ILogger<CompanySettings> _logger
@inject IToastService toastService
@inject AuthenticationStateProvider AuthState
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject Payroll.Web.Services.GeoLocationService GeoService
@inject Payroll.Web.Services.FirebaseRealtimeService FirebaseRealtime
@inject Payroll.Web.Services.ITenantContextService TenantContext
@inject Payroll.Web.Services.TenantManagementService TenantManager
@inject NavigationManager Navigation
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Company Settings</PageTitle>

<div class="page-header-container mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-primary">
            🏢
        </div>
        <div>
            <h2 class="page-header-title">
                Company & Organization Settings
            </h2>
            <p class="page-header-subtitle">
                <span>⚙️ Configure enterprise business rules, work shifts, statutory taxes, and notifications</span>
            </p>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="action-pill-btn action-pill-btn-primary" @onclick="SaveSettings" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm me-2"></span>
                <span>Saving Policies...</span>
            }
            else
            {
                <span>💾 Save Company Settings</span>
            }
        </button>
    </div>
</div>

@if (settings == null)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Loading settings profile... 🏢</p>
    </div>
}
else
{
    <ul class="nav nav-pills mb-3 gap-2">
        <li class="nav-item">
            <button class="nav-link rounded-pill @(activeTab == "general" ? "active" : "")" @onclick="@(() => activeTab = "general")">
                <span>🏢 General & Rules</span>
            </button>
        </li>

        @if (isSuperAdmin || features?.EnableStatutoryCompliance == true || features?.EnableProfessionalTax == true)
        {
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "statutory" ? "active" : "")" @onclick="@(() => activeTab = "statutory")">
                    <span>🏛️ Statutory (Tax)</span>
                </button>
            </li>
        }

        @if (isSuperAdmin || features?.EnableEmailNotifications == true)
        {
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "email" ? "active" : "")" @onclick="@(() => activeTab = "email")">
                    <span>📧 Email Config</span>
                </button>
            </li>
        }
        @if (isSuperAdmin || features?.EnableLeaveManagement == true)
        {
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "leave" ? "active" : "")" @onclick="@(() => activeTab = "leave")">
                    <span>🏖️ Leave Rules</span>
                </button>
            </li>
        }
    </ul>

    <div class="card shadow-sm">
        <div class="card-body p-3">

            <div class="@(activeTab == "general" ? "" : "d-none")">
                <GeneralTab Settings="settings" TrackingIntervalSeconds="trackingIntervalSeconds" TrackingIntervalSecondsChanged="OnTrackingIntervalChanged" />
            </div>

            <div class="@(activeTab == "statutory" ? "" : "d-none")">
                <StatutoryTab Settings="settings" Features="features" IsSuperAdmin="isSuperAdmin" />
            </div>

            <div class="@(activeTab == "email" ? "" : "d-none")">
                <EmailTab Settings="settings" />
            </div> 
            
            <div class="@(activeTab == "leave" ? "" : "d-none")">
                <LeaveSettingsTab Settings="settings" Features="features" IsSuperAdmin="isSuperAdmin" />
            </div>

        </div>
    </div>

    @if (isAuthorizedDeleteSuperAdmin)
    {
        <div class="card border border-danger shadow-sm mt-4 rounded-4 overflow-hidden">
            <div class="card-header bg-danger text-white py-3 px-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <h5 class="mb-0 fw-bold">Danger Zone: Permanent Company Deletion</h5>
                </div>
                <span class="badge bg-white text-danger fw-bold px-3 py-2 rounded-pill">
                    SuperAdmin Only (@TenantManagementService.AuthorizedSuperAdminDeleteEmail)
                </span>
            </div>
            <div class="card-body p-4 bg-danger-subtle bg-opacity-25">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <h6 class="fw-bold text-danger mb-1">
                            Delete Entire Company &amp; All Associated Data
                        </h6>
                        <p class="small text-danger mb-0">
                            Permanently delete <strong>@(activeTenant?.CompanyName ?? settings?.CompanyName ?? "this company")</strong> from BOTH Local SQLite Database and Firebase Cloud. All employee rosters, attendance history, GPS breadcrumbs, and payroll data will be erased.
                        </p>
                        <p class="small text-muted mb-0 mt-1">
                            Only your SuperAdmin login (<code>@TenantManagementService.AuthorizedSuperAdminDeleteEmail</code>) will be preserved.
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <button class="btn btn-danger fw-bold rounded-pill px-4 py-2 shadow-sm" @onclick="OpenDeleteCompanyModal">
                            <i class="bi bi-trash3-fill me-1"></i> Delete Entire Company
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (showDeleteCompanyModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white px-4 py-3">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-shield-slash-fill"></i> Confirm Permanent Deletion
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteCompanyModal" disabled="@isDeletingCompany"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-danger d-flex align-items-start gap-2 mb-3 rounded-3">
                        <i class="bi bi-exclamation-octagon-fill fs-5 mt-1 flex-shrink-0"></i>
                        <div>
                            <strong>CRITICAL WARNING:</strong> You are about to permanently delete <strong>@(activeTenant?.CompanyName ?? settings?.CompanyName ?? "Company")</strong>.
                            <ul class="mb-0 mt-2 ps-3 small">
                                <li>All staff profiles and employee accounts will be deleted.</li>
                                <li>All punches, GPS tracking history, and daily attendance logs will be erased.</li>
                                <li>All payroll runs, advances, and bonuses will be erased.</li>
                                <li>Cloud records in Firebase Realtime Database will be erased.</li>
                            </ul>
                        </div>
                    </div>

                    <p class="small text-secondary mb-2">
                        To verify this action, please type <strong>DELETE</strong> in the box below:
                    </p>
                    <input type="text" class="form-control rounded-3 mb-3 fw-bold" placeholder="Type DELETE to confirm" @bind="deleteConfirmText" @bind:event="oninput" disabled="@isDeletingCompany" />

                    @if (!string.IsNullOrWhiteSpace(deleteErrorMessage))
                    {
                        <div class="alert alert-warning py-2 px-3 small rounded-3 mb-0">
                            @deleteErrorMessage
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light px-4 py-3">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" @onclick="CloseDeleteCompanyModal" disabled="@isDeletingCompany">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold" @onclick="ExecuteDeleteCompanyAsync" disabled="@(isDeletingCompany || deleteConfirmText?.Trim().ToUpperInvariant() != "DELETE")">
                        @if (isDeletingCompany)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>Deleting Company...</span>
                        }
                        else
                        {
                            <span>Permanently Delete</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    body.dark .table-striped > tbody > tr:nth-of-type(odd) > * {
        --bs-table-accent-bg: #2c3034;
        color: #fff;
    }

    body.dark .table-striped > tbody > tr:nth-of-type(even) > * {
        background-color: #212529;
        color: #fff;
    }

    body.dark .modal-content {
        background-color: #343a40;
        color: white;
    }

    body.dark .form-control, body.dark .form-select {
        background-color: #495057;
        color: white;
        border-color: #6c757d;
    }

    body.dark .nav-tabs .nav-link.active {
        background-color: #343a40;
        color: #fff;
        border-color: #dee2e6 #dee2e6 #343a40;
    }

    body.dark .nav-tabs .nav-link {
        color: #adb5bd;
    }
</style>

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code {
    private CompanySetting? settings;
    private FeatureSettings? features;
    private bool isSaving = false;
    private bool isSuperAdmin = false;
    private string activeTab = "general";
    private int trackingIntervalSeconds = 30;
    private string? firebaseOwnerUid;

    private CompanyTenant? activeTenant;

    // Delete Company Security
    private bool isAuthorizedDeleteSuperAdmin = false;
    private string currentUserEmail = "";
    private bool showDeleteCompanyModal = false;
    private bool isDeletingCompany = false;
    private string deleteConfirmText = "";
    private string? deleteErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;
        isSuperAdmin = user.IsInRole("SuperAdmin");
        currentUserEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? user.Identity?.Name ?? "";
        isAuthorizedDeleteSuperAdmin = isSuperAdmin && (
            string.Equals(currentUserEmail.Trim(), TenantManagementService.AuthorizedSuperAdminDeleteEmail, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(currentUserEmail.Trim(), FirebaseAuthSecurityConstants.CanonicalSuperAdminEmail, StringComparison.OrdinalIgnoreCase));

        try
        {
            activeTenant = await TenantContext.GetActiveTenantAsync();
            var targetSettingId = activeTenant?.CompanySettingId > 0 ? activeTenant.CompanySettingId : 1;
            var targetFeatureId = activeTenant?.FeatureSettingsId > 0 ? activeTenant.FeatureSettingsId : 1;

            await using var dbContext = await DbFactory.CreateDbContextAsync();
            settings = await dbContext.CompanySettings.AsNoTracking().FirstOrDefaultAsync(s => s.SettingID == targetSettingId);
            features = await dbContext.FeatureSettings.AsNoTracking().FirstOrDefaultAsync(f => f.Id == targetFeatureId) ?? new FeatureSettings();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading settings.");
            toastService.ShowError($"Error loading settings: {ex.Message}");
        }
        if (settings == null) settings = new CompanySetting();

        firebaseOwnerUid = activeTenant?.TenantId ?? FirebaseRealtime.ResolveOwnerUid(
            authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "web-admin",
            isSuperAdmin ? "SuperAdmin" : "Admin");
        await LoadTrackingIntervalAsync();
    }

    private void OpenDeleteCompanyModal()
    {
        deleteConfirmText = "";
        deleteErrorMessage = null;
        showDeleteCompanyModal = true;
    }

    private void CloseDeleteCompanyModal()
    {
        if (isDeletingCompany) return;
        showDeleteCompanyModal = false;
    }

    private async Task ExecuteDeleteCompanyAsync()
    {
        if (deleteConfirmText?.Trim().ToUpperInvariant() != "DELETE")
        {
            deleteErrorMessage = "Please type DELETE in capital letters to confirm.";
            return;
        }

        isDeletingCompany = true;
        deleteErrorMessage = null;
        try
        {
            var targetTenantId = activeTenant?.TenantId ?? TenantContextService.DefaultTenantId;
            var result = await TenantManager.DeleteEntireCompanyAsync(targetTenantId, currentUserEmail);
            if (!result.Success)
            {
                deleteErrorMessage = result.ErrorMessage ?? "Failed to delete company.";
                return;
            }

            try
            {
                await JSRuntime.InvokeVoidAsync("attendanceCache.clear");
                await JSRuntime.InvokeVoidAsync("employeeCache.clear");
            }
            catch { }

            await TenantContext.ClearActiveTenantAsync();

            toastService.ShowSuccess("✨ Company has been permanently deleted from Cloud and Local Database.");
            showDeleteCompanyModal = false;
            Navigation.NavigateTo("/company-setup", forceLoad: true);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error deleting company");
            deleteErrorMessage = $"Deletion failed: {ex.Message}";
        }
        finally
        {
            isDeletingCompany = false;
        }
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;
        isSaving = true;
        try
        {
            activeTenant ??= await TenantContext.GetActiveTenantAsync();
            var targetSettingId = activeTenant?.CompanySettingId > 0 ? activeTenant.CompanySettingId : 1;

            await using var dbContext = await DbFactory.CreateDbContextAsync();
            settings.SettingID = targetSettingId;
            var existing = await dbContext.CompanySettings.AsNoTracking().FirstOrDefaultAsync(s => s.SettingID == targetSettingId);
            if (existing == null) dbContext.CompanySettings.Add(settings);
            else { dbContext.Entry(existing).State = EntityState.Detached; dbContext.CompanySettings.Update(settings); }
            await dbContext.SaveChangesAsync();

            // Re-baseline GPS sessions for instant dashboard status updates
            await GeoService.RebaselineAllActiveSessionsAsync();

            // Push the newly saved office/radius configuration immediately to
            // already-connected employee apps. This is notification-only: the
            // existing database, GPS and attendance validation flow is unchanged.
            await AttendanceRefresh.NotifyGeoSettingsChangedAsync(
                settings.OfficeLatitude,
                settings.OfficeLongitude,
                settings.GeoRadiusMeters);

            await SaveTrackingIntervalAsync();

            // Mirror company settings to Firebase under tenant's owner node
            try
            {
                if (!string.IsNullOrWhiteSpace(firebaseOwnerUid))
                {
                    var companyPayload = new Dictionary<string, object?>
                    {
                        ["companyName"] = settings.CompanyName,
                        ["addressLine1"] = settings.AddressLine1,
                        ["cityStatePincode"] = settings.CityStatePincode,
                        ["officeLatitude"] = settings.OfficeLatitude,
                        ["officeLongitude"] = settings.OfficeLongitude,
                        ["geoRadiusMeters"] = settings.GeoRadiusMeters,
                        ["workDayCutoffHour"] = settings.WorkDayCutoffHour,
                        ["lateGraceMinutes"] = settings.LateGraceMinutes,
                        ["endTimeGraceMinutes"] = settings.EndTimeGraceMinutes
                    };
                    await FirebaseRealtime.SetAsync($"owners/{firebaseOwnerUid}/company_settings/1", companyPayload, default);
                }

                if (activeTenant != null && !string.Equals(activeTenant.CompanyName, settings.CompanyName))
                {
                    var tenantRow = await dbContext.CompanyTenants.FirstOrDefaultAsync(t => t.Id == activeTenant.Id);
                    if (tenantRow != null)
                    {
                        tenantRow.CompanyName = settings.CompanyName.Trim();
                        await dbContext.SaveChangesAsync();
                        activeTenant.CompanyName = settings.CompanyName.Trim();
                    }
                }
            }
            catch (Exception fbEx)
            {
                _logger.LogWarning(fbEx, "Could not mirror company settings to Firebase for {OwnerUid}", firebaseOwnerUid);
            }

            toastService.ShowSuccess("Settings saved successfully!");
        }
        catch (Exception ex) { _logger.LogError(ex, "Error saving."); toastService.ShowError("Save failed."); }
        finally { isSaving = false; }
    }
    private async Task LoadTrackingIntervalAsync()
    {
        if (string.IsNullOrWhiteSpace(firebaseOwnerUid)) return;
        try
        {
            var data = await FirebaseRealtime.GetGlobalRecordAsync(
                $"owners/{firebaseOwnerUid}/tracking_configuration",
                CancellationToken.None);
            trackingIntervalSeconds = ReadIntervalSeconds(data);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Unable to load Firebase tracking interval; keeping {Interval}s", trackingIntervalSeconds);
        }
    }

    private async Task SaveTrackingIntervalAsync()
    {
        if (string.IsNullOrWhiteSpace(firebaseOwnerUid)) return;
        trackingIntervalSeconds = NormalizeTrackingInterval(trackingIntervalSeconds);
        var existing = await FirebaseRealtime.GetGlobalRecordAsync(
            $"owners/{firebaseOwnerUid}/tracking_configuration",
            CancellationToken.None);
        await FirebaseRealtime.SetGlobalRecordAsync(
            $"owners/{firebaseOwnerUid}/tracking_configuration",
            new Dictionary<string, object?>
            {
                ["mode"] = ReadString(existing, "mode") ?? "24/7",
                ["customStart"] = ReadString(existing, "customStart") ?? string.Empty,
                ["customEnd"] = ReadString(existing, "customEnd") ?? string.Empty,
                ["intervalSeconds"] = trackingIntervalSeconds,
                ["enabled"] = ReadBool(existing, "enabled") ?? true,
                ["updatedAt"] = DateTime.UtcNow.ToString("O"),
                ["updatedBy"] = firebaseOwnerUid
            });
    }

    private async Task OnTrackingIntervalChanged(int seconds)
    {
        trackingIntervalSeconds = NormalizeTrackingInterval(seconds);
        await InvokeAsync(StateHasChanged);
    }

    private static int NormalizeTrackingInterval(int value) =>
        value switch { 30 or 60 or 120 or 300 => value, _ => 30 };

    private static int ReadIntervalSeconds(System.Text.Json.JsonElement? data)
    {
        if (!data.HasValue || data.Value.ValueKind != System.Text.Json.JsonValueKind.Object) return 30;
        if (data.Value.TryGetProperty("intervalSeconds", out var p))
        {
            if (p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt32(out var n)) return NormalizeTrackingInterval(n);
            if (p.ValueKind == System.Text.Json.JsonValueKind.String && int.TryParse(p.GetString(), out n)) return NormalizeTrackingInterval(n);
        }
        return 30;
    }

    private static string? ReadString(System.Text.Json.JsonElement? data, string name) =>
        data.HasValue && data.Value.ValueKind == System.Text.Json.JsonValueKind.Object &&
        data.Value.TryGetProperty(name, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.String
            ? p.GetString() : null;

    private static bool? ReadBool(System.Text.Json.JsonElement? data, string name) =>
        data.HasValue && data.Value.ValueKind == System.Text.Json.JsonValueKind.Object &&
        data.Value.TryGetProperty(name, out var p)
            ? p.ValueKind == System.Text.Json.JsonValueKind.True ? true : p.ValueKind == System.Text.Json.JsonValueKind.False ? false : null
            : null;

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            settings = await dbContext.CompanySettings
                .AsNoTracking()
                .FirstOrDefaultAsync(s => s.SettingID == 1);
            features = await dbContext.FeatureSettings
                .AsNoTracking()
                .FirstOrDefaultAsync(f => f.Id == 1)
                ?? new FeatureSettings();

            if (settings == null)
                settings = new CompanySetting();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(ex, "Realtime company settings refresh failed.");
        }
    }

}