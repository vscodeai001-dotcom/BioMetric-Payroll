@page "/admin/offline-tracking-details"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Firebase
@using global::Payroll.Web.Services
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject FirebaseRealtimeService FirebaseRealtime
@inject AttendanceRefreshService AttendanceRefresh
@inject ILogger<OfflineTrackingDetails> Logger
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Offline GPS Tracking Details & Audit</PageTitle>

<div class="container-fluid py-3 enterprise-offline-page">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <div class="small text-muted text-uppercase fw-bold">GPS Offline Audit &amp; Reconciliation</div>
            <h3 class="fw-bold mb-1"><i class="bi bi-cloud-slash me-2 text-danger"></i>Offline GPS Tracking Details</h3>
            <div class="text-muted">Enterprise view of offline capture, synchronization, geofence analysis, dwell stops, and live attendance impact.</div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/admin/offline-tracking" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to Offline Hub
            </a>
            <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@loading">
                <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i>@(loading ? "Loading..." : "Refresh")
            </button>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm">
        <i class="bi bi-shield-check me-2"></i>
        <strong>Audit model:</strong> device capture time is kept separately from server synchronization time.
        Offline GPS breadcrumbs are reconciled into the live ledger with original device timestamps intact.
    </div>

    <!-- Pure Offline Summary Metrics (No Live Session Health) -->
    <div class="row g-3 mb-4">
        @Metric("Tracked Employees", summary.Employees.ToString(), "bi-people", "text-primary")
        @Metric("Offline Intervals", offlinePeriods.Count.ToString(), "bi-clock-history", "text-warning")
        @Metric("Offline Breadcrumbs", summary.OfflinePoints.ToString(), "bi-cloud-slash", "text-info")
        @Metric("Auto OUT Punches", summary.AutoPunches.ToString(), "bi-lightning-charge", "text-danger")
        @Metric("Zero-Impact Safe", summary.ZeroImpactCount.ToString(), "bi-shield-check", "text-success")
        @Metric("Total Distance", FormatDistance(summary.DistanceMeters), "bi-signpost-2", "text-secondary")
    </div>

    <!-- Tracking Filters -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <strong><i class="bi bi-funnel me-2"></i>Tracking Filters</strong>
                <div class="small text-muted">Filter offline periods, breadcrumb ledger and audit events.</div>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="LoadAsync">Apply Filters</button>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-12 col-md-3">
                    <label class="form-label">Employee</label>
                    <select class="form-select" @bind="employeeFilter">
                        <option value="0">All employees</option>
                        @foreach (var e in employees)
                        {
                            <option value="@e.EmployeeID">@e.Name (#@e.EmployeeID)</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" class="form-control" @bind="fromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" class="form-control" @bind="toDate" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">Capture Source</label>
                    <select class="form-select" @bind="captureFilter">
                        <option value="">All Points</option>
                        <option value="OfflineSync">Offline sync only</option>
                        <option value="Online">Online only</option>
                    </select>
                </div>
                <div class="col-12 col-md-3">
                    <label class="form-label">Session ID</label>
                    <input class="form-control" placeholder="Optional session GUID" @bind="sessionFilter" />
                </div>
            </div>
        </div>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@error</div>
    }

    @if (loading)
    {
        <div class="card border-0 shadow-sm p-5 text-center">
            <span class="spinner-border text-primary me-2"></span>Loading enterprise tracking data from cloud &amp; local records...
        </div>
    }
    else
    {
        <!-- Centerpiece: Offline Disconnection Intervals Table -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong><i class="bi bi-clock-history me-2 text-warning"></i>Offline Disconnection Intervals (Missing Window Reconciliation)</strong>
                    <div class="small text-muted">Time periods when employee mobile was offline (airplane mode, network disconnected) and re-integrated upon reconnection.</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPeriodFilter">
                            <i class="bi bi-x-circle me-1"></i>Show All Points
                        </button>
                    }
                    <span class="badge bg-warning text-dark fs-6 px-3 py-2">@offlinePeriods.Count offline periods</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Employee</th>
                                <th>Offline Started (IST)</th>
                                <th>Reconnected (IST)</th>
                                <th>Duration &amp; Mode</th>
                                <th>Disconnect Reason</th>
                                <th>Changes Made to Live Attendance</th>
                                <th>Breadcrumbs</th>
                                <th>Geofence</th>
                                <th>Reconciliation Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var period in offlinePeriods)
                        {
                            var isSelected = period.Id == selectedPeriodId;
                            <tr class="@(isSelected ? "table-warning fw-semibold" : "")">
                                <td><strong>@period.EmployeeName</strong><div class="small text-muted">#@period.EmployeeId</div></td>
                                <td class="nowrap"><i class="bi bi-wifi-off text-danger me-1"></i>@FormatIst(period.OfflineStartedUtc)</td>
                                <td class="nowrap"><i class="bi bi-wifi text-success me-1"></i>@FormatIst(period.OfflineEndedUtc)</td>
                                <td>
                                    <div><span class="badge bg-dark-subtle text-dark">@FormatDuration(period.Duration)</span></div>
                                    <div class="mt-1">
                                        @if (period.IsOffShift)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
                                                <i class="bi bi-moon-stars me-1"></i>@period.ShiftTag
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                <i class="bi bi-briefcase me-1"></i>@period.ShiftTag
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-info-circle me-1"></i>@period.DisconnectReason</span></td>
                                <td>
                                    @if (period.Punches.Any())
                                    {
                                        <div class="d-flex flex-column gap-1 mb-1">
                                        @foreach (var p in period.Punches)
                                        {
                                            var isOut = IsOutType(p.Type);
                                            <div class="p-1 px-2 rounded @(isOut ? "bg-danger-subtle border border-danger-subtle text-danger" : "bg-success-subtle border border-success-subtle text-success") small">
                                                <strong>@(isOut ? "🔴 OUT Punch Added" : "🟢 IN Punch Added")</strong> at @FormatIst(p.PunchTimeUtc, "hh:mm tt")
                                                <div class="small text-muted">@p.ChangeDetail</div>
                                            </div>
                                        }
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(period.LiveImpactSummary))
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-shield-check text-secondary me-1"></i>
                                            @period.LiveImpactSummary
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>
                                        <span class="badge bg-info-subtle text-info-emphasis">@period.PointCount points</span> · @FormatDistance(period.TotalDistanceMeters)
                                    </div>
                                    @if (period.Stays.Any())
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-secondary-subtle text-secondary"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@period.Stays.Count stops</span>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">@period.WithinRadiusCount IN</span>
                                    @if (period.PointCount - period.WithinRadiusCount > 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger ms-1">@(period.PointCount - period.WithinRadiusCount) OUT</span>
                                    }
                                </td>
                                <td>
                                    @if (period.IsFullySynced)
                                    {
                                        <div>
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Reconciled to Live</span>
                                            <div class="small text-primary mt-1">
                                                Pushed to cloud: @(period.Punches.Any() ? $"{period.Punches.Count} punches & " : "")@period.PointCount points merged
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Sync Pending</span>
                                            <div class="small text-warning-emphasis mt-1">Buffered on device</div>
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-primary")" @onclick="() => TogglePeriodFilter(period.Id)">
                                        <i class="bi @(isSelected ? "bi-check2-circle" : "bi-eye") me-1"></i>@(isSelected ? "Active Filter" : "Inspect Route")
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(selectedPeriodId))
                {
                    var activePeriod = offlinePeriods.FirstOrDefault(x => x.Id == selectedPeriodId);
                    if (activePeriod != null)
                    {
                        <div class="border-top p-4 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold mb-0 text-primary">
                                        <i class="bi bi-clock-history me-1"></i>Offline Disconnection Breakdown for @activePeriod.EmployeeName
                                    </h6>
                                    <small class="text-muted">
                                        Disconnected: @FormatIst(activePeriod.OfflineStartedUtc, "dd MMM hh:mm:ss tt") → Reconnected: @FormatIst(activePeriod.OfflineEndedUtc, "hh:mm:ss tt") IST (@FormatAge(activePeriod.Duration)) • Mode: @activePeriod.DisconnectReason
                                    </small>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearPeriodFilter">
                                    <i class="bi bi-x-lg me-1"></i>Close
                                </button>
                            </div>

                            <!-- Prominent Live Data Impact Status Box -->
                            @{
                                var hasAutoOut = activePeriod.Punches.Any(p => IsOutType(p.Type) && p.ChangeDetail.Contains("radius", StringComparison.OrdinalIgnoreCase)) ||
                                                 activePeriod.LiveImpactSummary.Contains("Auto OUT", StringComparison.OrdinalIgnoreCase);
                                var hasPunches = activePeriod.Punches.Any();
                                var outOfRadiusCount = Math.Max(0, activePeriod.PointCount - activePeriod.WithinRadiusCount);
                                string impactBadgeText;
                                string impactAlertClass;
                                string impactBadgeClass;

                                if (hasAutoOut)
                                {
                                    impactBadgeText = "⚡ Auto OUT Punch Triggered";
                                    impactAlertClass = "alert-danger border-danger-subtle";
                                    impactBadgeClass = "bg-danger";
                                }
                                else if (hasPunches)
                                {
                                    impactBadgeText = "🟢 Reconciled Attendance Punch";
                                    impactAlertClass = "alert-success border-success-subtle";
                                    impactBadgeClass = "bg-success";
                                }
                                else if (activePeriod.IsOffShift)
                                {
                                    impactBadgeText = "🌙 Off-Duty Window (No Impact)";
                                    impactAlertClass = "alert-secondary border-secondary-subtle";
                                    impactBadgeClass = "bg-secondary";
                                }
                                else if (activePeriod.PriorState == "IN" && outOfRadiusCount == 0)
                                {
                                    impactBadgeText = "🛡️ No Live Attendance Impact";
                                    impactAlertClass = "alert-success border-success-subtle";
                                    impactBadgeClass = "bg-success";
                                }
                                else if (activePeriod.PriorState == "OUT")
                                {
                                    impactBadgeText = "🛡️ No Attendance State Change";
                                    impactAlertClass = "alert-secondary border-secondary-subtle";
                                    impactBadgeClass = "bg-secondary";
                                }
                                else
                                {
                                    impactBadgeText = "🛡️ No Live Attendance Impact";
                                    impactAlertClass = "alert-info border-info-subtle";
                                    impactBadgeClass = "bg-primary";
                                }
                            }

                            <div class="alert @impactAlertClass border shadow-sm mb-3">
                                <div class="d-flex align-items-start gap-2">
                                    <span class="badge @impactBadgeClass px-2 py-1 fs-6">@impactBadgeText</span>
                                    <div class="flex-grow-1">
                                        <div class="fw-semibold">@activePeriod.LiveImpactSummary</div>
                                        @if (activePeriod.Punches.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                @foreach (var p in activePeriod.Punches)
                                                {
                                                    var isOut = IsOutType(p.Type);
                                                    <span class="badge @(isOut ? "bg-danger" : "bg-success") p-2 text-start">
                                                        <i class="bi @(isOut ? "bi-box-arrow-right" : "bi-box-arrow-in-right") me-1"></i>
                                                        @(isOut ? "🔴 OUT Punch" : "🟢 IN Punch"): @FormatIst(p.PunchTimeUtc, "hh:mm tt")
                                                        <small class="d-block fw-normal opacity-75">@p.ChangeDetail • Applied to live shift logs</small>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- 5-Step Linear Audit Timeline Feed -->
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-2">
                                    <strong class="small text-uppercase text-primary">
                                        <i class="bi bi-diagram-3-fill me-1"></i>Timeline Audit of Disconnection Window
                                    </strong>
                                </div>
                                <div class="card-body p-3">
                                    <div class="timeline-audit-feed">
                                        <!-- Step 1: Disconnection Event -->
                                        <div class="timeline-step">
                                            <div class="timeline-step-icon bg-warning text-dark">📴</div>
                                            <div class="timeline-step-content">
                                                <div class="fw-bold small">Step 1 · Disconnection Event</div>
                                                <div class="text-muted small">
                                                    Disconnected at <strong>@FormatIst(activePeriod.OfflineStartedUtc, "hh:mm tt") IST</strong> ·
                                                    Cause: <span class="badge bg-secondary-subtle text-secondary">@activePeriod.DisconnectReason</span> ·
                                                    Initial location: @(activePeriod.WithinRadiusCount > 0 ? "Inside Office Radius" : "Outside Office")
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Step 2: Journey Stops & Stay Points -->
                                        <div class="timeline-step">
                                            <div class="timeline-step-icon bg-info text-white">🗺️</div>
                                            <div class="timeline-step-content">
                                                <div class="fw-bold small">Step 2 · Journey Stops &amp; Stay Points</div>
                                                <div class="small text-muted mb-1">
                                                    Traversed <strong>@FormatDistance(activePeriod.TotalDistanceMeters)</strong> across <strong>@activePeriod.PointCount points</strong> captured locally on mobile device.
                                                </div>
                                                @if (activePeriod.Stays.Any())
                                                {
                                                    <div class="row g-2 mt-1">
                                                        @foreach (var stay in activePeriod.Stays)
                                                        {
                                                            <div class="col-12 col-md-6 col-xl-4">
                                                                <div class="p-2 rounded border bg-light small">
                                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                                        <span class="badge @(stay.IsWithinAllowedRadius ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                                                                            <i class="bi @(stay.IsWithinAllowedRadius ? "bi-building-check" : "bi-geo-alt") me-1"></i>
                                                                            @(stay.IsWithinAllowedRadius ? "Inside Geofence" : "Outside Geofence")
                                                                        </span>
                                                                        <strong class="text-primary">@FormatAge(stay.Duration) dwell</strong>
                                                                    </div>
                                                                    <div class="fw-semibold">@FormatIst(stay.StartUtc, "hh:mm tt") → @FormatIst(stay.EndUtc, "hh:mm tt")</div>
                                                                    <div class="text-muted mt-1">@stay.LocationDescription</div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else if (activePeriod.TotalDistanceMeters < 30)
                                                {
                                                    <div class="small text-secondary"><i class="bi bi-geo-alt me-1"></i>Stationary at current location throughout entire disconnect window (minimal displacement).</div>
                                                }
                                                else
                                                {
                                                    <div class="small text-secondary"><i class="bi bi-arrow-repeat me-1"></i>Continuous transit across route with no extended stationary stops.</div>
                                                }
                                            </div>
                                        </div>

                                        <!-- Step 3: Geofence Perimeter Assessment -->
                                        <div class="timeline-step">
                                            <div class="timeline-step-icon bg-primary text-white">🏢</div>
                                            <div class="timeline-step-content">
                                                <div class="fw-bold small">Step 3 · Geofence Perimeter Assessment</div>
                                                <div class="small">
                                                    @if (outOfRadiusCount == 0)
                                                    {
                                                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i><strong>100% Inside Office Radius</strong> — Remained safely within permitted office boundary (@activePeriod.PointCount points inside).</span>
                                                    }
                                                    else if (activePeriod.WithinRadiusCount == 0)
                                                    {
                                                        <span class="text-danger"><i class="bi bi-exclamation-octagon-fill me-1"></i><strong>Outside Office Perimeter</strong> — Remained outside office boundary for entire duration (@outOfRadiusCount points outside).</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning-emphasis"><i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Perimeter Transition</strong> — @activePeriod.WithinRadiusCount points inside boundary, @outOfRadiusCount points outside. Crossed office geofence threshold during offline period.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Step 4: Reconnection & Cloud Sync -->
                                        <div class="timeline-step">
                                            <div class="timeline-step-icon bg-success text-white">📶</div>
                                            <div class="timeline-step-content">
                                                <div class="fw-bold small">Step 4 · Reconnection &amp; Cloud Sync</div>
                                                <div class="small text-muted">
                                                    Reconnected at <strong>@FormatIst(activePeriod.OfflineEndedUtc, "hh:mm tt") IST</strong> ·
                                                    @if (activePeriod.IsFullySynced)
                                                    {
                                                        <span class="text-success fw-semibold"><i class="bi bi-cloud-check-fill me-1"></i>All @activePeriod.PointCount breadcrumb points &amp; attendance events successfully merged into live database.</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-warning fw-semibold"><i class="bi bi-hourglass-split me-1"></i>Buffered in mobile local queue — Pending cloud sync.</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (!offlinePeriods.Any())
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                        No offline disconnect periods recorded in the selected date range. All tracking was captured online in real-time.
                    </div>
                }
            </div>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong><i class="bi bi-map me-2"></i>Offline Route / Point Ledger</strong>
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <span class="badge bg-warning text-dark ms-2">Filtered to selected offline period</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(selectedPeriodId))
                    {
                        <button class="btn btn-sm btn-link text-decoration-none p-0" @onclick="ClearPeriodFilter">Clear Filter</button>
                    }
                    <span class="badge bg-primary-subtle text-primary">@DisplayedPoints.Count points</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive offline-ledger">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Capture IST</th><th>Employee</th><th>Session</th><th>Source</th>
                                <th>Coordinates</th><th>Accuracy</th><th>Office Distance</th>
                                <th>Radius</th><th>State</th><th>Speed</th><th>Sync IST</th><th>Batch</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var p in DisplayedPoints)
                        {
                            <tr>
                                <td class="nowrap">@FormatIst(p.CapturedAtUtc)</td>
                                <td><strong>@p.EmployeeName</strong><div class="small text-muted">#@p.EmployeeId</div></td>
                                <td><code>@ShortGuid(p.SessionId)</code></td>
                                <td><span class="badge @(p.CaptureSource == "OfflineSync" ? "bg-warning text-dark" : "bg-secondary")">@p.CaptureSource</span></td>
                                <td><code>@p.Latitude.ToString("F6"), @p.Longitude.ToString("F6")</code></td>
                                <td>@p.AccuracyMeters.ToString("F1") m</td>
                                <td>@p.DistanceMeters.ToString("F1") m</td>
                                <td>@p.RadiusMeters m</td>
                                <td><span class="badge @(p.WithinRadius ? "bg-success" : "bg-danger")">@(p.WithinRadius ? "IN" : "OUT")</span><div class="small text-muted">@p.Movement</div></td>
                                <td>@p.SpeedKmh.ToString("F1") km/h</td>
                                <td class="nowrap">@(p.SyncedAtUtc.HasValue ? FormatIst(p.SyncedAtUtc) : "Pending")</td>
                                <td><code>@(p.SyncBatchId.HasValue ? ShortGuid(p.SyncBatchId.Value) : "-")</code></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (!DisplayedPoints.Any())
                {
                    <div class="p-4 text-center text-muted">No GPS points match the selected filters.</div>
                }
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-xl-7">
                <div class="card shadow-sm border-0">
                    <div class="card-header"><strong><i class="bi bi-clock-history me-2"></i>GPS Session Ledger</strong></div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead><tr><th>Employee</th><th>Session</th><th>Started IST</th><th>Last GPS IST</th><th>Ended IST</th><th>Reason</th><th>Points</th><th>Distance</th></tr></thead>
                                <tbody>
                                @foreach (var s in sessions)
                                {
                                    <tr>
                                        <td><strong>@s.EmployeeName</strong><div class="small text-muted">#@s.EmployeeId</div></td>
                                        <td><code>@ShortGuid(s.SessionId)</code></td>
                                        <td class="nowrap">@FormatIst(s.StartedUtc)</td>
                                        <td class="nowrap">@FormatIst(s.LastUpdateUtc)</td>
                                        <td class="nowrap">@(s.EndedUtc.HasValue ? FormatIst(s.EndedUtc) : "ACTIVE")</td>
                                        <td>@(s.EndReason ?? "Active")</td>
                                        <td>@s.TotalPoints</td>
                                        <td>@FormatDistance(s.TotalDistanceMeters)</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-2"><strong><i class="bi bi-shield-check me-2 text-primary"></i>Connectivity &amp; Recovery Audit Feed</strong></div>
                    <div class="card-body p-0">
                        <div class="event-list">
                            @foreach (var a in auditEvents)
                            {
                                var ev = FormatAuditEvent(a.EventType, a.Details);
                                <div class="event-row">
                                    <div class="event-time">@FormatIst(a.Timestamp)</div>
                                    <div class="event-main">
                                        <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                            <span class="fs-6">@ev.Icon</span>
                                            <strong class="text-dark small">@ev.Title</strong>
                                            <span class="badge @ev.BadgeClass small ms-auto">@ev.Badge</span>
                                        </div>
                                        <div class="small text-muted">@ev.CleanDetails</div>
                                    </div>
                                </div>
                            }
                        </div>
                        @if (!auditEvents.Any())
                        {
                            <div class="p-4 text-center text-muted">No connectivity recovery or audit events found.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<AttendanceRefreshListener OnAttendanceChanged="HandleAttendanceChanged" OnLocationChanged="HandleAttendanceChanged" />

