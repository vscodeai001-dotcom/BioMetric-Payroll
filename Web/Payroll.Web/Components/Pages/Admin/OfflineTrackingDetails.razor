@code {
    private bool loading;
    private string? error;
    private int employeeFilter;
    private string captureFilter = "";
    private string sessionFilter = "";
    private DateTime fromDate = DateTime.Today.AddDays(-1);
    private DateTime toDate = DateTime.Today;

    private List<EmployeeOption> employees = new();
    private List<PointRow> points = new();
    private List<OfflinePeriodRow> offlinePeriods = new();
    private List<SessionRow> sessions = new();
    private List<AuditRow> auditEvents = new();
    private Summary summary = new();
    private string? selectedPeriodId;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    private void TogglePeriodFilter(string periodId)
    {
        selectedPeriodId = selectedPeriodId == periodId ? null : periodId;
    }

    private void ClearPeriodFilter()
    {
        selectedPeriodId = null;
    }

    private List<PointRow> DisplayedPoints
    {
        get
        {
            if (string.IsNullOrEmpty(selectedPeriodId))
                return points;

            var period = offlinePeriods.FirstOrDefault(x => x.Id == selectedPeriodId);
            if (period == null)
                return points;

            return points.Where(p =>
                p.EmployeeId == period.EmployeeId &&
                p.CapturedAtUtc >= period.OfflineStartedUtc &&
                p.CapturedAtUtc <= period.OfflineEndedUtc
            ).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task HandleAttendanceChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        try
        {
            while (await timer!.WaitForNextTickAsync(token))
            {
                if (loading) continue;
                await InvokeAsync(async () =>
                {
                    await LoadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Offline tracking background refresh loop stopped.");
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        error = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var allEmployeesDomain = await db.Employees.AsNoTracking()
                .Where(x => !x.IsDeleted)
                .OrderBy(x => x.Name)
                .ToListAsync();

            employees = allEmployeesDomain
                .Select(x => new EmployeeOption { EmployeeID = x.EmployeeID, Name = x.Name })
                .ToList();

            var employeeMap = allEmployeesDomain.ToDictionary(x => x.EmployeeID);
            var employeeNames = employees.ToDictionary(x => x.EmployeeID, x => x.Name);

            var fromUtc = IndiaToUtc(fromDate.Date);
            var toUtc = IndiaToUtc(toDate.Date.AddDays(1));

            var companySetting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            double officeLat = companySetting?.OfficeLatitude ?? 0.0;
            double officeLon = companySetting?.OfficeLongitude ?? 0.0;
            int radiusMeters = companySetting?.GeoRadiusMeters ?? 100;

            // 1. Fetch points from SQLite
            var historyQuery = db.EmployeeLocationHistory.AsNoTracking()
                .Where(x => x.CapturedAtUtc >= fromUtc && x.CapturedAtUtc < toUtc);

            if (employeeFilter > 0)
                historyQuery = historyQuery.Where(x => x.EmployeeId == employeeFilter);

            if (!string.IsNullOrWhiteSpace(captureFilter))
                historyQuery = historyQuery.Where(x => x.CaptureSource == captureFilter);

            if (Guid.TryParse(sessionFilter, out var sessionId))
                historyQuery = historyQuery.Where(x => x.SessionId == sessionId);

            var dbRawPoints = await historyQuery
                .OrderBy(p => p.CapturedAtUtc)
                .Select(p => new PointRow
                {
                    EmployeeId = p.EmployeeId,
                    SessionId = p.SessionId,
                    Latitude = p.Latitude,
                    Longitude = p.Longitude,
                    AccuracyMeters = p.AccuracyMeters,
                    DistanceMeters = p.DistanceFromOfficeMeters,
                    RadiusMeters = p.AllowedRadiusMeters,
                    WithinRadius = p.IsWithinAllowedRadius,
                    CapturedAtUtc = p.CapturedAtUtc,
                    CaptureSource = p.CaptureSource ?? "OfflineSync",
                    SyncBatchId = p.SyncBatchId,
                    SyncedAtUtc = p.SyncedAtUtc,
                    RecordedAtUtc = p.RecordedAtUtc
                }).Take(2000).ToListAsync();

            // 2. Fetch points & events from Firebase Realtime Database
            var firebasePoints = new List<PointRow>();
            var resolvedOwnerUid = FirebaseRealtime.ResolveOwnerUid();
            if (string.IsNullOrWhiteSpace(resolvedOwnerUid))
            {
                resolvedOwnerUid = FirebaseSsotSchema.DefaultOwnerUid;
            }

            try
            {
                var historyJson = await FirebaseRealtime.GetGlobalRecordAsync($"owners/{resolvedOwnerUid}/tracking/history");
                if (historyJson == null || historyJson.Value.ValueKind != JsonValueKind.Object)
                {
                    historyJson = await FirebaseRealtime.GetGlobalRecordAsync("tracking/history");
                }

                if (historyJson.HasValue && historyJson.Value.ValueKind == JsonValueKind.Object)
                {
                    foreach (var empProp in historyJson.Value.EnumerateObject())
                    {
                        if (empProp.Value.ValueKind == JsonValueKind.Object)
                        {
                            int.TryParse(empProp.Name, out var empIdKey);
                            if (employeeFilter > 0 && empIdKey != employeeFilter) continue;

                            foreach (var ptProp in empProp.Value.EnumerateObject())
                            {
                                if (ptProp.Value.ValueKind == JsonValueKind.Object)
                                {
                                    var pt = ParseFirebasePoint(ptProp.Value, empIdKey, officeLat, officeLon, radiusMeters);
                                    if (pt != null && pt.CapturedAtUtc >= fromUtc && pt.CapturedAtUtc < toUtc)
                                    {
                                        if (string.IsNullOrWhiteSpace(captureFilter) || pt.CaptureSource.Equals(captureFilter, StringComparison.OrdinalIgnoreCase))
                                        {
                                            firebasePoints.Add(pt);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Firebase tracking history read error");
            }

            // Combine SQLite and Firebase points
            var allCombinedPoints = new List<PointRow>();
            allCombinedPoints.AddRange(dbRawPoints);
            allCombinedPoints.AddRange(firebasePoints);

            var dedupedPoints = allCombinedPoints
                .GroupBy(p => $"{p.EmployeeId}_{Math.Round(p.Latitude, 5)}_{Math.Round(p.Longitude, 5)}_{p.CapturedAtUtc:yyyyMMddHHmmss}")
                .Select(g => g.First())
                .OrderBy(p => p.CapturedAtUtc)
                .ToList();

            foreach (var row in dedupedPoints)
            {
                row.EmployeeName = employeeNames.TryGetValue(row.EmployeeId, out var n) ? n : $"Employee #{row.EmployeeId}";
            }

            points = BuildPointRows(dedupedPoints);

            // Sessions
            var sessionQuery = db.EmployeeGpsSessions.AsNoTracking().AsQueryable();
            if (employeeFilter > 0) sessionQuery = sessionQuery.Where(x => x.EmployeeId == employeeFilter);
            if (Guid.TryParse(sessionFilter, out var sessionId2)) sessionQuery = sessionQuery.Where(x => x.SessionId == sessionId2);

            sessions = await sessionQuery
                .Where(s => s.StartedAtUtc < toUtc && (s.EndedAtUtc == null || s.EndedAtUtc >= fromUtc))
                .OrderByDescending(s => s.StartedAtUtc)
                .Select(s => new SessionRow
                {
                    EmployeeId = s.EmployeeId,
                    SessionId = s.SessionId,
                    StartedUtc = s.StartedAtUtc,
                    LastUpdateUtc = s.LastUpdateAtUtc,
                    EndedUtc = s.EndedAtUtc,
                    EndReason = s.EndReason,
                    TotalPoints = s.TotalPoints,
                    TotalDistanceMeters = s.TotalDistanceMeters
                }).Take(500).ToListAsync();

            foreach (var row in sessions)
            {
                row.EmployeeName = employeeNames.TryGetValue(row.EmployeeId, out var n) ? n : $"Employee #{row.EmployeeId}";
            }

            // Audit Logs
            var auditQuery = db.AuditLogs.AsNoTracking()
                .Where(x => x.Timestamp >= fromUtc && x.Timestamp < toUtc)
                .Where(x =>
                    x.ActionType.Contains("GPS") ||
                    x.EntityType.Contains("Gps") ||
                    x.EntityType.Contains("Location") ||
                    x.ActionType.Contains("OFFLINE"));

            if (employeeFilter > 0)
            {
                var empStr = employeeFilter.ToString();
                auditQuery = auditQuery.Where(x => x.EntityID == empStr);
            }

            auditEvents = await auditQuery
                .OrderByDescending(x => x.Timestamp)
                .Take(300)
                .Select(x => new AuditRow
                {
                    Timestamp = x.Timestamp,
                    UserEmail = x.UserEmail,
                    EntityID = x.EntityID,
                    EventType = x.ActionType + " / " + x.EntityType,
                    Details = x.Details ?? ""
                }).ToListAsync();

            var periodPunches = await db.AttendanceLogs.AsNoTracking()
                .Where(p => p.PunchTime >= fromUtc.AddHours(-6) && p.PunchTime <= toUtc.AddHours(6))
                .ToListAsync();

            offlinePeriods = BuildOfflinePeriods(points, auditEvents, periodPunches, employeeMap, officeLat, officeLon, radiusMeters);

            summary = new Summary
            {
                Employees = points.Select(x => x.EmployeeId).Distinct().Count(),
                OfflinePoints = points.Count(x => x.CaptureSource.Contains("offline", StringComparison.OrdinalIgnoreCase)),
                AutoPunches = offlinePeriods.Sum(p => p.Punches.Count(pu => IsOutType(pu.Type))),
                ZeroImpactCount = offlinePeriods.Count(p => !p.Punches.Any() && !p.IsOffShift && (p.PointCount - p.WithinRadiusCount == 0)),
                DistanceMeters = offlinePeriods.Sum(x => x.TotalDistanceMeters),
                LastCaptureUtc = points.Any() ? points.Max(x => x.CapturedAtUtc) : null
            };
        }
        catch (Exception ex)
        {
            error = "Unable to load offline tracking details: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private static PointRow? ParseFirebasePoint(JsonElement el, int fallbackEmpId, double officeLat, double officeLon, int radiusMeters)
    {
        try
        {
            int empId = fallbackEmpId;
            if (el.TryGetProperty("EmployeeId", out var ep))
            {
                if (ep.ValueKind == JsonValueKind.Number) empId = ep.GetInt32();
                else if (int.TryParse(ep.GetString(), out var parsedId)) empId = parsedId;
            }

            double lat = 0, lon = 0;
            if (el.TryGetProperty("Latitude", out var latP) && latP.ValueKind == JsonValueKind.Number) lat = latP.GetDouble();
            if (el.TryGetProperty("Longitude", out var lonP) && lonP.ValueKind == JsonValueKind.Number) lon = lonP.GetDouble();

            if (Math.Abs(lat) < 0.0001 && Math.Abs(lon) < 0.0001) return null;

            DateTime capturedAt = DateTime.UtcNow;
            if (el.TryGetProperty("Timestamp", out var tsP))
            {
                if (tsP.ValueKind == JsonValueKind.String && DateTime.TryParse(tsP.GetString(), out var dt))
                    capturedAt = dt.ToUniversalTime();
                else if (tsP.ValueKind == JsonValueKind.Number && tsP.TryGetInt64(out var epochMs))
                    capturedAt = DateTimeOffset.FromUnixTimeMilliseconds(epochMs).UtcDateTime;
            }

            DateTime? syncedAt = capturedAt;
            if (el.TryGetProperty("SyncedAt", out var syP) && syP.ValueKind == JsonValueKind.String && DateTime.TryParse(syP.GetString(), out var sdt))
            {
                syncedAt = sdt.ToUniversalTime();
            }

            double speedMps = 0;
            if (el.TryGetProperty("SpeedMps", out var spP) && spP.ValueKind == JsonValueKind.Number) speedMps = spP.GetDouble();

            string movState = "Stopped";
            if (el.TryGetProperty("MovementState", out var mvP) && mvP.ValueKind == JsonValueKind.String) movState = mvP.GetString() ?? "Stopped";

            string source = "OfflineSync";
            if (el.TryGetProperty("CaptureSource", out var csP) && csP.ValueKind == JsonValueKind.String) source = csP.GetString() ?? "OfflineSync";
            else if (el.TryGetProperty("Source", out var sP) && sP.ValueKind == JsonValueKind.String) source = sP.GetString() ?? "OfflineSync";

            double distToOffice = 0;
            bool isWithin = true;
            if (officeLat != 0 && officeLon != 0)
            {
                distToOffice = CalculateDistance(lat, lon, officeLat, officeLon);
                isWithin = radiusMeters > 0 ? distToOffice <= radiusMeters : true;
            }

            Guid sessGuid = Guid.Empty;
            if (el.TryGetProperty("SessionId", out var sGuidP) && Guid.TryParse(sGuidP.GetString(), out var sg))
            {
                sessGuid = sg;
            }

            return new PointRow
            {
                EmployeeId = empId,
                SessionId = sessGuid,
                Latitude = lat,
                Longitude = lon,
                AccuracyMeters = 5,
                DistanceMeters = distToOffice,
                RadiusMeters = radiusMeters,
                WithinRadius = isWithin,
                CapturedAtUtc = capturedAt,
                CaptureSource = source,
                SyncedAtUtc = syncedAt,
                RecordedAtUtc = capturedAt,
                SpeedKmh = speedMps * 3.6,
                Movement = movState
            };
        }
        catch { return null; }
    }

    private static List<OfflinePeriodRow> BuildOfflinePeriods(List<PointRow> allPoints, List<AuditRow> audits, List<AttendanceLog> punches, Dictionary<int, Employee> employeeMap, double officeLat, double officeLon, int radiusMeters)
    {
        var result = new List<OfflinePeriodRow>();
        if (!allPoints.Any()) return result;

        foreach (var empGroup in allPoints.GroupBy(p => p.EmployeeId))
        {
            var empId = empGroup.Key;
            employeeMap.TryGetValue(empId, out var empProfile);

            var sortedPoints = empGroup.OrderBy(p => p.CapturedAtUtc).ToList();
            var clusters = new List<List<PointRow>>();
            var currentPoints = new List<PointRow>();

            for (int i = 0; i < sortedPoints.Count; i++)
            {
                var pt = sortedPoints[i];
                var last = currentPoints.LastOrDefault();

                var gap = last != null ? pt.CapturedAtUtc - last.CapturedAtUtc : TimeSpan.Zero;
                var isExplicitOffline = pt.CaptureSource.Contains("offline", StringComparison.OrdinalIgnoreCase) ||
                                       pt.Movement.Contains("offline", StringComparison.OrdinalIgnoreCase);

                if (isExplicitOffline || (gap > TimeSpan.FromMinutes(15) && gap < TimeSpan.FromHours(24)))
                {
                    if (currentPoints.Any() && gap > TimeSpan.FromMinutes(30))
                    {
                        clusters.Add(currentPoints);
                        currentPoints = new List<PointRow>();
                    }
                    currentPoints.Add(pt);
                }
                else
                {
                    if (currentPoints.Any())
                    {
                        clusters.Add(currentPoints);
                        currentPoints = new List<PointRow>();
                    }
                }
            }

            if (currentPoints.Any())
            {
                clusters.Add(currentPoints);
            }

            foreach (var cluster in clusters)
            {
                if (cluster.Count == 0) continue;
                result.Add(CreateOfflinePeriodRow(cluster, audits, punches, empId, empProfile, officeLat, officeLon, radiusMeters));
            }
        }

        return result.OrderByDescending(r => r.OfflineStartedUtc).ToList();
    }

    private static OfflinePeriodRow CreateOfflinePeriodRow(List<PointRow> cluster, List<AuditRow> audits, List<AttendanceLog> punches, int empId, Employee? empProfile, double officeLat, double officeLon, int radiusMeters)
    {
        var first = cluster.First();
        var last = cluster.Last();
        var empName = first.EmployeeName;

        var relatedAudit = audits.FirstOrDefault(a =>
            a.EntityID == empId.ToString() &&
            Math.Abs((a.Timestamp - first.CapturedAtUtc).TotalMinutes) < 30);

        string reason = "Network Disconnected / Signal Loss";
        if (relatedAudit != null)
        {
            var d = relatedAudit.Details;
            if (d.Contains("airplane", StringComparison.OrdinalIgnoreCase)) reason = "Airplane Mode Activated";
            else if (d.Contains("manual", StringComparison.OrdinalIgnoreCase) || d.Contains("wifi", StringComparison.OrdinalIgnoreCase) || d.Contains("data", StringComparison.OrdinalIgnoreCase)) reason = "Mobile Data / Wi-Fi Disabled";
            else if (d.Contains("power", StringComparison.OrdinalIgnoreCase) || d.Contains("battery", StringComparison.OrdinalIgnoreCase)) reason = "Battery Saver / Restraint";
            else if (d.Contains("boundary", StringComparison.OrdinalIgnoreCase)) reason = "Geofence Perimeter Breach";
        }

        var isShiftMode = (empProfile?.TrackingMode ?? "24/7").Trim().Equals("SHIFT", StringComparison.OrdinalIgnoreCase) ||
                          (empProfile?.TrackingMode ?? "").Contains("SHIFT", StringComparison.OrdinalIgnoreCase);

        bool isOffShift = false;
        string shiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking";

        if (isShiftMode && empProfile?.ShiftStartTime.HasValue == true && empProfile?.ShiftEndTime.HasValue == true)
        {
            var localStart = TimeZoneInfo.ConvertTimeFromUtc(
                DateTime.SpecifyKind(first.CapturedAtUtc, DateTimeKind.Utc),
                TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"));
            var timeOnly = TimeOnly.FromDateTime(localStart);
            var sStart = empProfile.ShiftStartTime.Value;
            var sEnd = empProfile.ShiftEndTime.Value;

            bool inShift = sEnd >= sStart
                ? (timeOnly >= sStart && timeOnly <= sEnd)
                : (timeOnly >= sStart || timeOnly <= sEnd);

            if (!inShift)
            {
                isOffShift = true;
                shiftTag = "Off-Duty / Non-Shift Gap";
            }
        }

        var lastPriorPunch = punches
            .Where(p => p.EmployeeID == empId && p.PunchTime < first.CapturedAtUtc)
            .OrderByDescending(p => p.PunchTime)
            .FirstOrDefault();

        var priorState = lastPriorPunch != null
            ? (IsInType(lastPriorPunch.LogType) ? "IN" : "OUT")
            : "OUT";

        var punchesInGap = punches
            .Where(p => p.EmployeeID == empId &&
                        p.PunchTime >= first.CapturedAtUtc.AddMinutes(-2) &&
                        p.PunchTime <= last.CapturedAtUtc.AddMinutes(2))
            .OrderBy(p => p.PunchTime)
            .Select(p => new ReconciledPunch
            {
                Type = p.LogType ?? "PUNCH",
                PunchTimeUtc = p.PunchTime,
                IsApproved = p.IsApproved,
                ChangeDetail = IsOutType(p.LogType)
                    ? "Exited allowed radius → Shift Closed"
                    : "Entered allowed radius → Shift Opened"
            })
            .ToList();

        double totalDist = 0;
        for (int i = 1; i < cluster.Count; i++)
        {
            totalDist += CalculateDistance(cluster[i - 1].Latitude, cluster[i - 1].Longitude, cluster[i].Latitude, cluster[i].Longitude);
        }

        var isSynced = cluster.All(c => c.SyncedAtUtc.HasValue);
        var detectedStays = DetectPeriodStays(cluster, officeLat, officeLon, radiusMeters);

        string liveImpact;
        if (punchesInGap.Any())
        {
            var punchSummary = string.Join(", ", punchesInGap.Select(p =>
                $"{(IsOutType(p.Type) ? "🔴 OUT" : "🟢 IN")} at {FormatIst(p.PunchTimeUtc, "hh:mm tt")} ({p.ChangeDetail})"));
            var stayNote = detectedStays.Any() ? $" • {detectedStays.Count} stop(s) recorded" : "";
            liveImpact = isSynced
                ? $"Live Attendance Updated: {punchSummary}{stayNote} • Reconciled into live attendance ledger"
                : $"Pending Sync: {punchSummary}{stayNote} • Buffered on mobile";
        }
        else if (isOffShift)
        {
            var sRange = empProfile != null && empProfile.ShiftStartTime.HasValue && empProfile.ShiftEndTime.HasValue
                ? $"{empProfile.ShiftStartTime.Value:HH:mm} - {empProfile.ShiftEndTime.Value:HH:mm}"
                : "Off-duty hours";
            liveImpact = $"Off-Duty Window: Outside scheduled shift ({sRange}) • Tracking idle, no attendance punch created";
        }
        else if (priorState == "IN" && cluster.All(x => x.WithinRadius))
        {
            var staySummary = detectedStays.Any() ? $" (Stayed {FormatDuration(detectedStays.First().Duration)})" : "";
            liveImpact = $"Continuous Presence: Remained inside allowed radius{staySummary} • Active shift remained IN (No punches changed)";
        }
        else if (priorState == "OUT")
        {
            liveImpact = "Stationary / Moving Outside: Employee stayed outside allowed radius • Attendance remained OUT (No punches changed)";
        }
        else
        {
            liveImpact = $"No Attendance State Changes: {cluster.Count} offline breadcrumbs captured • Merged to live route";
        }

        return new OfflinePeriodRow
        {
            EmployeeId = empId,
            EmployeeName = empName,
            SessionId = first.SessionId,
            OfflineStartedUtc = first.CapturedAtUtc,
            OfflineEndedUtc = last.CapturedAtUtc,
            PointCount = cluster.Count,
            TotalDistanceMeters = totalDist,
            WithinRadiusCount = cluster.Count(c => c.WithinRadius),
            DisconnectReason = reason,
            IsFullySynced = isSynced,
            SyncedAtUtc = cluster.Select(c => c.SyncedAtUtc).Max(),
            Points = cluster,
            Punches = punchesInGap,
            Stays = detectedStays,
            IsOffShift = isOffShift,
            ShiftTag = shiftTag,
            LiveImpactSummary = liveImpact,
            PriorState = priorState
        };
    }

    private static List<OfflineStay> DetectPeriodStays(List<PointRow> cluster, double officeLat, double officeLon, int radiusMeters)
    {
        var stays = new List<OfflineStay>();
        if (cluster.Count == 0) return stays;

        var ordered = cluster.OrderBy(x => x.CapturedAtUtc).ToList();
        var currentCluster = new List<PointRow> { ordered[0] };

        for (int i = 1; i < ordered.Count; i++)
        {
            var prev = ordered[i - 1];
            var curr = ordered[i];
            var dist = CalculateDistance(prev.Latitude, prev.Longitude, curr.Latitude, curr.Longitude);
            var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;

            if (dist <= 40 && gap <= TimeSpan.FromMinutes(15))
            {
                currentCluster.Add(curr);
            }
            else
            {
                AddStayIfValid(currentCluster, stays, officeLat, officeLon, radiusMeters);
                currentCluster = new List<PointRow> { curr };
            }
        }
        AddStayIfValid(currentCluster, stays, officeLat, officeLon, radiusMeters);
        return stays;
    }

    private static void AddStayIfValid(List<PointRow> points, List<OfflineStay> stays, double officeLat, double officeLon, int radiusMeters)
    {
        if (points.Count == 0) return;
        var first = points.First();
        var last = points.Last();
        var duration = last.CapturedAtUtc - first.CapturedAtUtc;

        if (duration >= TimeSpan.FromMinutes(2) || (points.Count >= 3 && points.All(p => p.SpeedKmh < 1.8)))
        {
            var avgLat = points.Average(p => p.Latitude);
            var avgLon = points.Average(p => p.Longitude);
            double distToOffice = (officeLat != 0 && officeLon != 0)
                ? CalculateDistance(avgLat, avgLon, officeLat, officeLon)
                : 0;
            bool isWithin = (officeLat != 0 && officeLon != 0 && radiusMeters > 0)
                ? distToOffice <= radiusMeters
                : points.Count(p => p.WithinRadius) >= (points.Count / 2.0);

            string locDesc;
            if (officeLat != 0 && officeLon != 0)
            {
                locDesc = isWithin
                    ? $"Inside Office Geofence ({distToOffice:F0}m from center)"
                    : $"Outside Geofence ({distToOffice:F0}m away from office)";
            }
            else
            {
                locDesc = isWithin ? "Inside Allowed Radius" : "Outside Allowed Radius";
            }

            stays.Add(new OfflineStay
            {
                StartUtc = first.CapturedAtUtc,
                EndUtc = last.CapturedAtUtc,
                Latitude = avgLat,
                Longitude = avgLon,
                PointCount = points.Count,
                IsWithinAllowedRadius = isWithin,
                DistanceFromOfficeMeters = distToOffice,
                LocationDescription = locDesc
            });
        }
    }

    private static List<PointRow> BuildPointRows(List<PointRow> rows)
    {
        var previous = new Dictionary<int, PointRow>();
        foreach (var row in rows)
        {
            if (previous.TryGetValue(row.EmployeeId, out var prior))
            {
                var elapsed = (row.CapturedAtUtc - prior.CapturedAtUtc).TotalSeconds;
                var distance = CalculateDistance(prior.Latitude, prior.Longitude, row.Latitude, row.Longitude);
                var speed = elapsed > 0.25 && elapsed <= 300 && distance <= 5000 ? distance / elapsed : 0;
                row.SpeedKmh = speed * 3.6;
                row.Movement = GetMovement(speed);
            }
            previous[row.EmployeeId] = row;
        }
        return rows.OrderByDescending(x => x.CapturedAtUtc).ToList();
    }

    private static string GetMovement(double speedMps)
    {
        if (!double.IsFinite(speedMps) || speedMps <= .5) return "Stopped";
        if (speedMps <= 2) return "Walking";
        if (speedMps <= 8) return "Cycling";
        return "Moving";
    }

    private static string FormatAge(TimeSpan age) =>
        age == TimeSpan.MaxValue ? "Never" :
        age.TotalHours >= 1 ? $"{(int)age.TotalHours}h {age.Minutes}m" :
        $"{Math.Max(0, (int)age.TotalMinutes)}m {Math.Max(0, age.Seconds)}s";

    private static string FormatDuration(TimeSpan duration) =>
        duration.TotalHours >= 1 ? $"{(int)duration.TotalHours}h {duration.Minutes}m" :
        $"{Math.Max(1, (int)duration.TotalMinutes)}m {duration.Seconds}s";

    private static double CalculateDistance(double aLat, double aLon, double bLat, double bLon)
    {
        const double r = 6371000d;
        var p1 = aLat * Math.PI / 180d;
        var p2 = bLat * Math.PI / 180d;
        var dp = (bLat - aLat) * Math.PI / 180d;
        var dl = (bLon - aLon) * Math.PI / 180d;
        var a = Math.Sin(dp / 2) * Math.Sin(dp / 2) +
                Math.Cos(p1) * Math.Cos(p2) * Math.Sin(dl / 2) * Math.Sin(dl / 2);
        return r * 2 * Math.Atan2(Math.Sqrt(Math.Clamp(a, 0, 1)), Math.Sqrt(1 - Math.Clamp(a, 0, 1)));
    }

    private static string FormatDistance(double meters) =>
        meters >= 1000 ? $"{meters / 1000d:F2} km" : $"{meters:F0} m";

    private static string FormatIst(DateTime? utc, string format = "dd-MMM-yyyy HH:mm:ss") =>
        utc.HasValue ? TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(utc.Value, DateTimeKind.Utc),
            TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"))
            .ToString(format) : "-";

    private static DateTime IndiaToUtc(DateTime india) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(india, DateTimeKind.Unspecified),
            TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"));

