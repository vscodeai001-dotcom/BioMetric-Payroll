    private static bool IsInType(string? type)
    {
        var t = type?.Trim().ToUpperInvariant() ?? "";
        return t == "IN" || t == "CHECKIN" || t == "CHECK_IN" || t == "PUNCH" || t.StartsWith("AUTO_IN");
    }

    private static bool IsOutType(string? type)
    {
        var t = type?.Trim().ToUpperInvariant() ?? "";
        return t == "OUT" || t == "CHECKOUT" || t == "CHECK_OUT" || t.StartsWith("AUTO_OUT");
    }

    private static (string Icon, string Title, string Badge, string BadgeClass, string CleanDetails) FormatAuditEvent(string eventType, string? rawDetails)
    {
        var type = eventType?.ToUpperInvariant() ?? "";
        string icon;
        string title;
        string badge;
        string badgeClass;

        if (type.Contains("OFFLINE_PERIOD"))
        {
            icon = "📴";
            title = "Offline Tracking Period Completed";
            badge = "OFFLINE SESSION";
            badgeClass = "bg-warning text-dark";
        }
        else if (type.Contains("NETWORK_OFFLINE") || type.Contains("LOST") || type.Contains("DISCONNECT"))
        {
            icon = "⚠️";
            title = "Network Connection Lost";
            badge = "OFFLINE";
            badgeClass = "bg-danger";
        }
        else if (type.Contains("NETWORK_ONLINE") || type.Contains("RESTORE") || type.Contains("RECONNECT"))
        {
            icon = "📶";
            title = "Network Connection Restored";
            badge = "ONLINE";
            badgeClass = "bg-success";
        }
        else if (type.Contains("SYNC"))
        {
            icon = "☁️";
            title = "Cloud Synchronization Completed";
            badge = "SYNCED";
            badgeClass = "bg-primary";
        }
        else if (type.Contains("GEOFENCE") || type.Contains("RADIUS"))
        {
            icon = "🏢";
            title = "Geofence Perimeter Event";
            badge = "GEOFENCE";
            badgeClass = "bg-info text-dark";
        }
        else if (type.Contains("PUNCH") || type.Contains("ATTENDANCE"))
        {
            icon = "🕒";
            title = "Attendance Punch Recorded";
            badge = "ATTENDANCE";
            badgeClass = "bg-success";
        }
        else
        {
            icon = "📋";
            title = eventType?.Replace('_', ' ') ?? "Audit Event";
            badge = "AUDIT";
            badgeClass = "bg-secondary";
        }

        var details = rawDetails ?? "";
        var epochRegex = new System.Text.RegularExpressions.Regex(@"Start:\s*(\d{12,14})\s*•\s*End:\s*(\d{12,14})");
        details = epochRegex.Replace(details, m =>
        {
            if (long.TryParse(m.Groups[1].Value, out var sMs) && long.TryParse(m.Groups[2].Value, out var eMs))
            {
                var sDate = DateTimeOffset.FromUnixTimeMilliseconds(sMs).ToOffset(TimeSpan.FromHours(5.5));
                var eDate = DateTimeOffset.FromUnixTimeMilliseconds(eMs).ToOffset(TimeSpan.FromHours(5.5));
                return $"Offline Window: {sDate:hh:mm tt} – {eDate:hh:mm tt} IST";
            }
            return m.Value;
        });

        details = System.Text.RegularExpressions.Regex.Replace(details, @"network=\w+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        details = System.Text.RegularExpressions.Regex.Replace(details, @"queue=\d+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        details = System.Text.RegularExpressions.Regex.Replace(details, @"queued=\d+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        details = System.Text.RegularExpressions.Regex.Replace(details, @"id=[a-f0-9\-]+", "", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        details = details.Replace("•  •", "•").Replace("• •", "•").Trim(' ', '•').Trim();

        if (string.IsNullOrWhiteSpace(details))
            details = "Operational event captured and verified.";

        return (icon, title, badge, badgeClass, details);
    }

