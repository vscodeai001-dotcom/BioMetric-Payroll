@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using global::Payroll.Web.Services
@using global::Payroll.Web.Models
@using global::Payroll.Web.Components.UI.Admin

@inject IJSRuntime JSRuntime
@inject IDbContextFactory<AppDbContext> DbFactory
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject IToastService toastService
@inject ILogger<UserManagement> _logger
@inject AuditService AuditService
@inject Payroll.Web.Services.AttendanceRefreshService AttendanceRefresh
@inject FirebaseRealtimeService FirebaseRealtime
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@inject Payroll.Web.Services.FirebaseUserManagementService FirebaseUsers

@attribute [Authorize(Roles = "SuperAdmin")]

<PageTitle>User & Role Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>User & Role Management</h3>
    <p class="lead mb-0">Manage users, assign roles, and link them to employee records.</p>
</div>

@if (isLoading)
{
    <p><em>Loading users & roles...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-5 mb-4">
            <UserCreationForm NewUserForm="newUserForm"
                              UnlinkedEmployees="unlinkedEmployees"
                              IsSaving="isSaving"
                              OnCreateUser="CreateNewUser" />
        </div>

        <div class="col-md-7 mb-4">

            @* ---- EVENT HANDLERS PASSED TO CHILD ---- *@
            @* ---- STATE BINDINGS PASSED TO CHILD ----- *@

            <UserListTable UserList="userList"
                           IsLoading="isLoading"
                           IsSaving="isSaving"
                           OnEditRoleRequested="HandleEditRoleStart"
                           OnDeleteUser="ConfirmDeleteUser"
                           UpdateUserRole="UpdateUserRole"
                           ShowEditRoleModal="showEditRoleModal"
                           UserToEditRole="userToEditRole"
                           NewRoleForUser="newRoleForUser"
                           ShowEditRoleModalChanged="((bool v) => showEditRoleModal = v)"
                           UserToEditRoleChanged="((UserRoleViewModel? v) => userToEditRole = v)"
                           NewRoleForUserChanged="((string v) => newRoleForUser = v)" />
        </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRefresh" />

@code {
    private bool isLoading = true;
    private bool isSaving = false;

    private List<UserRoleViewModel> userList = new();
    private List<Employee> allEmployees = new();

    private List<Employee> unlinkedEmployees =>
        allEmployees
            .Where(e => !userList.Any(u =>
                (u.EmployeeId.HasValue && u.EmployeeId.Value == e.EmployeeID) ||
                (!string.IsNullOrWhiteSpace(e.Email) && !string.IsNullOrWhiteSpace(u.Email) && string.Equals(e.Email.Trim(), u.Email.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                (!string.IsNullOrWhiteSpace(e.AspNetUserId) && (u.UserId == e.AspNetUserId || u.FirebaseUid == e.AspNetUserId))))
            .ToList();

    private NewUserFormModel newUserForm = new();

    private UserRoleViewModel? userToEditRole;
    private string newRoleForUser = "Employee";
    private bool showEditRoleModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsersAndRoles();
    }

    private async Task LoadUsersAndRoles(AppDbContext? dbContext = null)
    {
        isLoading = true;
        try
        {
            allEmployees = await FirebaseEmployees.GetEmployeesAsync();
            userList = await FirebaseUsers.GetAllUsersAsync(allEmployees);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error loading user data.");
            toastService.ShowError("Error loading user data.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CreateNewUser()
    {
        isSaving = true;
        try
        {
            if (newUserForm.InitialRole.Equals("Employee", StringComparison.OrdinalIgnoreCase) &&
                !newUserForm.EmployeeId.HasValue)
            {
                toastService.ShowError("Select a saved Employee before creating an Employee account.");
                return;
            }

            var result = await FirebaseUsers.CreateAsync(
                newUserForm.Email,
                newUserForm.Password,
                newUserForm.InitialRole,
                newUserForm.EmployeeId ?? 0,
                newUserForm.Email,
                CancellationToken.None);

            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_CREATED");
            toastService.ShowSuccess("User created and synchronized.");
            newUserForm = new();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error creating synchronized user.");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            await LoadUsersAndRoles();
            isSaving = false;
        }
    }

    private void HandleEditRoleStart(UserRoleViewModel user)
    {
        userToEditRole = user;
        newRoleForUser = user.CurrentRole;
        showEditRoleModal = true;
    }

    private async Task UpdateUserRole()
    {
        if (userToEditRole == null) return;
        isSaving = true;

        try
        {
            var targetUid = userToEditRole.FirebaseUid ?? userToEditRole.UserId;
            var result = await FirebaseUsers.ChangeRoleAsync(targetUid, newRoleForUser, CancellationToken.None);
            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_ROLE_UPDATED");
            toastService.ShowSuccess($"Role updated to {newRoleForUser}.");
            showEditRoleModal = false; // Close modal on success
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error updating role");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
            await LoadUsersAndRoles();
        }
    }

    private async Task HandleRefresh()
    {
        await LoadUsersAndRoles();
    }

    private async Task ConfirmDeleteUser(UserRoleViewModel user)
    {
        if (user.CurrentRole == "SuperAdmin")
        {
            toastService.ShowWarning("Cannot delete SuperAdmin.");
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Delete {user.Email}?")) return;

        await DeleteUser(user);
    }

    private async Task DeleteUser(UserRoleViewModel user)
    {
        isSaving = true;
        try
        {
            var targetUid = user.FirebaseUid ?? user.UserId;
            var result = await FirebaseUsers.DeleteAsync(targetUid, CancellationToken.None);
            if (!result.Success)
            {
                toastService.ShowError(result.Message);
                return;
            }

            await AttendanceRefresh.NotifyGlobalRefreshAsync("USER_DELETED");
            toastService.ShowSuccess("User deleted.");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Error deleting user");
            toastService.ShowError(ex.Message);
        }
        finally
        {
            await LoadUsersAndRoles();
            isSaving = false;
        }
    }
}
