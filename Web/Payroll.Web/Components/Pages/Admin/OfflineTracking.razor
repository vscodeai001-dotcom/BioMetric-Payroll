@page "/admin/offline-tracking"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Web.Services
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject Payroll.Web.Services.FirebaseEmployeeManagementService FirebaseEmployees
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>GPS Connection & Offline Tracking</PageTitle>

<AttendanceRefreshListener OnAttendanceChanged="Refresh" OnLocationChanged="Refresh" />

<div class="container-fluid py-3 offline-tracking-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-cloud-slash text-primary me-2"></i>GPS Connection & Offline Tracking</h3>
            <p class="text-muted mb-0">Live connection health and the last known employee GPS state.</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="Refresh" disabled="@loading">
            <i class="bi bi-arrow-clockwise @(loading ? "spin" : "") me-1"></i>Refresh
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Live</small><strong class="fs-3 text-success">@liveCount</strong></div></div>
        <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Stale</small><strong class="fs-3 text-warning">@staleCount</strong></div></div>
        <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Offline</small><strong class="fs-3 text-danger">@offlineCount</strong></div></div>
        <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm p-3"><small class="text-muted">Last refresh</small><strong class="fs-6">@lastRefreshText</strong></div></div>
    </div>

    @if (loading)
    {
        <div class="card border-0 shadow-sm p-4 text-center"><span class="spinner-border spinner-border-sm me-2"></span>Loading GPS connection status...</div>
    }
    else if (rows.Count == 0)
    {
        <div class="card border-0 shadow-sm p-4 text-center text-muted">No active GPS sessions are currently registered.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead><tr><th>Employee</th><th>Status</th><th>Last update</th><th>Age</th><th>Movement</th><th>Speed</th><th>Last location</th></tr></thead>
                    <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td><strong>@row.EmployeeName</strong><div class="small text-muted">ID @row.EmployeeId</div></td>
                            <td><span class="badge @row.StatusClass">@row.Status</span></td>
                            <td>@(row.LastUpdatedUtc.HasValue ? ToLocal(row.LastUpdatedUtc.Value).ToString("dd MMM yyyy HH:mm:ss") : "Never")</td>
                            <td>@FormatAge(row.Age)</td>
                            <td>@row.MovementState</td>
                            <td>@FormatSpeed(row.SpeedMps)</td>
                            <td><code>@row.Latitude.ToString("F6"), @row.Longitude.ToString("F6")</code><div class="small text-muted">@row.Geofence</div></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center flex-wrap gap-2 py-3">
            <div>
                <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-warning me-2"></i>Offline Disconnection Intervals (Missing Window Reconciliation)</h5>
                <small class="text-muted">Detected mobile offline windows (airplane mode, network disconnected) captured locally and synced to cloud.</small>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a href="/admin/offline-tracking-details" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-box-arrow-up-right me-1"></i>Full Audit Details
                </a>
                <span class="badge bg-warning text-dark">@offlinePeriods.Count offline periods</span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (offlinePeriods.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>
                    No offline tracking periods recorded today. All mobile tracking has been streaming live.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Employee</th>
                                <th>Offline Started</th>
                                <th>Reconnected</th>
                                <th>Duration & Mode</th>
                                <th>Changes Made to Live Attendance</th>
                                <th>GPS Breadcrumbs</th>
                                <th>Live Data Reconciliation</th>
                                <th class="text-end">Inspect</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var period in offlinePeriods)
                        {
                            var isSelected = period.Id == selectedOfflinePeriodId;
                            <tr class="@(isSelected ? "table-warning fw-semibold" : "")">
                                <td>
                                    <strong>@period.EmployeeName</strong>
                                    <div class="small text-muted">ID @period.EmployeeId</div>
                                </td>
                                <td>
                                    <div><i class="bi bi-wifi-off text-danger me-1"></i>@ToLocal(period.StartUtc).ToString("dd MMM HH:mm:ss")</div>
                                    <span class="badge bg-secondary-subtle text-secondary small">@period.DisconnectReason</span>
                                </td>
                                <td>
                                    <div><i class="bi bi-wifi text-success me-1"></i>@ToLocal(period.EndUtc).ToString("dd MMM HH:mm:ss")</div>
                                    <small class="text-success"><i class="bi bi-check2 me-1"></i>Connection restored</small>
                                </td>
                                <td>
                                    <span class="badge bg-dark-subtle text-dark">@FormatAge(period.Duration)</span>
                                    <div class="mt-1">
                                        @if (period.IsOffShift)
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border">@period.ShiftTag</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">@period.ShiftTag</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (period.Punches.Any())
                                    {
                                        <div class="d-flex flex-column gap-1">
                                        @foreach (var p in period.Punches)
                                        {
                                            var isOut = p.Type.Equals("OUT", StringComparison.OrdinalIgnoreCase);
                                            <span class="badge @(isOut ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") text-start">
                                                @(isOut ? "🔴 OUT Punch Added" : "🟢 IN Punch Added"): @ToLocal(p.PunchTimeUtc).ToString("hh:mm tt")
                                                <small class="d-block fw-normal text-muted">@p.ChangeDetail</small>
                                            </span>
                                        }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="small text-muted">
                                            <i class="bi bi-shield-check text-secondary me-1"></i>
                                            @period.LiveImpactSummary
                                        </div>
                                    }
                                    @if (period.Stays.Any())
                                    {
                                        <div class="small text-secondary mt-1">
                                            <i class="bi bi-geo-alt-fill text-primary me-1"></i>
                                            @period.Stays.Count stop(s) during offline window
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div><span class="badge bg-info-subtle text-info-emphasis">@period.PointCount points</span> · @FormatDistance(period.DistanceMeters)</div>
                                    <div class="small mt-1">
                                        <span class="badge bg-success-subtle text-success">@period.InRadiusCount In</span>
                                        @if (period.PointCount - period.InRadiusCount > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger ms-1">@(period.PointCount - period.InRadiusCount) Out</span>
                                        }
                                        @if (period.Stays.Any())
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary ms-1">@period.Stays.Count stops</span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    @if (period.IsSynced)
                                    {
                                        <div>
                                            <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Reconciled to Live</span>
                                            <div class="small text-primary mt-1">
                                                <i class="bi bi-cloud-arrow-up me-1"></i>Pushed from mobile to live upon reconnection
                                                @if (period.Punches.Any())
                                                {
                                                    <div class="fw-semibold text-success">(@period.Punches.Count punches added & @period.PointCount points merged)</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Pending Sync</span>
                                            <div class="small text-warning-emphasis mt-1">
                                                <i class="bi bi-phone me-1"></i>Buffered in mobile local storage
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm @(isSelected ? "btn-warning" : "btn-outline-primary")" @onclick="() => TogglePeriod(period.Id)">
                                        <i class="bi @(isSelected ? "bi-check2-circle" : "bi-map") me-1"></i>@(isSelected ? "Selected" : "View Route")
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrEmpty(selectedOfflinePeriodId))
                {
                    var activePeriod = offlinePeriods.FirstOrDefault(x => x.Id == selectedOfflinePeriodId);
                    if (activePeriod != null)
                    {
                        <div class="border-top p-3 bg-light-subtle">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h6 class="fw-bold mb-0 text-primary">
                                        <i class="bi bi-clock-history me-1"></i>Offline Disconnection Breakdown for @activePeriod.EmployeeName
                                    </h6>
                                    <small class="text-muted">
                                        Disconnected: @ToLocal(activePeriod.StartUtc).ToString("dd MMM hh:mm:ss tt") → Reconnected: @ToLocal(activePeriod.EndUtc).ToString("hh:mm:ss tt") IST (@FormatAge(activePeriod.Duration)) • Mode: @activePeriod.DisconnectReason
                                    </small>
                                </div>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => selectedOfflinePeriodId = null">
                                    <i class="bi bi-x-lg me-1"></i>Close
                                </button>
                            </div>

                            <!-- Punches and Live Reconciliation -->
                            <div class="alert alert-light border shadow-sm mb-3">
                                <div class="d-flex align-items-start gap-2">
                                    <i class="bi bi-shield-check text-success fs-5 mt-1"></i>
                                    <div>
                                        <strong>Live Attendance Reconciliation</strong>
                                        <div class="text-muted small">@activePeriod.LiveImpactSummary</div>
                                        @if (activePeriod.Punches.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-2 mt-2">
                                                @foreach (var p in activePeriod.Punches)
                                                {
                                                    var isOut = IsOutType(p.Type);
                                                    <span class="badge @(isOut ? "bg-danger" : "bg-success") p-2 text-start">
                                                        <i class="bi @(isOut ? "bi-box-arrow-right" : "bi-box-arrow-in-right") me-1"></i>
                                                        @(isOut ? "🔴 OUT Punch" : "🟢 IN Punch"): @ToLocal(p.PunchTimeUtc).ToString("hh:mm tt")
                                                        <small class="d-block fw-normal opacity-75">@p.ChangeDetail • Applied to live shift logs</small>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Detected Stays During Offline Window -->
                            <div class="card border-0 shadow-sm mb-3">
                                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                    <strong class="small text-uppercase text-secondary">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>Stationary Stops & Stays During Disconnect (@activePeriod.Stays.Count detected)
                                    </strong>
                                    <span class="badge bg-secondary-subtle text-secondary small">Dwell ≥ 2 mins</span>
                                </div>
                                <div class="card-body p-3">
                                    @if (activePeriod.Stays.Any())
                                    {
                                        <div class="row g-2">
                                            @foreach (var stay in activePeriod.Stays)
                                            {
                                                <div class="col-12 col-md-6 col-xl-4">
                                                    <div class="p-2 rounded border bg-white shadow-sm h-100">
                                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                                            <span class="badge @(stay.IsWithinAllowedRadius ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning-emphasis border border-warning-subtle")">
                                                                <i class="bi @(stay.IsWithinAllowedRadius ? "bi-building-check" : "bi-geo-alt") me-1"></i>
                                                                @(stay.IsWithinAllowedRadius ? "Inside Geofence" : "Outside Geofence")
                                                            </span>
                                                            <strong class="text-primary small">@FormatAge(stay.Duration) dwell</strong>
                                                        </div>
                                                        <div class="fw-semibold small">@ToLocal(stay.StartUtc).ToString("hh:mm tt") → @ToLocal(stay.EndUtc).ToString("hh:mm tt")</div>
                                                        <div class="text-muted small mt-1">@stay.LocationDescription</div>
                                                        <div class="small text-secondary mt-1">
                                                            <code>@stay.Latitude.ToString("F5"), @stay.Longitude.ToString("F5")</code> · @stay.PointCount points
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small text-center py-2">
                                            <i class="bi bi-arrow-repeat me-1"></i>Continuous movement without stationary stops during this offline window.
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Breadcrumb points ledger -->
                            <div class="card border-0 shadow-sm overflow-hidden">
                                <div class="card-header bg-white py-2 d-flex justify-content-between align-items-center">
                                    <strong class="small text-uppercase text-secondary">
                                        <i class="bi bi-broadcast text-primary me-1"></i>Captured Breadcrumb Points (@activePeriod.Points.Count points)
                                    </strong>
                                </div>
                                <div class="table-responsive" style="max-height: 250px; overflow-y: auto;">
                                    <table class="table table-sm table-hover mb-0 bg-white small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Captured (IST)</th>
                                                <th>Coordinates</th>
                                                <th>Movement</th>
                                                <th>Speed</th>
                                                <th>Geofence</th>
                                                <th>Sync Time</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @{ int idx = 1; }
                                        @foreach (var pt in activePeriod.Points.OrderBy(x => x.CapturedAtUtc))
                                        {
                                            <tr>
                                                <td>@(idx++)</td>
                                                <td>@ToLocal(pt.CapturedAtUtc).ToString("HH:mm:ss")</td>
                                                <td><code>@pt.Latitude.ToString("F5"), @pt.Longitude.ToString("F5")</code></td>
                                                <td>@pt.MovementState</td>
                                                <td>@FormatSpeed(pt.SpeedMps)</td>
                                                <td><span class="badge @(pt.IsWithinAllowedRadius ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle")">@(pt.IsWithinAllowedRadius ? "Within" : "Outside")</span></td>
                                                <td>@(pt.SyncedAtUtc.HasValue ? ToLocal(pt.SyncedAtUtc.Value).ToString("HH:mm:ss") : "Pending")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
        </div>
    </div>
</div>

<style>
    .offline-tracking-page .card { border-radius: 14px; }
    .offline-tracking-page .table thead th { white-space: nowrap; font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; }
    .offline-tracking-page code { font-size: .78rem; }
</style>

@code {
    private bool loading;
    private DateTime? lastRefresh;
    private List<Row> rows = new();
    private List<OfflineSyncRow> offlineSyncRows = new();
    private List<OfflinePeriodDisplay> offlinePeriods = new();
    private string? selectedOfflinePeriodId;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;

    private void TogglePeriod(string id)
    {
        selectedOfflinePeriodId = selectedOfflinePeriodId == id ? null : id;
    }

    private int liveCount => rows.Count(x => x.Status == "Live");
    private int staleCount => rows.Count(x => x.Status == "Stale");
    private int offlineCount => rows.Count(x => x.Status == "Offline");
    private int offlineSyncCount => offlineSyncRows.Count;
    private string lastRefreshText => lastRefresh.HasValue ? ToLocal(lastRefresh.Value).ToString("HH:mm:ss") : "-";

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoopAsync(cts.Token);
    }

    private async Task Refresh()
    {
        if (loading) return;
        loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Load the employee list independently of the in-memory GPS store.
            // This keeps the page useful even when an employee has no active
            // GPS session or when the app has just restarted.
            var employeeList = await db.Employees.AsNoTracking()
                .Where(e => !e.IsDeleted)
                .OrderBy(e => e.Name)
                .ToListAsync();

            var employeeMap = employeeList.ToDictionary(x => x.EmployeeID);
            var employeeNames = employeeList.ToDictionary(x => x.EmployeeID, x => x.Name);
            offlineSyncRows = await db.EmployeeLocationHistory.AsNoTracking()
                .Where(point => point.CaptureSource == "OfflineSync" &&
                                point.CapturedAtUtc >= DateTime.UtcNow.Date)
                .OrderByDescending(point => point.CapturedAtUtc)
                .Select(point => new OfflineSyncRow
                {
                    EmployeeId = point.EmployeeId,
                    CapturedAtUtc = point.CapturedAtUtc,
                    SyncedAtUtc = point.SyncedAtUtc,
                    IsWithinAllowedRadius = point.IsWithinAllowedRadius,
                    Latitude = point.Latitude,
                    Longitude = point.Longitude
                }).Take(500).ToListAsync();

            foreach (var row in offlineSyncRows)
                row.EmployeeName = employeeNames.TryGetValue(row.EmployeeId, out var n) ? n : $"Employee {row.EmployeeId}";

            var todayPunches = await db.AttendanceLogs.AsNoTracking()
                .Where(point => point.PunchTime >= DateTime.UtcNow.Date.AddDays(-1))
                .ToListAsync();

            var companySetting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            double officeLat = companySetting?.OfficeLatitude ?? 0.0;
            double officeLon = companySetting?.OfficeLongitude ?? 0.0;
            int radiusMeters = companySetting?.GeoRadiusMeters ?? 100;

            offlineSyncRows.Reverse();
            CalculateOfflineMovement();
            BuildOfflinePeriods(todayPunches, employeeMap, officeLat, officeLon, radiusMeters);

            var trackedEmployees = employeeList;

            var trackedEmpIds = trackedEmployees.Select(e => e.EmployeeID).ToList();
            var recentPoints = await db.EmployeeLocationHistory.AsNoTracking()
                .Where(x => trackedEmpIds.Contains(x.EmployeeId))
                .OrderByDescending(x => x.CapturedAtUtc)
                .Take(500)
                .ToListAsync();

            var lastPointsMap = recentPoints
                .GroupBy(x => x.EmployeeId)
                .ToDictionary(g => g.Key, g => g.First());

            var liveLocations = LiveLocationStore.GetAll()
                .ToDictionary(x => x.EmployeeId);

            rows = trackedEmployees.Select(employee =>
            {
                if (!liveLocations.TryGetValue(employee.EmployeeID, out var location))
                {
                    if (lastPointsMap.TryGetValue(employee.EmployeeID, out var lastPoint))
                    {
                        var pointAge = DateTime.UtcNow - lastPoint.CapturedAtUtc;
                        return new Row
                        {
                            EmployeeId = employee.EmployeeID,
                            EmployeeName = employee.Name,
                            Status = "Offline",
                            StatusClass = "bg-danger-subtle text-danger",
                            LastUpdatedUtc = lastPoint.CapturedAtUtc,
                            Age = pointAge,
                            MovementState = "No active session",
                            SpeedMps = 0,
                            Latitude = lastPoint.Latitude,
                            Longitude = lastPoint.Longitude,
                            Geofence = lastPoint.IsWithinAllowedRadius ? "Within range" : "Outside range"
                        };
                    }

                    return new Row
                    {
                        EmployeeId = employee.EmployeeID,
                        EmployeeName = employee.Name,
                        Status = "Offline",
                        StatusClass = "bg-danger-subtle text-danger",
                        LastUpdatedUtc = null,
                        Age = TimeSpan.MaxValue,
                        MovementState = "No GPS session",
                        SpeedMps = 0,
                        Latitude = 0,
                        Longitude = 0,
                        Geofence = "-"
                    };
                }

                var status = LiveLocationStore.GetStatus(location);
                var age = LiveLocationStore.GetAge(location);

                return new Row
                {
                    EmployeeId = location.EmployeeId,
                    EmployeeName = employee.Name,
                    Status = status.ToString(),
                    StatusClass = status switch
                    {
                        LiveLocationStatus.Live => "bg-success-subtle text-success",
                        LiveLocationStatus.Stale => "bg-warning-subtle text-warning-emphasis",
                        _ => "bg-danger-subtle text-danger"
                    },
                    LastUpdatedUtc = location.LastUpdatedUtc,
                    Age = age,
                    MovementState = location.MovementState,
                    SpeedMps = location.SpeedMps,
                    Latitude = location.Latitude,
                    Longitude = location.Longitude,
                    Geofence = location.IsWithinAllowedRadius ? "Within range" : "Outside range"
                };
            })
            .OrderBy(x => x.Status == "Live" ? 0 : x.Status == "Stale" ? 1 : 2)
            .ThenBy(x => x.EmployeeName)
            .ToList();

            lastRefresh = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Offline tracking refresh failed: {ex}");
        }
        finally
        {
            loading = false;
        }
    }

    private void CalculateOfflineMovement()
    {
        if (offlineSyncRows.Count == 0)
            return;

        var previousByEmployee = new Dictionary<int, OfflineSyncRow>();

        foreach (var row in offlineSyncRows)
        {
            if (previousByEmployee.TryGetValue(row.EmployeeId, out var previous))
            {
                var elapsed = (row.CapturedAtUtc - previous.CapturedAtUtc).TotalSeconds;
                var distance = CalculateDistanceMeters(
                    previous.Latitude,
                    previous.Longitude,
                    row.Latitude,
                    row.Longitude);

                row.SpeedMps = elapsed > 0.25 && elapsed <= 300 && distance <= 5000
                    ? distance / elapsed
                    : 0;
                row.MovementState = GetMovementState(row.SpeedMps);
            }
            else
            {
                row.SpeedMps = 0;
                row.MovementState = "Stopped";
            }

            previousByEmployee[row.EmployeeId] = row;
        }
    }

    private static string GetMovementState(double speedMps)
    {
        if (!double.IsFinite(speedMps) || speedMps <= 0.5) return "Stopped";
        if (speedMps <= 2.0) return "Walking";
        if (speedMps <= 8.0) return "Cycling";
        return "Moving";
    }

    private static double CalculateDistanceMeters(double lat1, double lon1, double lat2, double lon2)
    {
        const double earthRadiusMeters = 6371000d;
        var r1 = lat1 * Math.PI / 180d;
        var r2 = lat2 * Math.PI / 180d;
        var dLat = (lat2 - lat1) * Math.PI / 180d;
        var dLon = (lon2 - lon1) * Math.PI / 180d;
        var a = Math.Sin(dLat / 2d) * Math.Sin(dLat / 2d) +
                Math.Cos(r1) * Math.Cos(r2) *
                Math.Sin(dLon / 2d) * Math.Sin(dLon / 2d);
        a = Math.Clamp(a, 0d, 1d);
        return earthRadiusMeters * 2d * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1d - a));
    }

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        if (timer == null) return;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () => { await Refresh(); StateHasChanged(); });
            }
        }
        catch (OperationCanceledException) { }
    }

    private static string FormatSpeed(double speedMps) => !double.IsFinite(speedMps) || speedMps <= .05 ? "0 km/h" : $"{speedMps * 3.6:F1} km/h";
    private static string FormatAge(TimeSpan age) => age == TimeSpan.MaxValue ? "Never" : age.TotalDays >= 1 ? $"{(int)age.TotalDays}d {age.Hours}h" : age.TotalHours >= 1 ? $"{(int)age.TotalHours}h {age.Minutes}m" : $"{Math.Max(0, (int)age.TotalMinutes)}m {Math.Max(0, age.Seconds)}s";
    private static string FormatDistance(double m) => m >= 1000 ? $"{m / 1000:F2} km" : $"{m:F0} m";
    private static DateTime ToLocal(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata"));

    private void BuildOfflinePeriods(List<AttendanceLog> todayPunches, Dictionary<int, Employee> employeeMap, double officeLat, double officeLon, int radiusMeters)
    {
        offlinePeriods.Clear();
        if (offlineSyncRows.Count == 0) return;

        foreach (var group in offlineSyncRows.GroupBy(x => x.EmployeeId))
        {
            var empId = group.Key;
            employeeMap.TryGetValue(empId, out var empProfile);

            var cluster = new List<OfflineSyncRow>();
            OfflineSyncRow? last = null;

            foreach (var pt in group.OrderBy(x => x.CapturedAtUtc))
            {
                if (last == null || (pt.CapturedAtUtc - last.CapturedAtUtc).TotalMinutes > 15)
                {
                    if (cluster.Any())
                    {
                        offlinePeriods.Add(CreateOfflinePeriod(cluster, todayPunches, empProfile, officeLat, officeLon, radiusMeters));
                        cluster = new List<OfflineSyncRow>();
                    }
                }
                cluster.Add(pt);
                last = pt;
            }

            if (cluster.Any())
            {
                offlinePeriods.Add(CreateOfflinePeriod(cluster, todayPunches, empProfile, officeLat, officeLon, radiusMeters));
            }
        }

        offlinePeriods = offlinePeriods.OrderByDescending(x => x.StartUtc).ToList();
    }

    private static OfflinePeriodDisplay CreateOfflinePeriod(List<OfflineSyncRow> cluster, List<AttendanceLog> todayPunches, Employee? empProfile, double officeLat, double officeLon, int radiusMeters)
    {
        var first = cluster.First();
        var last = cluster.Last();
        double dist = 0;
        for (int i = 1; i < cluster.Count; i++)
        {
            dist += CalculateDistanceMeters(cluster[i - 1].Latitude, cluster[i - 1].Longitude, cluster[i].Latitude, cluster[i].Longitude);
        }

        var isShiftMode = (empProfile?.TrackingMode ?? "24/7").Trim().Equals("SHIFT", StringComparison.OrdinalIgnoreCase) ||
                          (empProfile?.TrackingMode ?? "").Contains("SHIFT", StringComparison.OrdinalIgnoreCase);

        bool isOffShift = false;
        string shiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking";

        if (isShiftMode && empProfile?.ShiftStartTime.HasValue == true && empProfile?.ShiftEndTime.HasValue == true)
        {
            var localStart = ToLocal(first.CapturedAtUtc);
            var timeOnly = TimeOnly.FromDateTime(localStart);
            var sStart = empProfile.ShiftStartTime.Value;
            var sEnd = empProfile.ShiftEndTime.Value;

            bool inShift = sEnd >= sStart 
                ? (timeOnly >= sStart && timeOnly <= sEnd)
                : (timeOnly >= sStart || timeOnly <= sEnd);

            if (!inShift)
            {
                isOffShift = true;
                shiftTag = "Off-Duty / Non-Shift Gap";
            }
        }

        var lastPriorPunch = todayPunches
            .Where(p => p.EmployeeID == first.EmployeeId && p.PunchTime < first.CapturedAtUtc)
            .OrderByDescending(p => p.PunchTime)
            .FirstOrDefault();

        var priorState = lastPriorPunch != null
            ? (IsInType(lastPriorPunch.LogType) ? "IN" : "OUT")
            : "OUT";

        var punchesInGap = todayPunches
            .Where(p => p.EmployeeID == first.EmployeeId &&
                        p.PunchTime >= first.CapturedAtUtc.AddMinutes(-2) &&
                        p.PunchTime <= last.CapturedAtUtc.AddMinutes(2))
            .OrderBy(p => p.PunchTime)
            .Select(p => new ReconciledPunch
            {
                Type = p.LogType ?? "PUNCH",
                PunchTimeUtc = p.PunchTime,
                IsApproved = p.IsApproved,
                ChangeDetail = IsOutType(p.LogType) 
                    ? "Exited allowed radius → Closed shift" 
                    : "Entered allowed radius → Opened shift"
            })
            .ToList();

        var isSynced = cluster.All(x => x.SyncedAtUtc.HasValue);
        var detectedStays = DetectPeriodStays(cluster, officeLat, officeLon, radiusMeters);

        string liveImpact;
        if (punchesInGap.Any())
        {
            var punchSummary = string.Join(", ", punchesInGap.Select(p =>
                $"{(IsOutType(p.Type) ? "🔴 OUT" : "🟢 IN")} at {ToLocal(p.PunchTimeUtc):hh:mm tt} ({p.ChangeDetail})"));
            var stayNote = detectedStays.Any() ? $" • {detectedStays.Count} stop(s) recorded" : "";
            liveImpact = isSynced
                ? $"Live Attendance Updated: {punchSummary}{stayNote} • Successfully reconciled into live attendance ledger"
                : $"Pending Sync: {punchSummary}{stayNote} • Buffered on mobile";
        }
        else if (isOffShift)
        {
            var sRange = empProfile != null && empProfile.ShiftStartTime.HasValue && empProfile.ShiftEndTime.HasValue
                ? $"{empProfile.ShiftStartTime.Value:HH:mm} - {empProfile.ShiftEndTime.Value:HH:mm}"
                : "Off-duty hours";
            liveImpact = $"Off-Duty Window: Outside scheduled shift ({sRange}) • Tracking idle, no attendance punch created";
        }
        else if (priorState == "IN" && cluster.Any(x => x.IsWithinAllowedRadius))
        {
            var staySummary = detectedStays.Any() ? $" (Stayed {FormatAge(detectedStays.First().Duration)})" : "";
            liveImpact = $"Continuous Presence: Employee remained inside allowed radius{staySummary} • Active shift remained IN (No punches changed)";
        }
        else if (priorState == "OUT")
        {
            liveImpact = "Stationary / Moving Outside: Employee stayed outside allowed radius • Attendance remained OUT (No punches changed)";
        }
        else
        {
            liveImpact = $"No Attendance State Changes: {cluster.Count} offline breadcrumbs captured • Merged to live route";
        }

        return new OfflinePeriodDisplay
        {
            EmployeeId = first.EmployeeId,
            EmployeeName = first.EmployeeName,
            StartUtc = first.CapturedAtUtc,
            EndUtc = last.CapturedAtUtc,
            PointCount = cluster.Count,
            DistanceMeters = dist,
            InRadiusCount = cluster.Count(x => x.IsWithinAllowedRadius),
            SyncedAtUtc = cluster.Select(x => x.SyncedAtUtc).Max(),
            IsSynced = isSynced,
            Points = cluster,
            Punches = punchesInGap,
            Stays = detectedStays,
            DisconnectReason = "Network Disconnected / Signal Loss",
            IsOffShift = isOffShift,
            ShiftTag = shiftTag,
            LiveImpactSummary = liveImpact,
            PriorState = priorState
        };
    }

    private static List<OfflineStay> DetectPeriodStays(List<OfflineSyncRow> cluster, double officeLat, double officeLon, int radiusMeters)
    {
        var stays = new List<OfflineStay>();
        if (cluster.Count == 0) return stays;

        var ordered = cluster.OrderBy(x => x.CapturedAtUtc).ToList();
        var currentCluster = new List<OfflineSyncRow> { ordered[0] };

        for (int i = 1; i < ordered.Count; i++)
        {
            var prev = ordered[i - 1];
            var curr = ordered[i];
            var dist = CalculateDistanceMeters(prev.Latitude, prev.Longitude, curr.Latitude, curr.Longitude);
            var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;

            if (dist <= 40 && gap <= TimeSpan.FromMinutes(15))
            {
                currentCluster.Add(curr);
            }
            else
            {
                AddStayIfValid(currentCluster, stays, officeLat, officeLon, radiusMeters);
                currentCluster = new List<OfflineSyncRow> { curr };
            }
        }
        AddStayIfValid(currentCluster, stays, officeLat, officeLon, radiusMeters);
        return stays;
    }

    private static void AddStayIfValid(List<OfflineSyncRow> points, List<OfflineStay> stays, double officeLat, double officeLon, int radiusMeters)
    {
        if (points.Count == 0) return;
        var first = points.First();
        var last = points.Last();
        var duration = last.CapturedAtUtc - first.CapturedAtUtc;

        if (duration >= TimeSpan.FromMinutes(2) || (points.Count >= 3 && points.All(p => p.SpeedMps < 0.5)))
        {
            var avgLat = points.Average(p => p.Latitude);
            var avgLon = points.Average(p => p.Longitude);
            double distToOffice = (officeLat != 0 && officeLon != 0)
                ? CalculateDistanceMeters(avgLat, avgLon, officeLat, officeLon)
                : 0;
            bool isWithin = (officeLat != 0 && officeLon != 0 && radiusMeters > 0)
                ? distToOffice <= radiusMeters
                : points.Count(p => p.IsWithinAllowedRadius) >= (points.Count / 2.0);

            string locDesc;
            if (officeLat != 0 && officeLon != 0)
            {
                locDesc = isWithin
                    ? $"Inside Office Geofence ({distToOffice:F0}m from center)"
                    : $"Outside Geofence ({distToOffice:F0}m away from office)";
            }
            else
            {
                locDesc = isWithin ? "Inside Allowed Radius" : "Outside Allowed Radius";
            }

            stays.Add(new OfflineStay
            {
                StartUtc = first.CapturedAtUtc,
                EndUtc = last.CapturedAtUtc,
                Latitude = avgLat,
                Longitude = avgLon,
                PointCount = points.Count,
                IsWithinAllowedRadius = isWithin,
                DistanceFromOfficeMeters = distToOffice,
                LocationDescription = locDesc
            });
        }
    }

    private static bool IsInType(string? type)
    {
        var t = type?.Trim().ToUpperInvariant() ?? "";
        return t == "IN" || t == "CHECKIN" || t == "CHECK_IN" || t == "PUNCH" || t.StartsWith("AUTO_IN");
    }

    private static bool IsOutType(string? type)
    {
        var t = type?.Trim().ToUpperInvariant() ?? "";
        return t == "OUT" || t == "CHECKOUT" || t == "CHECK_OUT" || t.StartsWith("AUTO_OUT");
    }

    public async ValueTask DisposeAsync()
    {
        try { cts?.Cancel(); } catch { }
        cts?.Dispose();
        timer?.Dispose();
        await Task.CompletedTask;
    }

    private sealed class ReconciledPunch
    {
        public string Type { get; set; } = "IN";
        public DateTime PunchTimeUtc { get; set; }
        public bool IsApproved { get; set; } = true;
        public string ChangeDetail { get; set; } = "";
    }

    private sealed class OfflineSyncRow
    {
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "Employee";
        public DateTime CapturedAtUtc { get; set; }
        public DateTime? SyncedAtUtc { get; set; }
        public double SpeedMps { get; set; }
        public string MovementState { get; set; } = "Stopped";
        public bool IsWithinAllowedRadius { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
    }

    private sealed class Row
    {
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "";
        public string Status { get; set; } = "Offline";
        public string StatusClass { get; set; } = "bg-secondary";
        public DateTime? LastUpdatedUtc { get; set; }
        public TimeSpan Age { get; set; }
        public string MovementState { get; set; } = "Stopped";
        public double SpeedMps { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public string Geofence { get; set; } = "-";
    }

    private sealed class OfflineStay
    {
        public DateTime StartUtc { get; set; }
        public DateTime EndUtc { get; set; }
        public TimeSpan Duration => EndUtc >= StartUtc ? EndUtc - StartUtc : TimeSpan.Zero;
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public int PointCount { get; set; }
        public bool IsWithinAllowedRadius { get; set; }
        public double DistanceFromOfficeMeters { get; set; }
        public string LocationDescription { get; set; } = "";
    }

    private sealed class OfflinePeriodDisplay
    {
        public string Id { get; set; } = Guid.NewGuid().ToString("N");
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "Employee";
        public DateTime StartUtc { get; set; }
        public DateTime EndUtc { get; set; }
        public TimeSpan Duration => EndUtc >= StartUtc ? EndUtc - StartUtc : TimeSpan.Zero;
        public string DisconnectReason { get; set; } = "Network Signal Loss";
        public int PointCount { get; set; }
        public double DistanceMeters { get; set; }
        public int InRadiusCount { get; set; }
        public DateTime? SyncedAtUtc { get; set; }
        public bool IsSynced { get; set; }
        public List<OfflineSyncRow> Points { get; set; } = new();
        public List<ReconciledPunch> Punches { get; set; } = new();
        public List<OfflineStay> Stays { get; set; } = new();
        public bool IsOffShift { get; set; }
        public string ShiftTag { get; set; } = "Active Shift Disconnection";
        public string LiveImpactSummary { get; set; } = "";
        public string PriorState { get; set; } = "OUT";
    }
}
