    private async Task ScrollToMap()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('offline-map-container-card')?.scrollIntoView({ behavior: 'smooth' });");
        }
        catch { }
    }

    private (DateTime fromUtc, DateTime toUtc) GetDateRangeUtc()
    {
        var today = DateTime.Today;
        DateTime startLocal;
        DateTime endLocal;

        switch (dateFilter)
        {
            case "YESTERDAY":
                startLocal = today.AddDays(-1);
                endLocal = today.AddDays(-1).AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "7DAYS":
                startLocal = today.AddDays(-6);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "MONTH":
                startLocal = new DateTime(today.Year, today.Month, 1);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "TODAY":
            default:
                startLocal = today;
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
        }

        return (IndiaToUtc(startLocal), IndiaToUtc(endLocal));
    }

    private Task Refresh() => Refresh(force: false);

    private async Task Refresh(bool force)
    {
        if (loading) return;
        if (!force && (DateTime.UtcNow - lastRefreshInvokedUtc) < RefreshCooldown) return;
        loading = true;
        lastRefreshInvokedUtc = DateTime.UtcNow;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            allEmployees = await db.Employees.AsNoTracking()
                .Where(e => !e.IsDeleted)
                .OrderBy(e => e.Name)
                .ToListAsync();

            var setting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            if (setting != null)
            {
                officeLat = setting.OfficeLatitude;
                officeLng = setting.OfficeLongitude;
                officeRadiusMeters = setting.GeoRadiusMeters;
            }

            var (fromUtc, toUtc) = GetDateRangeUtc();

            // Attendance Logs in window
            var punches = await db.AttendanceLogs.AsNoTracking()
                .Where(p => p.PunchTime >= fromUtc && p.PunchTime <= toUtc)
                .OrderBy(p => p.PunchTime)
                .ToListAsync();

            // Location history in window
            var dbPoints = await db.EmployeeLocationHistory.AsNoTracking()
                .Where(p => p.CapturedAtUtc >= fromUtc && p.CapturedAtUtc <= toUtc)
                .OrderBy(p => p.CapturedAtUtc)
                .ToListAsync();

            // If empty today, fall back to recent points
            if (!dbPoints.Any() && dateFilter == "TODAY")
            {
                dbPoints = await db.EmployeeLocationHistory.AsNoTracking()
                    .OrderByDescending(p => p.CapturedAtUtc)
                    .Take(1000)
                    .ToListAsync();
            }

            // Build all offline periods and ledger
            (allOfflinePeriods, offlineLedgerRows) = BuildAllOfflineData(dbPoints, allEmployees, punches);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing offline tracking data");
        }
        finally
        {
            loading = false;
        }

        await RenderMapAsync();
    }

    private async Task RenderMapAsync(OfflinePeriodDisplayModel? focusedPeriod = null)
    {
        try
        {
            var pointsForMap = new List<object>();
            var staysForMap = new List<object>();

            if (focusedPeriod != null)
            {
                pointsForMap = focusedPeriod.Points.Select((p, idx) => (object)new
                {
                    lat = p.Latitude,
                    lng = p.Longitude,
                    timestamp = ToLocal(p.TimestampUtc).ToString("hh:mm tt"),
                    index = idx + 1,
                    isOffline = true
                }).ToList();

                staysForMap = focusedPeriod.Stays.Select(s => (object)new
                {
                    lat = s.Latitude,
                    lng = s.Longitude,
                    duration = FormatDuration(s.Duration),
                    description = s.LocationDescription,
                    startTime = ToLocal(s.StartUtc).ToString("hh:mm tt"),
                    endTime = ToLocal(s.EndUtc).ToString("hh:mm tt")
                }).ToList();
            }
            else
            {
                var periodsToMap = selectedEmployeeId > 0
                    ? allOfflinePeriods.Where(p => p.EmployeeId == selectedEmployeeId).ToList()
                    : allOfflinePeriods;

                foreach (var p in periodsToMap)
                {
                    pointsForMap.AddRange(p.Points.Select((pt, idx) => (object)new
                    {
                        lat = pt.Latitude,
                        lng = pt.Longitude,
                        timestamp = ToLocal(pt.TimestampUtc).ToString("hh:mm tt"),
                        index = idx + 1,
                        isOffline = true
                    }));
                    staysForMap.AddRange(p.Stays.Select(s => (object)new
                    {
                        lat = s.Latitude,
                        lng = s.Longitude,
                        duration = FormatDuration(s.Duration),
                        description = s.LocationDescription,
                        startTime = ToLocal(s.StartUtc).ToString("hh:mm tt"),
                        endTime = ToLocal(s.EndUtc).ToString("hh:mm tt")
                    }));
                }
            }

            var payload = new
            {
                officeLat = officeLat,
                officeLng = officeLng,
                officeRadiusMeters = officeRadiusMeters,
                routePoints = pointsForMap,
                stays = staysForMap,
                isFocused = focusedPeriod != null,
                employeeName = focusedPeriod?.EmployeeName ?? (selectedEmployeeId > 0 ? selectedEmployeeName : "All Employees"),
                startTime = focusedPeriod != null ? ToLocal(focusedPeriod.StartTimeUtc).ToString("hh:mm tt") : null,
                endTime = focusedPeriod != null ? ToLocal(focusedPeriod.EndTimeUtc).ToString("hh:mm tt") : null,
                duration = focusedPeriod != null ? FormatDuration(focusedPeriod.Duration) : null,
                distance = focusedPeriod != null ? FormatDistance(focusedPeriod.DistanceMeters) : null
            };

            await JSRuntime.InvokeVoidAsync("initializeOfflineTrackingMap", "offline-tracking-map", payload);
            mapRendered = true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Leaflet map initialization notice");
        }
    }

    private (List<OfflinePeriodDisplayModel> periods, List<OfflineLedgerRowModel> ledger) BuildAllOfflineData(
        List<EmployeeLocationHistory> points,
        List<Employee> employees,
        List<AttendanceLog> punches)
    {
        var periods = new List<OfflinePeriodDisplayModel>();
        var ledger = new List<OfflineLedgerRowModel>();
        var pointsByEmp = points.GroupBy(p => p.EmployeeId).ToDictionary(g => g.Key, g => g.OrderBy(p => p.CapturedAtUtc).ToList());

        foreach (var emp in employees)
        {
            var empId = emp.EmployeeID;
            var empName = emp.Name;
            var trackingMode = (emp.TrackingMode ?? "24/7").Trim().ToUpperInvariant();
            var isShiftMode = trackingMode.Contains("SHIFT");
            var shiftStart = emp.ShiftStartTime;
            var shiftEnd = emp.ShiftEndTime;

            if (!pointsByEmp.TryGetValue(empId, out var sorted) || !sorted.Any())
            {
                continue;
            }

            // 1. Contiguous runs of explicit offline points (CaptureSource containing "Offline")
            var rawClusters = new List<List<EmployeeLocationHistory>>();
            var currentOfflineRun = new List<EmployeeLocationHistory>();

            for (int i = 0; i < sorted.Count; i++)
            {
                var pt = sorted[i];
                bool isOffline = pt.CaptureSource?.Contains("Offline", StringComparison.OrdinalIgnoreCase) == true;

                if (isOffline)
                {
                    if (currentOfflineRun.Count == 0)
                    {
                        if (i > 0 && (pt.CapturedAtUtc - sorted[i - 1].CapturedAtUtc) <= TimeSpan.FromMinutes(30))
                        {
                            currentOfflineRun.Add(sorted[i - 1]);
                        }
                        currentOfflineRun.Add(pt);
                    }
                    else
                    {
                        var prevPt = currentOfflineRun.Last();
                        if (pt.CapturedAtUtc - prevPt.CapturedAtUtc <= TimeSpan.FromMinutes(20))
                        {
                            currentOfflineRun.Add(pt);
                        }
                        else
                        {
                            if (currentOfflineRun.Count >= 2)
                            {
                                rawClusters.Add(currentOfflineRun);
                            }
                            currentOfflineRun = new List<EmployeeLocationHistory>();
                            if (i > 0 && (pt.CapturedAtUtc - sorted[i - 1].CapturedAtUtc) <= TimeSpan.FromMinutes(30))
                            {
                                currentOfflineRun.Add(sorted[i - 1]);
                            }
                            currentOfflineRun.Add(pt);
                        }
                    }
                }
                else
                {
                    if (currentOfflineRun.Count > 0)
                    {
                        currentOfflineRun.Add(pt);
                        if (currentOfflineRun.Count >= 2)
                        {
                            rawClusters.Add(currentOfflineRun);
                        }
                        currentOfflineRun = new List<EmployeeLocationHistory>();
                    }
                }
            }
            if (currentOfflineRun.Count >= 2)
            {
                rawClusters.Add(currentOfflineRun);
            }

            // 2. Detect Gaps between consecutive points (>= 10 mins and <= 2 days)
            for (int i = 1; i < sorted.Count; i++)
            {
                var prev = sorted[i - 1];
                var curr = sorted[i];
                var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;

                if (gap >= TimeSpan.FromMinutes(10) && gap <= TimeSpan.FromDays(2))
                {
                    var startUtc = prev.CapturedAtUtc;
                    var endUtc = curr.CapturedAtUtc;

                    var gapPoints = sorted
                        .Where(p => p.CapturedAtUtc >= startUtc && p.CapturedAtUtc <= endUtc)
                        .ToList();

                    if (gapPoints.Count < 2)
                    {
                        gapPoints = new List<EmployeeLocationHistory> { prev, curr };
                    }
                    rawClusters.Add(gapPoints);
                }
            }

            // 3. Sort & Merge overlapping or adjacent clusters (within 5 minutes)
            var sortedClusters = rawClusters
                .Select(c => c.DistinctBy(p => $"{p.Latitude}_{p.Longitude}_{p.CapturedAtUtc:O}").OrderBy(p => p.CapturedAtUtc).ToList())
                .Where(c => c.Count >= 2)
                .OrderBy(c => c.First().CapturedAtUtc)
                .ToList();

            var clusters = new List<List<EmployeeLocationHistory>>();
            foreach (var cand in sortedClusters)
            {
                if (clusters.Count == 0)
                {
                    clusters.Add(cand);
                }
                else
                {
                    var lastCluster = clusters.Last();
                    var lastEnd = lastCluster.Last().CapturedAtUtc;
                    var candStart = cand.First().CapturedAtUtc;
                    if (candStart <= lastEnd.AddMinutes(5))
                    {
                        var merged = lastCluster.Concat(cand)
                            .DistinctBy(p => $"{p.Latitude}_{p.Longitude}_{p.CapturedAtUtc:O}")
                            .OrderBy(p => p.CapturedAtUtc)
                            .ToList();
                        clusters[clusters.Count - 1] = merged;
                    }
                    else
                    {
                        clusters.Add(cand);
                    }
                }
            }

            foreach (var gapPoints in clusters)
            {
                var prev = gapPoints.First();
                var curr = gapPoints.Last();
                var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;
                if (gap < TimeSpan.FromMinutes(1)) gap = TimeSpan.FromMinutes(1);
                var startUtc = prev.CapturedAtUtc;
                var endUtc = curr.CapturedAtUtc;

                    double dist = 0;
                    for (int j = 1; j < gapPoints.Count; j++)
                    {
                        dist += CalculateDistance(gapPoints[j - 1].Latitude, gapPoints[j - 1].Longitude, gapPoints[j].Latitude, gapPoints[j].Longitude);
                    }

                    double startDist = (officeLat != 0) ? CalculateDistance(prev.Latitude, prev.Longitude, officeLat, officeLng) : 0;
                    double endDist = (officeLat != 0) ? CalculateDistance(curr.Latitude, curr.Longitude, officeLat, officeLng) : 0;

                    int inRadius = (officeLat != 0)
                        ? gapPoints.Count(p => CalculateDistance(p.Latitude, p.Longitude, officeLat, officeLng) <= officeRadiusMeters)
                        : gapPoints.Count;

                    var stays = DetectPeriodStays(gapPoints);

                    // Punches during gap
                    var punchesInGap = punches.Where(p => p.EmployeeID == empId &&
                                                          p.PunchTime >= startUtc.AddMinutes(-2) &&
                                                          p.PunchTime <= endUtc.AddMinutes(2)).ToList();

                    var hasAutoOut = punchesInGap.Any(p => IsOutType(p.LogType));
                    var hasPunches = punchesInGap.Any();

                    // Shift evaluation
                    bool isOffShift = false;
                    string shiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking";
                    if (isShiftMode && shiftStart.HasValue && shiftEnd.HasValue)
                    {
                        var localTime = ToLocal(startUtc);
                        var timeOnly = TimeOnly.FromDateTime(localTime);
                        bool inShift = shiftEnd >= shiftStart
                            ? (timeOnly >= shiftStart && timeOnly <= shiftEnd)
                            : (timeOnly >= shiftStart || timeOnly <= shiftEnd);
                        if (!inShift)
                        {
                            isOffShift = true;
                            shiftTag = "Off-Duty / Non-Shift Gap";
                        }
                    }

                    string impactAlertClass;
                    string impactTitle;
                    string impactIcon;
                    string impactSummary;

                    if (hasAutoOut)
                    {
                        impactAlertClass = "alert-danger border-danger-subtle";
                        impactTitle = "⚡ Auto OUT Punch Triggered";
                        impactIcon = "⚡";
                        impactSummary = $"Employee stepped outside the {officeRadiusMeters}m perimeter while offline. Shift was closed automatically on reconnect.";
                    }
                    else if (hasPunches)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🟢 Reconciled Attendance Punch";
                        impactIcon = "🟢";
                        impactSummary = $"{punchesInGap.Count} attendance punch(es) captured locally merged into cloud attendance.";
                    }
                    else if (isOffShift)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "⏸️ Off-Duty Disconnection";
                        impactIcon = "⏸️";
                        impactSummary = $"Disconnection occurred outside scheduled shift hours. No attendance penalty or tracking deduction applied.";
                    }
                    else if (inRadius == gapPoints.Count)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🛡️ Safe Inside Geofence (Zero Live Impact)";
                        impactIcon = "🛡️";
                        impactSummary = $"Employee remained safely inside {officeRadiusMeters}m office radius throughout offline window. Active IN shift preserved.";
                    }
                    else if (inRadius == 0)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "🛡️ No Attendance State Change";
                        impactIcon = "🛡️";
                        impactSummary = $"Stayed outside {officeRadiusMeters}m perimeter. Attendance remained OUT (no punch created).";
                    }
                    else
                    {
                        impactAlertClass = "alert-warning border-warning-subtle";
                        impactTitle = "⚠️ Perimeter Transition During Gap";
                        impactIcon = "⚠️";
                        impactSummary = $"Crossed geofence boundary ({inRadius} points inside, {gapPoints.Count - inRadius} points outside). Reconciled with live shift policy.";
                    }

                    string step1Loc = (officeLat != 0 && startDist <= officeRadiusMeters)
                        ? $"Inside Office Zone ({startDist:N0}m from center)"
                        : $"Outside Office Zone ({startDist:N0}m from center)";

                    var periodId = $"{empId}_{startUtc:yyyyMMddHHmmss}";

                    periods.Add(new OfflinePeriodDisplayModel
                    {
                        Id = periodId,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        StartTimeUtc = startUtc,
                        EndTimeUtc = endUtc,
                        Duration = gap,
                        Reason = "Network Disconnected / Signal Loss",
                        PointsCount = gapPoints.Count,
                        DistanceMeters = dist,
                        InRadiusCount = inRadius,
                        ShiftTag = shiftTag,
                        SyncStatus = "✓ Reconciled into Live SSOT",
                        Step1LocationDescription = step1Loc,
                        ImpactAlertClass = impactAlertClass,
                        ImpactTitle = impactTitle,
                        ImpactIcon = impactIcon,
                        LiveImpactSummary = impactSummary,
                        Stays = stays,
                        Points = gapPoints.Select(p => new OfflinePointModel
                        {
                            Latitude = p.Latitude,
                            Longitude = p.Longitude,
                            TimestampUtc = p.CapturedAtUtc,
                            IsOffline = true
                        }).ToList()
                    });

                    // Add Ledger Rows for this offline period
                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = startUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📴 Disconnected",
                        EventBadgeClass = "bg-warning text-dark",
                        Latitude = prev.Latitude,
                        Longitude = prev.Longitude,
                        DistanceFromOfficeMeters = startDist,
                        IsWithinRadius = (officeLat == 0) || (startDist <= officeRadiusMeters),
                        StateAndDwell = "Disconnected position",
                        LiveImpact = impactTitle,
                        DisconnectReason = "Signal loss",
                        PeriodId = periodId
                    });

                    foreach (var s in stays)
                    {
                        var stayDist = (officeLat != 0) ? CalculateDistance(s.Latitude, s.Longitude, officeLat, officeLng) : 0;
                        ledger.Add(new OfflineLedgerRowModel
                        {
                            TimestampUtc = s.StartUtc,
                            EmployeeId = empId,
                            EmployeeName = empName,
                            EventType = "📍 Dwell Stay",
                            EventBadgeClass = "bg-info text-dark",
                            Latitude = s.Latitude,
                            Longitude = s.Longitude,
                            DistanceFromOfficeMeters = stayDist,
                            IsWithinRadius = (officeLat == 0) || (stayDist <= officeRadiusMeters),
                            StateAndDwell = $"Stayed {FormatDuration(s.Duration)} ({s.LocationDescription})",
                            LiveImpact = impactTitle,
                            DisconnectReason = "Stationary Stop",
                            PeriodId = periodId
                        });
                    }

                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = endUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📶 Reconnected",
                        EventBadgeClass = "bg-success text-white",
                        Latitude = curr.Latitude,
                        Longitude = curr.Longitude,
                        DistanceFromOfficeMeters = endDist,
                        IsWithinRadius = (officeLat == 0) || (endDist <= officeRadiusMeters),
                        StateAndDwell = "Reconnected to Central Cloud",
                        LiveImpact = impactSummary,
                        DisconnectReason = "Connection Restored",
                        PeriodId = periodId
                    });
                }
            }

        return (periods.OrderByDescending(p => p.StartTimeUtc).ToList(),
                ledger.OrderByDescending(r => r.TimestampUtc).ToList());
    }

    private List<OfflineStayModel> DetectPeriodStays(List<EmployeeLocationHistory> points)
    {
        var stays = new List<OfflineStayModel>();
        if (points.Count < 2) return stays;

        var ordered = points.OrderBy(p => p.CapturedAtUtc).ToList();
        var cur = new List<EmployeeLocationHistory> { ordered[0] };

        for (int i = 1; i < ordered.Count; i++)
        {
            var prev = ordered[i - 1];
            var p = ordered[i];
            var d = CalculateDistance(prev.Latitude, prev.Longitude, p.Latitude, p.Longitude);
            var gap = p.CapturedAtUtc - prev.CapturedAtUtc;

            if (d <= 40 && gap <= TimeSpan.FromMinutes(15))
            {
                cur.Add(p);
            }
            else
            {
                AddStayIfValid(cur, stays);
                cur = new() { p };
            }
        }
        AddStayIfValid(cur, stays);
        return stays;
    }

    private void AddStayIfValid(List<EmployeeLocationHistory> points, List<OfflineStayModel> stays)
    {
        if (points.Count < 2) return;
        var first = points.First();
        var last = points.Last();
        var dur = last.CapturedAtUtc - first.CapturedAtUtc;

        if (dur >= TimeSpan.FromMinutes(2))
        {
            var avgLat = points.Average(p => p.Latitude);
            var avgLon = points.Average(p => p.Longitude);
            var dist = (officeLat != 0) ? (int)CalculateDistance(avgLat, avgLon, officeLat, officeLng) : 0;
            var isInside = dist <= officeRadiusMeters;

            var desc = isInside ? $"Inside Office Geofence ({dist}m from center)" : $"Outside Office Perimeter ({dist:N0}m away)";

            stays.Add(new OfflineStayModel
            {
                StartUtc = first.CapturedAtUtc,
                EndUtc = last.CapturedAtUtc,
                Duration = dur,
                Latitude = avgLat,
                Longitude = avgLon,
                IsInsideGeofence = isInside,
                LocationDescription = desc
            });
        }
    }

    public ValueTask DisposeAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        var dLat = (lat2 - lat1) * Math.PI / 180.0;
        var dLon = (lon2 - lon1) * Math.PI / 180.0;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return 6371000.0 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static DateTime IndiaToUtc(DateTime dt)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(dt, DateTimeKind.Unspecified), tz);
    }

    private static DateTime ToLocal(DateTime utc)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
    }

    private static string FormatDistance(double meters) =>
        meters >= 1000 ? $"{(meters / 1000.0):F1} km" : $"{meters:N0} m";

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private static bool IsInType(string? t) => t?.Equals("IN", StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsOutType(string? t) => t?.Equals("OUT", StringComparison.OrdinalIgnoreCase) == true;

