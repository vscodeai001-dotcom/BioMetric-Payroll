</style>

@code {
    private bool loading;
    private int liveCount = 0;
    private int staleCount = 0;
    private int offlineCount = 0;
    private string lastRefreshTime = "—";
    private string searchQuery = "";
    private string statusFilter = "ALL";
    private int selectedEmployeeId = 0;
    private string? selectedOfflinePeriodId = null;

    private double officeLat = 11.9308;
    private double officeLng = 79.7849;
    private int officeRadiusMeters = 800;
    private int totalPointsCount = 0;
    private DateTime? lastCaptureTime;

    private List<Employee> allEmployees = new();
    private List<EmployeeStatusRowModel> employeeRows = new();
    private List<OfflinePeriodDisplayModel> allOfflinePeriods = new();
    private List<OfflineLedgerRowModel> offlineLedgerRows = new();
    private List<EnterpriseEventModel> enterpriseEventLogs = new();
    private List<EmployeeGpsSession> activeSessions = new();

    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool mapRendered = false;

    private IEnumerable<EmployeeStatusRowModel> filteredEmployeeRows
    {
        get
        {
            var q = employeeRows.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                q = q.Where(e => e.EmployeeName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                 e.EmployeeId.ToString().Contains(searchQuery));
            }
            if (statusFilter == "LIVE") q = q.Where(e => e.Status == "Live");
            else if (statusFilter == "STALE") q = q.Where(e => e.Status == "Stale");
            else if (statusFilter == "OFFLINE") q = q.Where(e => e.Status == "Offline");
            else if (statusFilter == "PENDING_SYNC") q = q.Where(e => e.HasPendingSync);
            return q;
        }
    }

    private EmployeeStatusRowModel? selectedEmployeeRow =>
        employeeRows.FirstOrDefault(e => e.EmployeeId == selectedEmployeeId);

    private List<OfflinePeriodDisplayModel> displayedPeriods =>
        !string.IsNullOrEmpty(selectedOfflinePeriodId)
            ? allOfflinePeriods.Where(p => p.Id == selectedOfflinePeriodId).ToList()
            : (selectedEmployeeId > 0
                ? allOfflinePeriods.Where(p => p.EmployeeId == selectedEmployeeId).ToList()
                : allOfflinePeriods);

    private List<OfflineLedgerRowModel> displayedLedgerRows
    {
        get
        {
            var q = offlineLedgerRows.AsEnumerable();
            if (selectedEmployeeId > 0)
                q = q.Where(r => r.EmployeeId == selectedEmployeeId);
            if (!string.IsNullOrEmpty(selectedOfflinePeriodId))
                q = q.Where(r => r.PeriodId == selectedOfflinePeriodId);
            return q.OrderByDescending(r => r.TimestampUtc).ToList();
        }
    }

    private List<OfflinePointModel> selectedEmployeeHistory =>
        selectedEmployeeRow?.LocationPoints ?? new List<OfflinePointModel>();

    private List<OfflinePeriodDisplayModel> selectedEmployeePeriods =>
        allOfflinePeriods.Where(p => p.EmployeeId == selectedEmployeeId).ToList();

    private List<JourneyTimelineStepModel> journeyTimelineSteps
    {
        get
        {
            if (selectedEmployeeId <= 0 || selectedEmployeeRow == null) return new();
            return BuildJourneyTimeline(selectedEmployeeRow, selectedEmployeePeriods, selectedEmployeeHistory);
        }
    }

    private DateTime lastRefreshInvokedUtc = DateTime.MinValue;
    private static readonly TimeSpan RefreshCooldown = TimeSpan.FromSeconds(10);

    protected override async Task OnInitializedAsync()
    {
        await Refresh(force: true);
        cts = new CancellationTokenSource();
        // Bandwidth Storm Control: 60s background cadence + in-memory LiveLocationStore (0 Firebase REST egress)
        timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PeriodicLoopAsync(cts.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !mapRendered)
        {
            await RenderMapAsync();
        }
    }

    private async Task PeriodicLoopAsync(CancellationToken token)
    {
        if (timer == null) return;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await Refresh(force: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    private void SetStatusFilter(string filter) => statusFilter = filter;

    private void SelectEmployee(int empId)
    {
        selectedEmployeeId = empId;
        selectedOfflinePeriodId = null;
        _ = RenderMapAsync();
    }

    private void ClearSelectedEmployee()
    {
        selectedEmployeeId = 0;
        selectedOfflinePeriodId = null;
        _ = RenderMapAsync();
    }

    private void OnEmployeeDropdownChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var empId))
        {
            if (empId == 0) ClearSelectedEmployee();
            else SelectEmployee(empId);
        }
    }

    private void InspectPeriodOnMap(OfflinePeriodDisplayModel period)
    {
        selectedOfflinePeriodId = period.Id;
        selectedEmployeeId = period.EmployeeId;
        _ = RenderMapAsync(period);
        _ = ScrollToMap();
    }

    private void ClearSelectedOfflinePeriod()
    {
        selectedOfflinePeriodId = null;
        _ = RenderMapAsync();
    }

    private async Task ScrollToMap()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('offline-map-container-card')?.scrollIntoView({ behavior: 'smooth' });");
        }
        catch { }
    }

    private Task Refresh() => Refresh(force: false);

    private async Task Refresh(bool force)
    {
        if (loading) return;
        if (!force && (DateTime.UtcNow - lastRefreshInvokedUtc) < RefreshCooldown) return;
        loading = true;
        lastRefreshInvokedUtc = DateTime.UtcNow;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            allEmployees = await db.Employees.AsNoTracking()
                .Where(e => !e.IsDeleted)
                .OrderBy(e => e.Name)
                .ToListAsync();

            var setting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            if (setting != null)
            {
                officeLat = setting.OfficeLatitude;
                officeLng = setting.OfficeLongitude;
                officeRadiusMeters = setting.GeoRadiusMeters;
            }

            // Punches today
            var today = DateTime.Today;
            var fromUtc = IndiaToUtc(today);
            var toUtc = IndiaToUtc(today.AddDays(1));

            var todayPunches = await db.AttendanceLogs.AsNoTracking()
                .Where(p => p.PunchTime >= fromUtc && p.PunchTime <= toUtc)
                .OrderBy(p => p.PunchTime)
                .ToListAsync();

            // Active GPS Sessions
            activeSessions = await db.EmployeeGpsSessions.AsNoTracking()
                .OrderByDescending(s => s.StartedAtUtc)
                .ToListAsync();

            // SQLite Points
            var dbPoints = await db.EmployeeLocationHistory.AsNoTracking()
                .OrderByDescending(p => p.CapturedAtUtc)
                .Take(1500)
                .ToListAsync();

            totalPointsCount = dbPoints.Count;
            lastCaptureTime = dbPoints.FirstOrDefault()?.CapturedAtUtc;

            // Bandwidth Storm Control: In-Memory LiveLocationStore
            // Maintained in real-time by the persistent SSE stream & mobile GPS pings.
            // Reading it locally eliminates high-volume REST GET downloads on owners/{owner}/tracking/live.
            var inMemoryLive = LiveLocationStore.GetAll().ToDictionary(x => x.EmployeeId);

            // Build Employee Rows
            var now = DateTime.UtcNow;
            int live = 0, stale = 0, offline = 0;
            var rows = new List<EmployeeStatusRowModel>();

            foreach (var emp in allEmployees)
            {
                inMemoryLive.TryGetValue(emp.EmployeeID, out var memLoc);

                double lat = memLoc?.Latitude ?? 0;
                double lon = memLoc?.Longitude ?? 0;
                double speedMps = memLoc?.SpeedMps ?? 0;
                string movement = memLoc?.MovementState ?? "Stopped";
                DateTime lastSeenUtc = memLoc?.LastUpdatedUtc ?? DateTime.MinValue;
                bool isWithin = memLoc?.IsWithinAllowedRadius ?? true;

                if (lat != 0 && lon != 0 && officeLat != 0)
                {
                    var d = CalculateDistance(lat, lon, officeLat, officeLng);
                    isWithin = d <= officeRadiusMeters;
                }

                // If still no live coordinates, check recent db points
                var empRecentPoints = dbPoints.Where(p => p.EmployeeId == emp.EmployeeID).ToList();
                if (lat == 0 && lon == 0 && empRecentPoints.Any())
                {
                    var latest = empRecentPoints.First();
                    lat = latest.Latitude;
                    lon = latest.Longitude;
                    lastSeenUtc = latest.CapturedAtUtc;
                    isWithin = latest.IsWithinAllowedRadius;
                }

                // Calculate Age & Status
                string status = "Offline";
                long ageSec = long.MaxValue;
                if (lastSeenUtc > DateTime.MinValue)
                {
                    ageSec = (long)(now - lastSeenUtc).TotalSeconds;
                    if (ageSec <= 300) { status = "Live"; live++; }
                    else if (ageSec <= 900) { status = "Stale"; stale++; }
                    else { status = "Offline"; offline++; }
                }
                else
                {
                    offline++;
                }

                // Punches
                var empPunches = todayPunches.Where(p => p.EmployeeID == emp.EmployeeID).OrderBy(p => p.PunchTime).ToList();
                var punchIn = empPunches.FirstOrDefault(p => IsInType(p.LogType));
                var punchOut = empPunches.LastOrDefault(p => IsOutType(p.LogType));

                string punchSummary;
                string punchInDetail = "🟢 Punch In: Not recorded today";
                string punchInLocDetail = "—";
                string punchOutDetail = "🔴 Punch Out: Not on duty";
                string workHoursDetail = "Shift Duration: —";

                if (punchIn != null && punchOut != null)
                {
                    var inStr = ToLocal(punchIn.PunchTime).ToString("hh:mm tt");
                    var outStr = ToLocal(punchOut.PunchTime).ToString("hh:mm tt");
                    punchSummary = $"🔴 Punched Out: {outStr} (In: {inStr})";
                    punchInDetail = $"🟢 Punch In: {inStr} IST";
                    punchOutDetail = $"🔴 Punch Out: {outStr} IST";
                    var dur = punchOut.PunchTime - punchIn.PunchTime;
                    workHoursDetail = $"Total Shift Completed: {FormatDuration(dur)}";
                }
                else if (punchIn != null)
                {
                    var inStr = ToLocal(punchIn.PunchTime).ToString("hh:mm tt");
                    string rangeNote = "";
                    if (punchIn.Latitude.HasValue && punchIn.Longitude.HasValue && officeLat != 0)
                    {
                        var dist = CalculateDistance(punchIn.Latitude.Value, punchIn.Longitude.Value, officeLat, officeLng);
                        rangeNote = dist <= officeRadiusMeters ? " • Inside Range" : $" • Outside Range ({dist:N0}m)";
                        punchInLocDetail = $"{punchIn.Latitude.Value:F5}, {punchIn.Longitude.Value:F5} ({rangeNote.Trim(' ', '•')}) · Source: {punchIn.DeviceID ?? "Mobile"}";
                    }
                    else
                    {
                        punchInLocDetail = "Web / Biometric terminal punch";
                    }

                    punchSummary = $"🟢 Punch In: {inStr}{rangeNote}";
                    punchInDetail = $"🟢 Punch In: {inStr} IST";
                    punchOutDetail = "🔴 Punch Out: Currently Active / Working on duty";
                    var dur = now - punchIn.PunchTime;
                    workHoursDetail = $"Current Working Duration: {FormatDuration(dur)} (Active Shift)";
                }
                else
                {
                    punchSummary = "⚪ No Punch In Recorded Today";
                }

                double distToOffice = (lat != 0 && officeLat != 0) ? CalculateDistance(lat, lon, officeLat, officeLng) : 0;

                rows.Add(new EmployeeStatusRowModel
                {
                    EmployeeId = emp.EmployeeID,
                    EmployeeName = emp.Name,
                    Role = emp.Role ?? "Staff",
                    Status = status,
                    LastSeenUtc = lastSeenUtc,
                    AgeSeconds = ageSec,
                    Latitude = lat,
                    Longitude = lon,
                    SpeedKmh = speedMps * 3.6,
                    MovementState = movement,
                    IsWithinRadius = isWithin,
                    DistanceToOfficeMeters = distToOffice,
                    PunchSummary = punchSummary,
                    PunchInDetail = punchInDetail,
                    PunchInLocationDetail = punchInLocDetail,
                    PunchOutDetail = punchOutDetail,
                    WorkHoursDetail = workHoursDetail,
                    PunchInTimeUtc = punchIn?.PunchTime,
                    PunchInLat = punchIn?.Latitude,
                    PunchInLng = punchIn?.Longitude,
                    PunchOutTimeUtc = punchOut?.PunchTime,
                    PunchOutLat = punchOut?.Latitude,
                    PunchOutLng = punchOut?.Longitude,
                    HasPendingSync = false,
                    LocationPoints = empRecentPoints.Select(p => new OfflinePointModel
                    {
                        Latitude = p.Latitude,
                        Longitude = p.Longitude,
                        TimestampUtc = p.CapturedAtUtc,
                        IsOffline = p.CaptureSource?.Contains("offline", StringComparison.OrdinalIgnoreCase) == true,
                        SpeedKmh = 0
                    }).OrderBy(p => p.TimestampUtc).ToList()
                });
            }

            liveCount = live;
            staleCount = stale;
            offlineCount = offline;
            lastRefreshTime = DateTime.UtcNow.AddHours(5.5).ToString("HH:mm:ss");

            employeeRows = rows.OrderBy(r => r.Status switch { "Live" => 0, "Stale" => 1, _ => 2 })
                               .ThenBy(r => r.EmployeeName).ToList();

            // Offline Periods & Offline Ledger Detection
            (allOfflinePeriods, offlineLedgerRows) = BuildAllOfflineData(dbPoints, allEmployees, todayPunches);

            // Enterprise Events
            enterpriseEventLogs = BuildEnterpriseEventLogs(dbPoints, allOfflinePeriods);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing offline tracking data");
        }
        finally
        {
            loading = false;
        }

        await RenderMapAsync();
    }

    private async Task RenderMapAsync(OfflinePeriodDisplayModel? focusedPeriod = null)
    {
        try
        {
            var pointsForMap = new List<object>();
            object? pInObj = null;
            object? pOutObj = null;

            if (selectedEmployeeRow != null)
            {
                if (selectedEmployeeRow.PunchInLat.HasValue && selectedEmployeeRow.PunchInLng.HasValue)
                {
                    pInObj = new
                    {
                        lat = selectedEmployeeRow.PunchInLat.Value,
                        lng = selectedEmployeeRow.PunchInLng.Value,
                        time = selectedEmployeeRow.PunchInTimeUtc.HasValue ? ToLocal(selectedEmployeeRow.PunchInTimeUtc.Value).ToString("hh:mm tt") : "",
                        source = "Mobile"
                    };
                }
                if (selectedEmployeeRow.PunchOutLat.HasValue && selectedEmployeeRow.PunchOutLng.HasValue)
                {
                    pOutObj = new
                    {
                        lat = selectedEmployeeRow.PunchOutLat.Value,
                        lng = selectedEmployeeRow.PunchOutLng.Value,
                        time = selectedEmployeeRow.PunchOutTimeUtc.HasValue ? ToLocal(selectedEmployeeRow.PunchOutTimeUtc.Value).ToString("hh:mm tt") : ""
                    };
                }
            }

            if (focusedPeriod != null)
            {
                pointsForMap = focusedPeriod.Points.Select(p => (object)new { lat = p.Latitude, lng = p.Longitude, isOffline = true }).ToList();
            }
            else if (selectedEmployeeRow != null)
            {
                pointsForMap = selectedEmployeeHistory.Select(p => (object)new { lat = p.Latitude, lng = p.Longitude, isOffline = p.IsOffline }).ToList();
            }

            var liveStaff = employeeRows
                .Where(r => r.Latitude != 0 && (selectedEmployeeId == 0 || r.EmployeeId == selectedEmployeeId))
                .Select(r => new
                {
                    employeeId = r.EmployeeId,
                    name = r.EmployeeName,
                    lat = r.Latitude,
                    lng = r.Longitude,
                    speedKmh = r.SpeedKmh,
                    movement = r.MovementState,
                    status = r.Status
                }).ToList();

            var payload = new
            {
                officeLat = officeLat,
                officeLng = officeLng,
                officeRadiusMeters = officeRadiusMeters,
                punchIn = pInObj,
                punchOut = pOutObj,
                routePoints = pointsForMap,
                liveLocations = liveStaff
            };

            await JSRuntime.InvokeVoidAsync("initializeOfflineTrackingMap", "offline-tracking-map", payload);
            mapRendered = true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Leaflet map initialization notice");
        }
    }

    private (List<OfflinePeriodDisplayModel> periods, List<OfflineLedgerRowModel> ledger) BuildAllOfflineData(
        List<EmployeeLocationHistory> points,
        List<Employee> employees,
        List<AttendanceLog> punches)
    {
        var periods = new List<OfflinePeriodDisplayModel>();
        var ledger = new List<OfflineLedgerRowModel>();
        var empMap = employees.ToDictionary(e => e.EmployeeID);
        var pointsByEmp = points.GroupBy(p => p.EmployeeId).ToDictionary(g => g.Key, g => g.OrderBy(p => p.CapturedAtUtc).ToList());

        foreach (var emp in employees)
        {
            var empId = emp.EmployeeID;
            var empName = emp.Name;
            var empProfile = emp;

            var trackingMode = (empProfile?.TrackingMode ?? "24/7").Trim().ToUpperInvariant();
            var isShiftMode = trackingMode.Contains("SHIFT");
            var shiftStart = empProfile?.ShiftStartTime;
            var shiftEnd = empProfile?.ShiftEndTime;

            if (!pointsByEmp.TryGetValue(empId, out var sorted) || !sorted.Any())
            {
                continue;
            }

            // 1. Detect Gaps between consecutive points (>= 10 mins)
            for (int i = 1; i < sorted.Count; i++)
            {
                var prev = sorted[i - 1];
                var curr = sorted[i];
                var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;

                if (gap >= TimeSpan.FromMinutes(10) && gap <= TimeSpan.FromDays(2))
                {
                    var startUtc = prev.CapturedAtUtc;
                    var endUtc = curr.CapturedAtUtc;

                    var gapPoints = sorted
                        .Where(p => p.CapturedAtUtc >= startUtc && p.CapturedAtUtc <= endUtc)
                        .ToList();

                    if (gapPoints.Count < 2)
                    {
                        gapPoints = new List<EmployeeLocationHistory> { prev, curr };
                    }

                    double dist = 0;
                    for (int j = 1; j < gapPoints.Count; j++)
                    {
                        dist += CalculateDistance(gapPoints[j - 1].Latitude, gapPoints[j - 1].Longitude, gapPoints[j].Latitude, gapPoints[j].Longitude);
                    }

                    double startDist = (officeLat != 0) ? CalculateDistance(prev.Latitude, prev.Longitude, officeLat, officeLng) : 0;
                    double endDist = (officeLat != 0) ? CalculateDistance(curr.Latitude, curr.Longitude, officeLat, officeLng) : 0;

                    int inRadius = (officeLat != 0)
                        ? gapPoints.Count(p => CalculateDistance(p.Latitude, p.Longitude, officeLat, officeLng) <= officeRadiusMeters)
                        : gapPoints.Count;

                    var stays = DetectPeriodStays(gapPoints);

                    // Punches during gap
                    var punchesInGap = punches.Where(p => p.EmployeeID == empId &&
                                                          p.PunchTime >= startUtc.AddMinutes(-2) &&
                                                          p.PunchTime <= endUtc.AddMinutes(2)).ToList();

                    var hasAutoOut = punchesInGap.Any(p => IsOutType(p.LogType));
                    var hasPunches = punchesInGap.Any();

                    // Shift evaluation
                    bool isOffShift = false;
                    string shiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking";
                    if (isShiftMode && shiftStart.HasValue && shiftEnd.HasValue)
                    {
                        var localTime = ToLocal(startUtc);
                        var timeOnly = TimeOnly.FromDateTime(localTime);
                        bool inShift = shiftEnd >= shiftStart
                            ? (timeOnly >= shiftStart && timeOnly <= shiftEnd)
                            : (timeOnly >= shiftStart || timeOnly <= shiftEnd);
                        if (!inShift)
                        {
                            isOffShift = true;
                            shiftTag = "Off-Duty / Non-Shift Gap";
                        }
                    }

                    string impactAlertClass;
                    string impactTitle;
                    string impactIcon;
                    string impactSummary;

                    if (hasAutoOut)
                    {
                        impactAlertClass = "alert-danger border-danger-subtle";
                        impactTitle = "⚡ Auto OUT Punch Triggered";
                        impactIcon = "⚡";
                        impactSummary = $"Employee stepped outside the {officeRadiusMeters}m office perimeter while disconnected. Live attendance closed automatically upon reconnection.";
                    }
                    else if (hasPunches)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🟢 Reconciled Attendance Punch";
                        impactIcon = "🟢";
                        impactSummary = $"{punchesInGap.Count} attendance punch(es) captured locally merged into cloud attendance.";
                    }
                    else if (isOffShift)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "⏸️ Off-Duty Disconnection";
                        impactIcon = "⏸️";
                        impactSummary = $"Disconnection occurred outside scheduled shift hours. No attendance penalty or tracking deduction applied.";
                    }
                    else if (inRadius == gapPoints.Count)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🛡️ Safe Inside Geofence (Zero Live Impact)";
                        impactIcon = "🛡️";
                        impactSummary = $"Employee remained safely inside {officeRadiusMeters}m office radius throughout offline window. Active IN shift preserved.";
                    }
                    else if (inRadius == 0)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "🛡️ No Attendance State Change";
                        impactIcon = "🛡️";
                        impactSummary = $"Stationary / Moving Outside: Stayed outside {officeRadiusMeters}m radius • Attendance remained OUT (No punch created).";
                    }
                    else
                    {
                        impactAlertClass = "alert-warning border-warning-subtle";
                        impactTitle = "⚠️ Perimeter Transition During Gap";
                        impactIcon = "⚠️";
                        impactSummary = $"Crossed geofence boundary ({inRadius} points inside, {gapPoints.Count - inRadius} points outside). Reconciled with live shift policy.";
                    }

                    string step1Loc = (officeLat != 0 && startDist <= officeRadiusMeters)
                        ? $"Inside Office Zone ({startDist:N0}m from center)"
                        : $"Outside Office Zone ({startDist:N0}m from center)";

                    var periodId = $"{empId}_{startUtc:yyyyMMddHHmmss}";

                    periods.Add(new OfflinePeriodDisplayModel
                    {
                        Id = periodId,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        StartTimeUtc = startUtc,
                        EndTimeUtc = endUtc,
                        Duration = gap,
                        Reason = "Network Disconnected / Signal Loss",
                        PointsCount = gapPoints.Count,
                        DistanceMeters = dist,
                        InRadiusCount = inRadius,
                        ShiftTag = shiftTag,
                        SyncStatus = "✓ Reconciled into Live SSOT",
                        Step1LocationDescription = step1Loc,
                        ImpactAlertClass = impactAlertClass,
                        ImpactTitle = impactTitle,
                        ImpactIcon = impactIcon,
                        LiveImpactSummary = impactSummary,
                        Stays = stays,
                        Points = gapPoints.Select(p => new OfflinePointModel
                        {
                            Latitude = p.Latitude,
                            Longitude = p.Longitude,
                            TimestampUtc = p.CapturedAtUtc,
                            IsOffline = true
                        }).ToList()
                    });

                    // Add Ledger Rows for this offline period
                    // 1. Disconnection event
                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = startUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📴 Disconnected (Signal Lost)",
                        EventBadgeClass = "bg-warning text-dark",
                        Latitude = prev.Latitude,
                        Longitude = prev.Longitude,
                        DistanceFromOfficeMeters = startDist,
                        IsWithinRadius = (officeLat == 0) || (startDist <= officeRadiusMeters),
                        StateAndDwell = "Stationary at Disconnect Position",
                        LiveImpact = impactTitle,
                        DisconnectReason = "Network Disconnected / Signal Loss",
                        PeriodId = periodId
                    });

                    // 2. Intermediate Stays (if any)
                    foreach (var s in stays)
                    {
                        var stayDist = (officeLat != 0) ? CalculateDistance(s.Latitude, s.Longitude, officeLat, officeLng) : 0;
                        ledger.Add(new OfflineLedgerRowModel
                        {
                            TimestampUtc = s.StartUtc,
                            EmployeeId = empId,
                            EmployeeName = empName,
                            EventType = "📍 Offline Dwell / Stay",
                            EventBadgeClass = "bg-info text-dark",
                            Latitude = s.Latitude,
                            Longitude = s.Longitude,
                            DistanceFromOfficeMeters = stayDist,
                            IsWithinRadius = (officeLat == 0) || (stayDist <= officeRadiusMeters),
                            StateAndDwell = $"Stayed {FormatDuration(s.Duration)} ({s.LocationDescription})",
                            LiveImpact = impactTitle,
                            DisconnectReason = "Stationary Stop during Gap",
                            PeriodId = periodId
                        });
                    }

                    // 3. Reconciled punches in gap (if any)
                    foreach (var p in punchesInGap)
                    {
                        var isOut = IsOutType(p.LogType);
                        var pDist = (p.Latitude.HasValue && p.Longitude.HasValue && officeLat != 0) ? CalculateDistance(p.Latitude.Value, p.Longitude.Value, officeLat, officeLng) : endDist;
                        ledger.Add(new OfflineLedgerRowModel
                        {
                            TimestampUtc = p.PunchTime,
                            EmployeeId = empId,
                            EmployeeName = empName,
                            EventType = isOut ? "⚡ Auto OUT Punch Triggered" : "🟢 Punch IN Reconciled",
                            EventBadgeClass = isOut ? "bg-danger text-white" : "bg-success text-white",
                            Latitude = p.Latitude ?? curr.Latitude,
                            Longitude = p.Longitude ?? curr.Longitude,
                            DistanceFromOfficeMeters = pDist,
                            IsWithinRadius = (officeLat == 0) || (pDist <= officeRadiusMeters),
                            StateAndDwell = "Reconciled Punch Event",
                            LiveImpact = isOut ? "Shift Closed Automatically" : "Active Shift Opened",
                            DisconnectReason = "Offline Reconciled Attendance",
                            PeriodId = periodId
                        });
                    }

                    // 4. Reconnection event
                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = endUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📶 Reconnected (Sync Merged)",
                        EventBadgeClass = "bg-success text-white",
                        Latitude = curr.Latitude,
                        Longitude = curr.Longitude,
                        DistanceFromOfficeMeters = endDist,
                        IsWithinRadius = (officeLat == 0) || (endDist <= officeRadiusMeters),
                        StateAndDwell = "Reconnected to Central Cloud SSOT",
                        LiveImpact = impactSummary,
                        DisconnectReason = "Network Connection Restored",
                        PeriodId = periodId
                    });
                }
            }

            // 2. Ongoing actively offline employee (> 10 mins since latest point)
            var latest = sorted.LastOrDefault();
            if (latest != null)
            {
                var ongoingGap = DateTime.UtcNow - latest.CapturedAtUtc;
                if (ongoingGap >= TimeSpan.FromMinutes(10) && ongoingGap <= TimeSpan.FromHours(48))
                {
                    double distFromOffice = (officeLat != 0) ? CalculateDistance(latest.Latitude, latest.Longitude, officeLat, officeLng) : 0;
                    bool isInside = officeLat == 0 || distFromOffice <= officeRadiusMeters;

                    string impactAlertClass = isInside ? "alert-success border-success-subtle" : "alert-secondary border-secondary-subtle";
                    string impactTitle = isInside ? "🛡️ Active Shift Preserved Inside Geofence" : "🛡️ Outside Geofence (No Punch Created)";
                    string impactIcon = isInside ? "🛡️" : "📡";
                    string impactSummary = isInside
                        ? $"Employee was inside {officeRadiusMeters}m radius when connection was lost. Shift remains active in buffer awaiting reconnection."
                        : $"Employee is currently outside {officeRadiusMeters}m radius ({distFromOffice:N0}m away). Device is offline.";

                    var ongoingPeriodId = $"{empId}_{latest.CapturedAtUtc:yyyyMMddHHmmss}_active";

                    periods.Add(new OfflinePeriodDisplayModel
                    {
                        Id = ongoingPeriodId,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        StartTimeUtc = latest.CapturedAtUtc,
                        EndTimeUtc = DateTime.UtcNow,
                        Duration = ongoingGap,
                        Reason = "Network Disconnected / Signal Loss (Currently Offline)",
                        PointsCount = 1,
                        DistanceMeters = 0,
                        InRadiusCount = isInside ? 1 : 0,
                        ShiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking",
                        SyncStatus = "⏳ Local Queue (Pending Sync)",
                        Step1LocationDescription = isInside ? $"Inside Office Zone ({distFromOffice:N0}m from center)" : $"Outside Office Zone ({distFromOffice:N0}m away)",
                        ImpactAlertClass = impactAlertClass,
                        ImpactTitle = impactTitle,
                        ImpactIcon = impactIcon,
                        LiveImpactSummary = impactSummary,
                        Stays = new List<OfflineStayModel>(),
                        Points = new List<OfflinePointModel>
                        {
                            new() { Latitude = latest.Latitude, Longitude = latest.Longitude, TimestampUtc = latest.CapturedAtUtc, IsOffline = true }
                        }
                    });

                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = latest.CapturedAtUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📴 Disconnected (Currently Offline)",
                        EventBadgeClass = "bg-danger text-white",
                        Latitude = latest.Latitude,
                        Longitude = latest.Longitude,
                        DistanceFromOfficeMeters = distFromOffice,
                        IsWithinRadius = isInside,
                        StateAndDwell = "Device Currently Offline",
                        LiveImpact = impactSummary,
                        DisconnectReason = "Network Disconnected / Signal Loss",
                        PeriodId = ongoingPeriodId
                    });
                }
            }
        }

        return (periods.OrderByDescending(p => p.StartTimeUtc).ToList(),
                ledger.OrderByDescending(r => r.TimestampUtc).ToList());
    }

    private List<OfflineStayModel> DetectPeriodStays(List<EmployeeLocationHistory> points)
    {
        var stays = new List<OfflineStayModel>();
        if (points.Count < 2) return stays;

        var ordered = points.OrderBy(p => p.CapturedAtUtc).ToList();
        var cur = new List<EmployeeLocationHistory> { ordered[0] };

        for (int i = 1; i < ordered.Count; i++)
        {
            var prev = ordered[i - 1];
            var p = ordered[i];
            var d = CalculateDistance(prev.Latitude, prev.Longitude, p.Latitude, p.Longitude);
            var gap = p.CapturedAtUtc - prev.CapturedAtUtc;

            if (d <= 40 && gap <= TimeSpan.FromMinutes(15))
            {
                cur.Add(p);
            }
            else
            {
                AddStayIfValid(cur, stays);
                cur = new() { p };
            }
        }
        AddStayIfValid(cur, stays);
        return stays;
    }

    private void AddStayIfValid(List<EmployeeLocationHistory> points, List<OfflineStayModel> stays)
    {
        if (points.Count < 2) return;
        var first = points.First();
        var last = points.Last();
        var dur = last.CapturedAtUtc - first.CapturedAtUtc;

        if (dur >= TimeSpan.FromMinutes(2))
        {
            var avgLat = points.Average(p => p.Latitude);
            var avgLon = points.Average(p => p.Longitude);
            var dist = (officeLat != 0) ? (int)CalculateDistance(avgLat, avgLon, officeLat, officeLng) : 0;
            var isInside = dist <= officeRadiusMeters;

            var desc = isInside ? $"Inside Office Geofence ({dist}m from center)" : $"Outside Office Perimeter ({dist:N0}m from office center)";

            stays.Add(new OfflineStayModel
            {
                StartUtc = first.CapturedAtUtc,
                EndUtc = last.CapturedAtUtc,
                Duration = dur,
                Latitude = avgLat,
                Longitude = avgLon,
                IsInsideGeofence = isInside,
                LocationDescription = desc
            });
        }
    }

    private List<JourneyTimelineStepModel> BuildJourneyTimeline(
        EmployeeStatusRowModel emp,
        List<OfflinePeriodDisplayModel> periods,
        List<OfflinePointModel> history)
    {
        var steps = new List<JourneyTimelineStepModel>();

        // 1. Punch In
        if (emp.PunchInTimeUtc.HasValue)
        {
            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = emp.PunchInTimeUtc.Value,
                Icon = "🟢",
                Badge = "PUNCH IN",
                BadgeClass = "bg-success",
                Title = "Punched IN at Work",
                Description = $"{emp.PunchInLocationDetail} · Coords recorded upon clock-in",
                SyncStatus = "✓ Synced to Cloud & Web"
            });
        }

        // 2. Offline Periods & Stays
        foreach (var p in periods)
        {
            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = p.StartTimeUtc,
                Icon = "📴",
                Badge = "OFFLINE GAP",
                BadgeClass = "bg-warning text-dark",
                Title = $"Offline Disconnection: {p.Reason} [{p.ShiftTag}]",
                Description = $"Duration: {FormatDuration(p.Duration)} · {p.PointsCount} points captured offline ({FormatDistance(p.DistanceMeters)} traveled)\n{p.LiveImpactSummary}",
                SyncStatus = "✓ Reconciled & Synced to Cloud"
            });

            foreach (var s in p.Stays)
            {
                steps.Add(new JourneyTimelineStepModel
                {
                    TimeUtc = s.StartUtc,
                    Icon = "📍",
                    Badge = "STAY / STOP",
                    BadgeClass = "bg-info text-dark",
                    Title = $"Stationary Stay: {FormatDuration(s.Duration)}",
                    Description = $"{s.LocationDescription} · Coords: {s.Latitude:F5}, {s.Longitude:F5}",
                    SyncStatus = "✓ Reconciled into Live Route"
                });
            }

            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = p.EndTimeUtc,
                Icon = "🔄",
                Badge = "RECONCILED",
                BadgeClass = "bg-primary",
                Title = "Connection Restored & Reconciled",
                Description = $"Network returned at {ToLocal(p.EndTimeUtc):hh:mm tt} IST · {p.PointsCount} offline points merged into Live ledger.",
                SyncStatus = "✓ Integrated into Live Route"
            });
        }

        // 3. Route Streaming
        if (history.Any())
        {
            var firstH = history.First();
            var lastH = history.Last();
            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = firstH.TimestampUtc,
                Icon = "📍",
                Badge = "ROUTE STREAMING",
                BadgeClass = "bg-secondary",
                Title = "GPS Route Streaming Active",
                Description = $"{history.Count} points recorded ({ToLocal(firstH.TimestampUtc):hh:mm tt} → {ToLocal(lastH.TimestampUtc):hh:mm tt})",
                SyncStatus = "✓ Continuously Synced to Cloud"
            });
        }

        // 4. Punch Out
        if (emp.PunchOutTimeUtc.HasValue)
        {
            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = emp.PunchOutTimeUtc.Value,
                Icon = "🔴",
                Badge = "PUNCH OUT",
                BadgeClass = "bg-danger",
                Title = "Punched OUT from Work",
                Description = $"Shift completed · Total Duration: {emp.WorkHoursDetail}",
                SyncStatus = "✓ Synced to Cloud & Web"
            });
        }

        // 5. Live Now
        if (emp.Latitude != 0 && emp.LastSeenUtc > DateTime.MinValue)
        {
            steps.Add(new JourneyTimelineStepModel
            {
                TimeUtc = emp.LastSeenUtc,
                Icon = "🎯",
                Badge = "LIVE NOW",
                BadgeClass = "bg-success",
                Title = "Current Live Position",
                Description = $"{emp.Latitude:F5}, {emp.Longitude:F5} · Speed: {emp.SpeedKmh:F1} km/h ({emp.MovementState}) · {(emp.IsWithinRadius ? "Inside Office Range" : "Outside Office Range")}",
                SyncStatus = "📡 Streaming Live via SignalR/Firebase"
            });
        }

        return steps.OrderBy(s => s.TimeUtc).ToList();
    }

    private List<EnterpriseEventModel> BuildEnterpriseEventLogs(
        List<EmployeeLocationHistory> points,
        List<OfflinePeriodDisplayModel> periods)
    {
        var list = new List<EnterpriseEventModel>();

        foreach (var p in periods)
        {
            list.Add(new EnterpriseEventModel
            {
                Icon = "📴",
                Title = "Offline Tracking Period Completed",
                BadgeText = "OFFLINE SESSION",
                BadgeClass = "bg-warning text-dark",
                Message = $"Offline Window Completed: {FormatDuration(p.Duration)} · Reason: {p.Reason} · Window: {ToLocal(p.StartTimeUtc):hh:mm tt} – {ToLocal(p.EndTimeUtc):hh:mm tt} IST",
                Timestamp = p.EndTimeUtc,
                IsOnline = true
            });

            list.Add(new EnterpriseEventModel
            {
                Icon = "📶",
                Title = "Network Connection Restored",
                BadgeText = "ONLINE",
                BadgeClass = "bg-success",
                Message = $"Internet connectivity restored; offline period ended ({FormatDuration(p.Duration)}); queued {p.PointsCount} offline GPS breadcrumbs to cloud.",
                Timestamp = p.EndTimeUtc.AddSeconds(1),
                IsOnline = true
            });
        }

        return list.OrderByDescending(x => x.Timestamp).Take(20).ToList();
    }

