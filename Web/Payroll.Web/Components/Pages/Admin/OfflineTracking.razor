@code {
    private bool loading;
    private bool hasSearched = false;
    private DateOnly customStartDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-7));
    private DateOnly customEndDate = DateOnly.FromDateTime(DateTime.Today);
    private int selectedEmployeeId = 0;
    private string? selectedOfflinePeriodId = null;
    private string dateFilter = "TODAY";
    private bool isLedgerExpanded = false;

    private double officeLat = 11.9308;
    private double officeLng = 79.7849;
    private int officeRadiusMeters = 800;

    private List<Employee> allEmployees = new();
    private List<OfflinePeriodDisplayModel> allOfflinePeriods = new();
    private List<OfflineLedgerRowModel> offlineLedgerRows = new();

    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool mapRendered = false;

    private string selectedEmployeeName =>
        allEmployees.FirstOrDefault(e => e.EmployeeID == selectedEmployeeId)?.Name ?? $"Employee #{selectedEmployeeId}";

    private string selectedPeriodEmployeeName =>
        allOfflinePeriods.FirstOrDefault(p => p.Id == selectedOfflinePeriodId)?.EmployeeName ?? selectedEmployeeName;

    private OfflinePeriodDisplayModel? focusedPeriod =>
        !string.IsNullOrEmpty(selectedOfflinePeriodId)
            ? allOfflinePeriods.FirstOrDefault(p => p.Id == selectedOfflinePeriodId)
            : null;

    private List<OfflinePeriodDisplayModel> displayedPeriods =>
        selectedEmployeeId > 0
            ? allOfflinePeriods.Where(p => p.EmployeeId == selectedEmployeeId).ToList()
            : allOfflinePeriods;

    private List<OfflineLedgerRowModel> displayedLedgerRows
    {
        get
        {
            var q = offlineLedgerRows.AsEnumerable();
            if (selectedEmployeeId > 0)
                q = q.Where(r => r.EmployeeId == selectedEmployeeId);
            return q.OrderByDescending(r => r.TimestampUtc).ToList();
        }
    }

    // Summary KPI Computations
    private TimeSpan totalOfflineDuration =>
        TimeSpan.FromTicks(displayedPeriods.Sum(p => p.Duration.Ticks));

    private TimeSpan insideOfficeDuration
    {
        get
        {
            long ticks = 0;
            foreach (var p in displayedPeriods)
            {
                if (p.PointsCount > 0)
                {
                    double ratio = (double)p.InRadiusCount / p.PointsCount;
                    ticks += (long)(p.Duration.Ticks * ratio);
                }
                else
                {
                    ticks += p.Duration.Ticks;
                }
            }
            return TimeSpan.FromTicks(ticks);
        }
    }

    private TimeSpan outsideOfficeDuration =>
        (totalOfflineDuration - insideOfficeDuration).Ticks > 0 ? (totalOfflineDuration - insideOfficeDuration) : TimeSpan.Zero;

    private int insideOfficePercent =>
        totalOfflineDuration.TotalSeconds > 0
            ? (int)Math.Round((insideOfficeDuration.TotalSeconds / totalOfflineDuration.TotalSeconds) * 100)
            : 100;

    private int outsideOfficePercent =>
        Math.Max(0, 100 - insideOfficePercent);

    private int liveImpactCount =>
        displayedPeriods.Count(p => p.ImpactTitle.Contains("Auto OUT", StringComparison.OrdinalIgnoreCase) ||
                                    p.ImpactTitle.Contains("Reconciled Attendance", StringComparison.OrdinalIgnoreCase) ||
                                    p.ImpactTitle.Contains("Transition", StringComparison.OrdinalIgnoreCase));

    private string liveImpactSummaryText
    {
        get
        {
            var autoOuts = displayedPeriods.Count(p => p.ImpactTitle.Contains("Auto OUT", StringComparison.OrdinalIgnoreCase));
            var preserved = displayedPeriods.Count(p => p.ImpactTitle.Contains("Safe", StringComparison.OrdinalIgnoreCase) || p.ImpactTitle.Contains("Preserved", StringComparison.OrdinalIgnoreCase));
            if (autoOuts > 0) return $"{autoOuts} shift(s) closed automatically on exit";
            if (preserved > 0) return $"{preserved} shift(s) preserved inside geofence";
            return "All sessions reconciled cleanly";
        }
    }

    private string dateRangeLabel
    {
        get
        {
            var (startUtc, endUtc) = GetDateRangeUtc();
            var startLocal = ToLocal(startUtc);
            var endLocal = ToLocal(endUtc);
            return dateFilter switch
            {
                "TODAY" => startLocal.ToString("dd MMM yyyy"),
                "YESTERDAY" => startLocal.ToString("dd MMM yyyy"),
                "CUSTOM" => $"{customStartDate:dd MMM yyyy} – {customEndDate:dd MMM yyyy}",
                _ => $"{startLocal:dd MMM yyyy} – {endLocal:dd MMM yyyy}"
            };
        }
    }

    private DateTime lastRefreshInvokedUtc = DateTime.MinValue;
    private static readonly TimeSpan RefreshCooldown = TimeSpan.FromSeconds(5);

    protected override async Task OnInitializedAsync()
    {
        await LoadMetadataAsync();
        cts = new CancellationTokenSource();
        // Bandwidth Storm Control: 60s background cadence + in-memory LiveLocationStore (0 Firebase REST egress)
        timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PeriodicLoopAsync(cts.Token);
    }

    private async Task LoadMetadataAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            allEmployees = await db.Employees.AsNoTracking()
                .Where(e => !e.IsDeleted)
                .OrderBy(e => e.Name)
                .ToListAsync();

            var setting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            if (setting != null)
            {
                officeLat = setting.OfficeLatitude;
                officeLng = setting.OfficeLongitude;
                officeRadiusMeters = setting.GeoRadiusMeters;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading metadata for offline tracking");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (hasSearched && (firstRender || !mapRendered))
        {
            await RenderMapAsync();
        }
    }

    private async Task PeriodicLoopAsync(CancellationToken token)
    {
        // Periodic background egress storm disabled in Spark/Testing mode.
        // Offline tracking is historical audit data and only refreshed on user Search/Refresh button
        // or Attendance punch event.
        await Task.CompletedTask;
    }

    private async Task OnSearchClicked()
    {
        hasSearched = true;
        selectedOfflinePeriodId = null;
        mapRendered = false;
        await Refresh(force: true);
    }

    private void SetDateFilter(string filter)
    {
        if (dateFilter == filter) return;
        dateFilter = filter;
        if (hasSearched)
        {
            _ = Refresh(force: true);
        }
    }

    private void ToggleLedgerExpanded()
    {
        isLedgerExpanded = !isLedgerExpanded;
    }

    private void OnEmployeeDropdownChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var empId))
        {
            selectedEmployeeId = empId;
            selectedOfflinePeriodId = null;
            if (hasSearched)
            {
                _ = Refresh(force: true);
            }
        }
    }

    private async Task InspectPeriodOnMap(OfflinePeriodDisplayModel period)
    {
        selectedOfflinePeriodId = period.Id;
        selectedEmployeeId = period.EmployeeId;
        StateHasChanged();
        await Task.Yield();
        await RenderMapAsync(period);
        await ScrollToMap();
    }

    private async Task ClearPeriodFocus()
    {
        selectedOfflinePeriodId = null;
        StateHasChanged();
        await RenderMapAsync();
    }

    private async Task ClearEmployeeFilter()
    {
        selectedOfflinePeriodId = null;
        selectedEmployeeId = 0;
        StateHasChanged();
        if (hasSearched)
        {
            await Refresh(force: true);
        }
    }

    private async Task ClearMapFilter()
    {
        selectedOfflinePeriodId = null;
        selectedEmployeeId = 0;
        StateHasChanged();
        if (hasSearched)
        {
            await Refresh(force: true);
        }
    }

    private async Task ScrollToMap()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('offline-map-container-card')?.scrollIntoView({ behavior: 'smooth' });");
        }
        catch { }
    }

    private (DateTime fromUtc, DateTime toUtc) GetDateRangeUtc()
    {
        var today = DateTime.Today;
        DateTime startLocal;
        DateTime endLocal;

        switch (dateFilter)
        {
            case "YESTERDAY":
                startLocal = today.AddDays(-1);
                endLocal = today.AddDays(-1).AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "7DAYS":
                startLocal = today.AddDays(-6);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "MONTH":
            case "30DAYS":
                startLocal = today.AddDays(-29);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "60DAYS":
                startLocal = today.AddDays(-59);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "YEAR":
                startLocal = today.AddYears(-1);
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
            case "CUSTOM":
                startLocal = customStartDate.ToDateTime(TimeOnly.MinValue);
                endLocal = customEndDate.ToDateTime(new TimeOnly(23, 59, 59));
                break;
            case "TODAY":
            default:
                startLocal = today;
                endLocal = today.AddHours(23).AddMinutes(59).AddSeconds(59);
                break;
        }

        return (IndiaToUtc(startLocal), IndiaToUtc(endLocal));
    }

    private (DateTime fromLocal, DateTime toLocal) GetDateRangeLocal()
    {
        var (fromUtc, toUtc) = GetDateRangeUtc();
        return (ToLocal(fromUtc), ToLocal(toUtc));
    }

    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, (DateTime CachedAtUtc, List<EmployeeLocationHistory> Points)> TrackingCache = new();

    private async Task<List<EmployeeLocationHistory>> FetchFirebaseTrackingHistoryAsync(
        string ownerUid,
        int empId,
        DateTime fromUtc,
        DateTime toUtc,
        bool bypassCache = false,
        CancellationToken ct = default)
    {
        var cacheKey = $"{ownerUid}_{empId}";
        if (!bypassCache && TrackingCache.TryGetValue(cacheKey, out var entry))
        {
            if (DateTime.UtcNow - entry.CachedAtUtc < TimeSpan.FromMinutes(5))
            {
                return entry.Points.Where(p => p.CapturedAtUtc >= fromUtc && p.CapturedAtUtc <= toUtc).ToList();
            }
        }

        var candidateOwners = new List<string>();
        if (!string.IsNullOrWhiteSpace(ownerUid)) candidateOwners.Add(ownerUid.Trim());
        if (!candidateOwners.Contains("tenant_201", StringComparer.OrdinalIgnoreCase)) candidateOwners.Add("tenant_201");
        if (!candidateOwners.Contains(Payroll.Shared.Firebase.FirebaseSsotSchema.DefaultOwnerUid, StringComparer.OrdinalIgnoreCase))
            candidateOwners.Add(Payroll.Shared.Firebase.FirebaseSsotSchema.DefaultOwnerUid);

        var result = new List<EmployeeLocationHistory>();

        foreach (var owner in candidateOwners)
        {
            try
            {
                var json = await FirebaseRealtime.GetOwnerTrackingHistoryAsync(owner, empId, 5000, ct);
                if (!json.HasValue) continue;

                var root = json.Value;
                IEnumerable<JsonElement> elements = root.ValueKind switch
                {
                    JsonValueKind.Object => root.EnumerateObject().Select(p => p.Value),
                    JsonValueKind.Array => root.EnumerateArray(),
                    _ => Enumerable.Empty<JsonElement>()
                };

                foreach (var elem in elements)
                {
                    if (elem.ValueKind != JsonValueKind.Object) continue;

                    double lat = 0;
                    if (elem.TryGetProperty("Latitude", out var pLat) || elem.TryGetProperty("latitude", out pLat) || elem.TryGetProperty("lat", out pLat))
                    {
                        if (pLat.ValueKind == JsonValueKind.Number) lat = pLat.GetDouble();
                        else if (pLat.ValueKind == JsonValueKind.String && double.TryParse(pLat.GetString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedLat)) lat = parsedLat;
                    }

                    double lng = 0;
                    if (elem.TryGetProperty("Longitude", out var pLng) || elem.TryGetProperty("longitude", out pLng) || elem.TryGetProperty("lng", out pLng) || elem.TryGetProperty("lon", out pLng))
                    {
                        if (pLng.ValueKind == JsonValueKind.Number) lng = pLng.GetDouble();
                        else if (pLng.ValueKind == JsonValueKind.String && double.TryParse(pLng.GetString(), NumberStyles.Any, CultureInfo.InvariantCulture, out var parsedLng)) lng = parsedLng;
                    }

                    if (lat == 0 && lng == 0) continue;

                    DateTime capturedUtc = DateTime.MinValue;
                    if (elem.TryGetProperty("Timestamp", out var pTs) || elem.TryGetProperty("timestamp", out pTs))
                    {
                        if (pTs.ValueKind == JsonValueKind.String)
                        {
                            var str = pTs.GetString();
                            if (DateTime.TryParse(str, null, DateTimeStyles.AdjustToUniversal | DateTimeStyles.AssumeUniversal, out var parsedDt))
                            {
                                capturedUtc = parsedDt;
                            }
                        }
                        else if (pTs.ValueKind == JsonValueKind.Number && pTs.TryGetInt64(out var epochMs))
                        {
                            capturedUtc = DateTimeOffset.FromUnixTimeMilliseconds(epochMs).UtcDateTime;
                        }
                    }

                    if (capturedUtc == DateTime.MinValue) continue;

                    bool isOffline = false;
                    if (elem.TryGetProperty("IsOffline", out var pOff) && pOff.ValueKind == JsonValueKind.True) isOffline = true;
                    if (elem.TryGetProperty("isOffline", out pOff) && pOff.ValueKind == JsonValueKind.True) isOffline = true;
                    if (elem.TryGetProperty("CaptureSource", out var pSrc) && pSrc.GetString()?.Contains("offline", StringComparison.OrdinalIgnoreCase) == true) isOffline = true;
                    if (elem.TryGetProperty("Source", out pSrc) && pSrc.GetString()?.Contains("offline", StringComparison.OrdinalIgnoreCase) == true) isOffline = true;
                    if (elem.TryGetProperty("MovementState", out var pMov) && pMov.GetString()?.Contains("offline", StringComparison.OrdinalIgnoreCase) == true) isOffline = true;

                    double accuracy = 0;
                    if (elem.TryGetProperty("AccuracyMeters", out var pAcc) || elem.TryGetProperty("accuracy", out pAcc))
                    {
                        if (pAcc.ValueKind == JsonValueKind.Number) accuracy = pAcc.GetDouble();
                    }

                    double distOffice = (officeLat != 0 && officeLng != 0) ? CalculateDistance(lat, lng, officeLat, officeLng) : 0;
                    bool isWithinRadius = (officeRadiusMeters > 0) ? distOffice <= officeRadiusMeters : true;

                    result.Add(new EmployeeLocationHistory
                    {
                        EmployeeId = empId,
                        Latitude = lat,
                        Longitude = lng,
                        CapturedAtUtc = capturedUtc,
                        RecordedAtUtc = capturedUtc,
                        AccuracyMeters = accuracy,
                        DistanceFromOfficeMeters = distOffice,
                        AllowedRadiusMeters = officeRadiusMeters,
                        IsWithinAllowedRadius = isWithinRadius,
                        CaptureSource = isOffline ? "Offline" : "Live"
                    });
                }

                if (result.Count > 0)
                {
                    break;
                }
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Error reading Firebase tracking history for employee {EmpId} from owner {Owner}", empId, owner);
            }
        }

        TrackingCache[cacheKey] = (DateTime.UtcNow, result);
        return result.Where(p => p.CapturedAtUtc >= fromUtc && p.CapturedAtUtc <= toUtc).ToList();
    }

    private Task Refresh() => Refresh(force: false);

    private async Task Refresh(bool force)
    {
        if (loading) return;
        if (!hasSearched) return;
        if (!force && (DateTime.UtcNow - lastRefreshInvokedUtc) < RefreshCooldown) return;
        loading = true;
        lastRefreshInvokedUtc = DateTime.UtcNow;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (allEmployees.Count == 0)
            {
                allEmployees = await db.Employees.AsNoTracking()
                    .Where(e => !e.IsDeleted)
                    .OrderBy(e => e.Name)
                    .ToListAsync();
            }

            var setting = await db.CompanySettings.AsNoTracking().FirstOrDefaultAsync();
            if (setting != null)
            {
                officeLat = setting.OfficeLatitude;
                officeLng = setting.OfficeLongitude;
                officeRadiusMeters = setting.GeoRadiusMeters;
            }

            var (fromUtc, toUtc) = GetDateRangeUtc();
            var (fromLocal, toLocal) = GetDateRangeLocal();
            var ownerUid = FirebaseRealtime.ResolveOwnerUid();

            // Attendance Logs in local window (punches in database are stored in local time)
            var punches = await db.AttendanceLogs.AsNoTracking()
                .Where(p => p.PunchTime >= fromLocal && p.PunchTime <= toLocal)
                .OrderBy(p => p.PunchTime)
                .ToListAsync();

            var targetEmpIds = selectedEmployeeId > 0
                ? new List<int> { selectedEmployeeId }
                : allEmployees.Select(e => e.EmployeeID).ToList();

            var allCombinedPoints = new List<EmployeeLocationHistory>();

            // 1. Fetch real GPS points from Firebase RTDB (SSOT)
            foreach (var eid in targetEmpIds)
            {
                var fbPoints = await FetchFirebaseTrackingHistoryAsync(ownerUid, eid, fromUtc, toUtc, bypassCache: force);
                allCombinedPoints.AddRange(fbPoints);
            }

            // 2. Query SQLite DB points in the same date range
            var sqliteQuery = db.EmployeeLocationHistory.AsNoTracking()
                .Where(p => p.CapturedAtUtc >= fromUtc && p.CapturedAtUtc <= toUtc);
            if (selectedEmployeeId > 0)
                sqliteQuery = sqliteQuery.Where(p => p.EmployeeId == selectedEmployeeId);
            var dbPoints = await sqliteQuery.ToListAsync();

            allCombinedPoints.AddRange(dbPoints);

            // 3. Inject punches with GPS coordinates as offline tracking points (crucial for breadcrumbs during disconnection)
            foreach (var punch in punches)
            {
                if (punch.Latitude.HasValue && punch.Longitude.HasValue &&
                    punch.Latitude.Value != 0 && punch.Longitude.Value != 0 &&
                    punch.EmployeeID.HasValue)
                {
                    if (selectedEmployeeId > 0 && punch.EmployeeID.Value != selectedEmployeeId)
                        continue;

                    var punchUtc = IndiaToUtc(punch.PunchTime);
                    var distOffice = (officeLat != 0 && officeLng != 0)
                        ? CalculateDistance(punch.Latitude.Value, punch.Longitude.Value, officeLat, officeLng)
                        : 0;

                    bool isWithinRadius = (officeRadiusMeters > 0) ? distOffice <= officeRadiusMeters : true;

                    allCombinedPoints.Add(new EmployeeLocationHistory
                    {
                        EmployeeId = punch.EmployeeID.Value,
                        Latitude = punch.Latitude.Value,
                        Longitude = punch.Longitude.Value,
                        CapturedAtUtc = punchUtc,
                        RecordedAtUtc = punchUtc,
                        AccuracyMeters = 10,
                        DistanceFromOfficeMeters = distOffice,
                        AllowedRadiusMeters = officeRadiusMeters,
                        IsWithinAllowedRadius = isWithinRadius,
                        CaptureSource = "OfflinePunch"
                    });
                }
            }

            // 4. Deduplicate points
            var distinctPoints = allCombinedPoints
                .GroupBy(p => $"{p.EmployeeId}_{p.Latitude:F5}_{p.Longitude:F5}_{p.CapturedAtUtc:yyyyMMddHHmmss}")
                .Select(g => g.First())
                .OrderBy(p => p.CapturedAtUtc)
                .ToList();

            // 5. Build all offline periods and ledger
            (allOfflinePeriods, offlineLedgerRows) = BuildAllOfflineData(distinctPoints, allEmployees, punches);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing offline tracking data");
        }
        finally
        {
            loading = false;
        }

        await RenderMapAsync();
    }

    private async Task RenderMapAsync(OfflinePeriodDisplayModel? targetPeriod = null)
    {
        try
        {
            var focused = targetPeriod ?? focusedPeriod;
            var pointsForMap = new List<object>();
            var staysForMap = new List<object>();

            if (focused != null)
            {
                var validPts = focused.Points.Where(p => p.Latitude != 0 && p.Longitude != 0).ToList();
                pointsForMap = validPts.Select((p, idx) => (object)new
                {
                    lat = p.Latitude,
                    lng = p.Longitude,
                    timestamp = ToLocal(p.TimestampUtc).ToString("hh:mm tt"),
                    index = idx + 1,
                    isOffline = true
                }).ToList();

                staysForMap = focused.Stays.Where(s => s.Latitude != 0 && s.Longitude != 0).Select(s => (object)new
                {
                    lat = s.Latitude,
                    lng = s.Longitude,
                    duration = FormatDuration(s.Duration),
                    description = s.LocationDescription,
                    startTime = ToLocal(s.StartUtc).ToString("hh:mm tt"),
                    endTime = ToLocal(s.EndUtc).ToString("hh:mm tt")
                }).ToList();
            }
            else
            {
                var periodsToMap = selectedEmployeeId > 0
                    ? allOfflinePeriods.Where(p => p.EmployeeId == selectedEmployeeId).ToList()
                    : allOfflinePeriods;

                foreach (var p in periodsToMap)
                {
                    var validPts = p.Points.Where(pt => pt.Latitude != 0 && pt.Longitude != 0).ToList();
                    pointsForMap.AddRange(validPts.Select((pt, idx) => (object)new
                    {
                        lat = pt.Latitude,
                        lng = pt.Longitude,
                        timestamp = ToLocal(pt.TimestampUtc).ToString("hh:mm tt"),
                        index = idx + 1,
                        isOffline = true
                    }));
                    staysForMap.AddRange(p.Stays.Where(s => s.Latitude != 0 && s.Longitude != 0).Select(s => (object)new
                    {
                        lat = s.Latitude,
                        lng = s.Longitude,
                        duration = FormatDuration(s.Duration),
                        description = s.LocationDescription,
                        startTime = ToLocal(s.StartUtc).ToString("hh:mm tt"),
                        endTime = ToLocal(s.EndUtc).ToString("hh:mm tt")
                    }));
                }
            }

            var payload = new
            {
                officeLat = officeLat,
                officeLng = officeLng,
                officeRadiusMeters = officeRadiusMeters,
                routePoints = pointsForMap,
                stays = staysForMap,
                isFocused = focused != null,
                employeeName = focused?.EmployeeName ?? (selectedEmployeeId > 0 ? selectedEmployeeName : "All Employees"),
                startTime = focused != null ? ToLocal(focused.StartTimeUtc).ToString("hh:mm tt") : null,
                endTime = focused != null ? ToLocal(focused.EndTimeUtc).ToString("hh:mm tt") : null,
                duration = focused != null ? FormatDuration(focused.Duration) : null,
                distance = focused != null ? FormatDistance(focused.DistanceMeters) : null
            };

            await JSRuntime.InvokeVoidAsync("initializeOfflineTrackingMap", "offline-tracking-map", payload);
            mapRendered = true;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Leaflet map initialization notice");
        }
    }

    private (List<OfflinePeriodDisplayModel> periods, List<OfflineLedgerRowModel> ledger) BuildAllOfflineData(
        List<EmployeeLocationHistory> points,
        List<Employee> employees,
        List<AttendanceLog> punches)
    {
        var periods = new List<OfflinePeriodDisplayModel>();
        var ledger = new List<OfflineLedgerRowModel>();
        var pointsByEmp = points.GroupBy(p => p.EmployeeId).ToDictionary(g => g.Key, g => g.OrderBy(p => p.CapturedAtUtc).ToList());

        foreach (var emp in employees)
        {
            var empId = emp.EmployeeID;
            var empName = emp.Name;
            var trackingMode = (emp.TrackingMode ?? "24/7").Trim().ToUpperInvariant();
            var isShiftMode = trackingMode.Contains("SHIFT");
            var shiftStart = emp.ShiftStartTime;
            var shiftEnd = emp.ShiftEndTime;

            if (!pointsByEmp.TryGetValue(empId, out var sorted) || !sorted.Any())
            {
                continue;
            }

            // 1. Contiguous runs of explicit offline points (CaptureSource containing "Offline")
            var rawClusters = new List<List<EmployeeLocationHistory>>();
            var currentOfflineRun = new List<EmployeeLocationHistory>();

            for (int i = 0; i < sorted.Count; i++)
            {
                var pt = sorted[i];
                bool isOffline = pt.CaptureSource?.Contains("Offline", StringComparison.OrdinalIgnoreCase) == true;

                if (isOffline)
                {
                    if (currentOfflineRun.Count == 0)
                    {
                        if (i > 0 && (pt.CapturedAtUtc - sorted[i - 1].CapturedAtUtc) <= TimeSpan.FromMinutes(15))
                        {
                            currentOfflineRun.Add(sorted[i - 1]);
                        }
                        currentOfflineRun.Add(pt);
                    }
                    else
                    {
                        var prevPt = currentOfflineRun.Last();
                        if (pt.CapturedAtUtc - prevPt.CapturedAtUtc <= TimeSpan.FromMinutes(20))
                        {
                            currentOfflineRun.Add(pt);
                        }
                        else
                        {
                            if (currentOfflineRun.Count >= 2)
                            {
                                rawClusters.Add(currentOfflineRun);
                            }
                            currentOfflineRun = new List<EmployeeLocationHistory>();
                            if (i > 0 && (pt.CapturedAtUtc - sorted[i - 1].CapturedAtUtc) <= TimeSpan.FromMinutes(15))
                            {
                                currentOfflineRun.Add(sorted[i - 1]);
                            }
                            currentOfflineRun.Add(pt);
                        }
                    }
                }
                else
                {
                    if (currentOfflineRun.Count > 0)
                    {
                        currentOfflineRun.Add(pt);
                        if (currentOfflineRun.Count >= 2)
                        {
                            rawClusters.Add(currentOfflineRun);
                        }
                        currentOfflineRun = new List<EmployeeLocationHistory>();
                    }
                }
            }
            if (currentOfflineRun.Count >= 2)
            {
                rawClusters.Add(currentOfflineRun);
            }

            // 2. Detect Gaps between consecutive points (>= 5 mins and <= 2 days)
            for (int i = 1; i < sorted.Count; i++)
            {
                var prev = sorted[i - 1];
                var curr = sorted[i];
                var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;

                if (gap >= TimeSpan.FromMinutes(5) && gap <= TimeSpan.FromDays(2))
                {
                    var startUtc = prev.CapturedAtUtc;
                    var endUtc = curr.CapturedAtUtc;

                    var gapPoints = sorted
                        .Where(p => p.CapturedAtUtc >= startUtc && p.CapturedAtUtc <= endUtc)
                        .ToList();

                    if (gapPoints.Count < 2)
                    {
                        gapPoints = new List<EmployeeLocationHistory> { prev, curr };
                    }
                    rawClusters.Add(gapPoints);
                }
            }

            // 2b. Explicit Offline Auto Geofence Punch Sessions (anchored by mobile device punches)
            var empOfflinePunches = punches
                .Where(p => p.EmployeeID == empId &&
                            p.Latitude.HasValue && p.Longitude.HasValue &&
                            p.Latitude.Value != 0 && p.Longitude.Value != 0 &&
                            (p.DeviceID?.Contains("Auto", StringComparison.OrdinalIgnoreCase) == true ||
                             p.BiometricID?.Contains("AUTO", StringComparison.OrdinalIgnoreCase) == true ||
                             p.LogType?.Contains("Auto", StringComparison.OrdinalIgnoreCase) == true ||
                             string.Equals(p.DeviceID, "AndroidGeofenceAuto", StringComparison.OrdinalIgnoreCase)))
                .OrderBy(p => p.PunchTime)
                .ToList();

            if (empOfflinePunches.Count > 0)
            {
                var punchGroups = new List<List<AttendanceLog>>();
                var currentGroup = new List<AttendanceLog>();

                foreach (var p in empOfflinePunches)
                {
                    if (currentGroup.Count == 0)
                    {
                        currentGroup.Add(p);
                    }
                    else
                    {
                        var prevPunch = currentGroup.Last();
                        if ((p.PunchTime - prevPunch.PunchTime) <= TimeSpan.FromMinutes(35))
                        {
                            currentGroup.Add(p);
                        }
                        else
                        {
                            punchGroups.Add(currentGroup);
                            currentGroup = new List<AttendanceLog> { p };
                        }
                    }
                }
                if (currentGroup.Count > 0)
                {
                    punchGroups.Add(currentGroup);
                }

                foreach (var group in punchGroups)
                {
                    var firstP = group.First();
                    var lastP = group.Last();
                    var firstUtc = IndiaToUtc(firstP.PunchTime);
                    var lastUtc = IndiaToUtc(lastP.PunchTime);

                    if (group.Count >= 2)
                    {
                        // Multi-punch offline session (e.g. Prakash 15:28 to 15:48)
                        var sessionPoints = sorted
                            .Where(pt => pt.CapturedAtUtc >= firstUtc.AddMinutes(-2) && pt.CapturedAtUtc <= lastUtc.AddMinutes(2))
                            .OrderBy(pt => pt.CapturedAtUtc)
                            .ToList();

                        if (sessionPoints.Count < 2)
                        {
                            sessionPoints = group.Select(gp => {
                                var utc = IndiaToUtc(gp.PunchTime);
                                return new EmployeeLocationHistory
                                {
                                    EmployeeId = empId,
                                    Latitude = gp.Latitude!.Value,
                                    Longitude = gp.Longitude!.Value,
                                    CapturedAtUtc = utc,
                                    RecordedAtUtc = utc,
                                    AccuracyMeters = 10,
                                    DistanceFromOfficeMeters = (officeLat != 0) ? CalculateDistance(gp.Latitude.Value, gp.Longitude.Value, officeLat, officeLng) : 0,
                                    AllowedRadiusMeters = officeRadiusMeters,
                                    IsWithinAllowedRadius = (officeRadiusMeters > 0) && CalculateDistance(gp.Latitude.Value, gp.Longitude.Value, officeLat, officeLng) <= officeRadiusMeters,
                                    CaptureSource = "OfflinePunch"
                                };
                            }).ToList();
                        }
                        rawClusters.Add(sessionPoints);
                    }
                    else
                    {
                        // Single isolated offline punch (e.g. Nevetha 16:25) -> session from punch - 5 mins to punch + 15 mins (16:20 to 16:40)
                        var p = group[0];
                        var punchUtc = IndiaToUtc(p.PunchTime);
                        var sUtc = punchUtc.AddMinutes(-5);
                        var eUtc = punchUtc.AddMinutes(15);

                        var pStart = new EmployeeLocationHistory
                        {
                            EmployeeId = empId,
                            Latitude = p.Latitude!.Value,
                            Longitude = p.Longitude!.Value,
                            CapturedAtUtc = sUtc,
                            RecordedAtUtc = sUtc,
                            AccuracyMeters = 10,
                            DistanceFromOfficeMeters = (officeLat != 0) ? CalculateDistance(p.Latitude.Value, p.Longitude.Value, officeLat, officeLng) : 0,
                            AllowedRadiusMeters = officeRadiusMeters,
                            IsWithinAllowedRadius = (officeRadiusMeters > 0) && CalculateDistance(p.Latitude.Value, p.Longitude.Value, officeLat, officeLng) <= officeRadiusMeters,
                            CaptureSource = "OfflinePunch"
                        };

                        var pEnd = new EmployeeLocationHistory
                        {
                            EmployeeId = empId,
                            Latitude = p.Latitude!.Value,
                            Longitude = p.Longitude!.Value,
                            CapturedAtUtc = eUtc,
                            RecordedAtUtc = eUtc,
                            AccuracyMeters = 10,
                            DistanceFromOfficeMeters = pStart.DistanceFromOfficeMeters,
                            AllowedRadiusMeters = officeRadiusMeters,
                            IsWithinAllowedRadius = pStart.IsWithinAllowedRadius,
                            CaptureSource = "OfflinePunch"
                        };

                        rawClusters.Add(new List<EmployeeLocationHistory> { pStart, pEnd });
                    }
                }
            }

            // 3. Sort & Merge overlapping or contiguous clusters
            var sortedClusters = rawClusters
                .Select(c => c.DistinctBy(p => $"{p.Latitude}_{p.Longitude}_{p.CapturedAtUtc:O}").OrderBy(p => p.CapturedAtUtc).ToList())
                .Where(c => c.Count >= 2)
                .OrderBy(c => c.First().CapturedAtUtc)
                .ToList();

            var clusters = new List<List<EmployeeLocationHistory>>();
            foreach (var cand in sortedClusters)
            {
                if (clusters.Count == 0)
                {
                    clusters.Add(cand);
                }
                else
                {
                    var lastCluster = clusters.Last();
                    var lastEnd = lastCluster.Last().CapturedAtUtc;
                    var candStart = cand.First().CapturedAtUtc;

                    bool hasOnlineBetween = sorted.Any(pt =>
                        pt.CapturedAtUtc > lastEnd &&
                        pt.CapturedAtUtc < candStart &&
                        pt.CaptureSource?.Contains("Offline", StringComparison.OrdinalIgnoreCase) != true);

                    if (candStart <= lastEnd.AddMinutes(5) && !hasOnlineBetween)
                    {
                        var merged = lastCluster.Concat(cand)
                            .DistinctBy(p => $"{p.Latitude}_{p.Longitude}_{p.CapturedAtUtc:O}")
                            .OrderBy(p => p.CapturedAtUtc)
                            .ToList();
                        clusters[clusters.Count - 1] = merged;
                    }
                    else
                    {
                        clusters.Add(cand);
                    }
                }
            }

            foreach (var gapPoints in clusters)
            {
                var prev = gapPoints.First();
                var curr = gapPoints.Last();
                var gap = curr.CapturedAtUtc - prev.CapturedAtUtc;
                if (gap < TimeSpan.FromMinutes(1)) gap = TimeSpan.FromMinutes(1);
                var startUtc = prev.CapturedAtUtc;
                var endUtc = curr.CapturedAtUtc;

                    double dist = 0;
                    for (int j = 1; j < gapPoints.Count; j++)
                    {
                        dist += CalculateDistance(gapPoints[j - 1].Latitude, gapPoints[j - 1].Longitude, gapPoints[j].Latitude, gapPoints[j].Longitude);
                    }

                    double startDist = (officeLat != 0) ? CalculateDistance(prev.Latitude, prev.Longitude, officeLat, officeLng) : 0;
                    double endDist = (officeLat != 0) ? CalculateDistance(curr.Latitude, curr.Longitude, officeLat, officeLng) : 0;

                    int inRadius = (officeLat != 0)
                        ? gapPoints.Count(p => CalculateDistance(p.Latitude, p.Longitude, officeLat, officeLng) <= officeRadiusMeters)
                        : gapPoints.Count;

                    var stays = DetectPeriodStays(gapPoints);

                    // Punches during gap (converted to UTC for accurate timestamp comparison)
                    var punchesInGap = punches.Where(p => p.EmployeeID == empId &&
                                                          IndiaToUtc(p.PunchTime) >= startUtc.AddMinutes(-3) &&
                                                          IndiaToUtc(p.PunchTime) <= endUtc.AddMinutes(3)).ToList();

                    var hasAutoOut = punchesInGap.Any(p => IsOutType(p.LogType));
                    var hasPunches = punchesInGap.Any();

                    // Shift evaluation
                    bool isOffShift = false;
                    string shiftTag = isShiftMode ? "Active Shift Disconnection" : "24/7 Active Tracking";
                    if (isShiftMode && shiftStart.HasValue && shiftEnd.HasValue)
                    {
                        var localTime = ToLocal(startUtc);
                        var timeOnly = TimeOnly.FromDateTime(localTime);
                        bool inShift = shiftEnd >= shiftStart
                            ? (timeOnly >= shiftStart && timeOnly <= shiftEnd)
                            : (timeOnly >= shiftStart || timeOnly <= shiftEnd);
                        if (!inShift)
                        {
                            isOffShift = true;
                            shiftTag = "Off-Duty / Non-Shift Gap";
                        }
                    }

                    string impactAlertClass;
                    string impactTitle;
                    string impactIcon;
                    string impactSummary;

                    if (hasAutoOut)
                    {
                        impactAlertClass = "alert-danger border-danger-subtle";
                        impactTitle = "⚡ Auto OUT Punch Triggered";
                        impactIcon = "⚡";
                        impactSummary = $"Employee stepped outside the {officeRadiusMeters}m perimeter while offline. Shift was closed automatically on reconnect.";
                    }
                    else if (hasPunches)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🟢 Reconciled Attendance Punch";
                        impactIcon = "🟢";
                        impactSummary = $"{punchesInGap.Count} attendance punch(es) captured locally merged into cloud attendance.";
                    }
                    else if (isOffShift)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "⏸️ Off-Duty Disconnection";
                        impactIcon = "⏸️";
                        impactSummary = $"Disconnection occurred outside scheduled shift hours. No attendance penalty or tracking deduction applied.";
                    }
                    else if (inRadius == gapPoints.Count)
                    {
                        impactAlertClass = "alert-success border-success-subtle";
                        impactTitle = "🛡️ Safe Inside Geofence (Zero Live Impact)";
                        impactIcon = "🛡️";
                        impactSummary = $"Employee remained safely inside {officeRadiusMeters}m office radius throughout offline window. Active IN shift preserved.";
                    }
                    else if (inRadius == 0)
                    {
                        impactAlertClass = "alert-secondary border-secondary-subtle";
                        impactTitle = "🛡️ No Attendance State Change";
                        impactIcon = "🛡️";
                        impactSummary = $"Stayed outside {officeRadiusMeters}m perimeter. Attendance remained OUT (no punch created).";
                    }
                    else
                    {
                        impactAlertClass = "alert-warning border-warning-subtle";
                        impactTitle = "⚠️ Perimeter Transition During Gap";
                        impactIcon = "⚠️";
                        impactSummary = $"Crossed geofence boundary ({inRadius} points inside, {gapPoints.Count - inRadius} points outside). Reconciled with live shift policy.";
                    }

                    string step1Loc = (officeLat != 0 && startDist <= officeRadiusMeters)
                        ? $"Inside Office Zone ({startDist:N0}m from center)"
                        : $"Outside Office Zone ({startDist:N0}m from center)";

                    var periodId = $"{empId}_{startUtc:yyyyMMddHHmmss}";

                    periods.Add(new OfflinePeriodDisplayModel
                    {
                        Id = periodId,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        StartTimeUtc = startUtc,
                        EndTimeUtc = endUtc,
                        Duration = gap,
                        Reason = "Network Disconnected / Signal Loss",
                        PointsCount = gapPoints.Count,
                        DistanceMeters = dist,
                        InRadiusCount = inRadius,
                        ShiftTag = shiftTag,
                        SyncStatus = "✓ Reconciled into Live SSOT",
                        Step1LocationDescription = step1Loc,
                        ImpactAlertClass = impactAlertClass,
                        ImpactTitle = impactTitle,
                        ImpactIcon = impactIcon,
                        LiveImpactSummary = impactSummary,
                        Stays = stays,
                        Points = gapPoints.Select(p => new OfflinePointModel
                        {
                            Latitude = p.Latitude,
                            Longitude = p.Longitude,
                            TimestampUtc = p.CapturedAtUtc,
                            IsOffline = true
                        }).ToList()
                    });

                    // Add Ledger Rows for this offline period
                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = startUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📴 Disconnected",
                        EventBadgeClass = "bg-warning text-dark",
                        Latitude = prev.Latitude,
                        Longitude = prev.Longitude,
                        DistanceFromOfficeMeters = startDist,
                        IsWithinRadius = (officeLat == 0) || (startDist <= officeRadiusMeters),
                        StateAndDwell = "Disconnected position",
                        LiveImpact = impactTitle,
                        DisconnectReason = "Signal loss",
                        PeriodId = periodId
                    });

                    foreach (var s in stays)
                    {
                        var stayDist = (officeLat != 0) ? CalculateDistance(s.Latitude, s.Longitude, officeLat, officeLng) : 0;
                        ledger.Add(new OfflineLedgerRowModel
                        {
                            TimestampUtc = s.StartUtc,
                            EmployeeId = empId,
                            EmployeeName = empName,
                            EventType = "📍 Dwell Stay",
                            EventBadgeClass = "bg-info text-dark",
                            Latitude = s.Latitude,
                            Longitude = s.Longitude,
                            DistanceFromOfficeMeters = stayDist,
                            IsWithinRadius = (officeLat == 0) || (stayDist <= officeRadiusMeters),
                            StateAndDwell = $"Stayed {FormatDuration(s.Duration)} ({s.LocationDescription})",
                            LiveImpact = impactTitle,
                            DisconnectReason = "Stationary Stop",
                            PeriodId = periodId
                        });
                    }

                    ledger.Add(new OfflineLedgerRowModel
                    {
                        TimestampUtc = endUtc,
                        EmployeeId = empId,
                        EmployeeName = empName,
                        EventType = "📶 Reconnected",
                        EventBadgeClass = "bg-success text-white",
                        Latitude = curr.Latitude,
                        Longitude = curr.Longitude,
                        DistanceFromOfficeMeters = endDist,
                        IsWithinRadius = (officeLat == 0) || (endDist <= officeRadiusMeters),
                        StateAndDwell = "Reconnected to Central Cloud",
                        LiveImpact = impactSummary,
                        DisconnectReason = "Connection Restored",
                        PeriodId = periodId
                    });
                }
            }

        return (periods.OrderByDescending(p => p.StartTimeUtc).ToList(),
                ledger.OrderByDescending(r => r.TimestampUtc).ToList());
    }

    private List<OfflineStayModel> DetectPeriodStays(List<EmployeeLocationHistory> points)
    {
        var stays = new List<OfflineStayModel>();
        if (points.Count < 2) return stays;

        var ordered = points.OrderBy(p => p.CapturedAtUtc).ToList();
        var cur = new List<EmployeeLocationHistory> { ordered[0] };

        for (int i = 1; i < ordered.Count; i++)
        {
            var prev = ordered[i - 1];
            var p = ordered[i];
            var d = CalculateDistance(prev.Latitude, prev.Longitude, p.Latitude, p.Longitude);
            var gap = p.CapturedAtUtc - prev.CapturedAtUtc;

            if (d <= 40 && gap <= TimeSpan.FromMinutes(15))
            {
                cur.Add(p);
            }
            else
            {
                AddStayIfValid(cur, stays);
                cur = new() { p };
            }
        }
        AddStayIfValid(cur, stays);
        return stays;
    }

    private void AddStayIfValid(List<EmployeeLocationHistory> points, List<OfflineStayModel> stays)
    {
        if (points.Count < 2) return;
        var first = points.First();
        var last = points.Last();
        var dur = last.CapturedAtUtc - first.CapturedAtUtc;

        if (dur >= TimeSpan.FromMinutes(2))
        {
            var avgLat = points.Average(p => p.Latitude);
            var avgLon = points.Average(p => p.Longitude);
            var dist = (officeLat != 0) ? (int)CalculateDistance(avgLat, avgLon, officeLat, officeLng) : 0;
            var isInside = dist <= officeRadiusMeters;

            var desc = isInside ? $"Inside Office Geofence ({dist}m from center)" : $"Outside Office Perimeter ({dist:N0}m away)";

            stays.Add(new OfflineStayModel
            {
                StartUtc = first.CapturedAtUtc,
                EndUtc = last.CapturedAtUtc,
                Duration = dur,
                Latitude = avgLat,
                Longitude = avgLon,
                IsInsideGeofence = isInside,
                LocationDescription = desc
            });
        }
    }

    public ValueTask DisposeAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        var dLat = (lat2 - lat1) * Math.PI / 180.0;
        var dLon = (lon2 - lon1) * Math.PI / 180.0;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return 6371000.0 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static DateTime IndiaToUtc(DateTime dt)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(dt, DateTimeKind.Unspecified), tz);
    }

    private static DateTime ToLocal(DateTime utc)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
    }

    private static string FormatDistance(double meters) =>
        meters >= 1000 ? $"{(meters / 1000.0):F1} km" : $"{meters:N0} m";

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private static bool IsInType(string? t) => t?.Equals("IN", StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsOutType(string? t) => t?.Equals("OUT", StringComparison.OrdinalIgnoreCase) == true;

