    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();
        return ValueTask.CompletedTask;
    }

    private static double CalculateDistance(double lat1, double lon1, double lat2, double lon2)
    {
        var dLat = (lat2 - lat1) * Math.PI / 180.0;
        var dLon = (lon2 - lon1) * Math.PI / 180.0;
        var a = Math.Sin(dLat / 2) * Math.Sin(dLat / 2) +
                Math.Cos(lat1 * Math.PI / 180.0) * Math.Cos(lat2 * Math.PI / 180.0) *
                Math.Sin(dLon / 2) * Math.Sin(dLon / 2);
        return 6371000.0 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1 - a));
    }

    private static DateTime IndiaToUtc(DateTime dt)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeToUtc(DateTime.SpecifyKind(dt, DateTimeKind.Unspecified), tz);
    }

    private static DateTime ToLocal(DateTime utc)
    {
        var tz = TimeZoneInfo.FindSystemTimeZoneById(OperatingSystem.IsWindows() ? "India Standard Time" : "Asia/Kolkata");
        return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
    }

    private static string FormatDistance(double meters) =>
        meters >= 1000 ? $"{(meters / 1000.0):F1} km" : $"{meters:N0} m";

    private static string FormatDuration(TimeSpan ts)
    {
        if (ts.TotalHours >= 1) return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        if (ts.TotalMinutes >= 1) return $"{ts.Minutes}m {ts.Seconds}s";
        return $"{ts.Seconds}s";
    }

    private static bool IsInType(string? t) => t?.Equals("IN", StringComparison.OrdinalIgnoreCase) == true;
    private static bool IsOutType(string? t) => t?.Equals("OUT", StringComparison.OrdinalIgnoreCase) == true;

    public sealed class EmployeeStatusRowModel
    {
        public int EmployeeId { get; set; }
        public string EmployeeName { get; set; } = "";
        public string Role { get; set; } = "Staff";
        public string Status { get; set; } = "Offline";
        public DateTime LastSeenUtc { get; set; }
        public long AgeSeconds { get; set; }
        public double Latitude { get; set; }
        public double Longitude { get; set; }
        public double SpeedKmh { get; set; }
        public string MovementState { get; set; } = "Stopped";
        public bool IsWithinRadius { get; set; }
        public double DistanceToOfficeMeters { get; set; }
        public string PunchSummary { get; set; } = "";
        public string PunchInDetail { get; set; } = "";
        public string PunchInLocationDetail { get; set; } = "";
        public string PunchOutDetail { get; set; } = "";
        public string WorkHoursDetail { get; set; } = "";
        public DateTime? PunchInTimeUtc { get; set; }
        public double? PunchInLat { get; set; }
        public double? PunchInLng { get; set; }
        public DateTime? PunchOutTimeUtc { get; set; }
        public double? PunchOutLat { get; set; }
        public double? PunchOutLng { get; set; }
        public bool HasPendingSync { get; set; }
        public List<OfflinePointModel> LocationPoints { get; set; } = new();

        public string StatusBadgeClass => Status switch
        {
            "Live" => "bg-success",
            "Stale" => "bg-warning text-dark",
            _ => "bg-danger"
        };

        public string SyncBadgeText => HasPendingSync ? "⏳ Pending Sync" : (Status == "Live" ? "📡 Live Stream" : "✓ Synced");
        public string SyncBadgeClass => HasPendingSync ? "bg-warning text-dark" : (Status == "Live" ? "bg-primary" : "bg-success-subtle text-success");

        public string LastSeenStr => LastSeenUtc > DateTime.MinValue ? ToLocal(LastSeenUtc).ToString("dd-MMM HH:mm:ss") : "Never";
        public string AgeStr
        {
            get
            {
                if (AgeSeconds == long.MaxValue || AgeSeconds < 0) return "Offline";
                if (AgeSeconds < 60) return $"{AgeSeconds}s ago";
                if (AgeSeconds < 3600) return $"{AgeSeconds / 60}m ago";
                return $"{AgeSeconds / 3600}h {(AgeSeconds % 3600) / 60}m ago";
