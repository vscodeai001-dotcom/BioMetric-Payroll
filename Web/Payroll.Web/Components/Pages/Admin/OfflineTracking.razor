@page "/admin/offline-tracking"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Firebase
@using global::Payroll.Web.Services
@implements IAsyncDisposable
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IJSRuntime JSRuntime
@inject ILogger<OfflineTracking> Logger
@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>GPS Connection &amp; Offline Tracking Hub</PageTitle>

<AttendanceRefreshListener OnAttendanceChanged="Refresh" OnLocationChanged="Refresh" />

<div class="container-fluid py-3 offline-tracking-page">
    <!-- Top Status Banner -->
    <div class="card border-0 shadow-sm mb-3 top-status-card">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="live-pulse-dot"></span>
                        <h5 class="fw-bold mb-0 text-dark">
                            ONLINE • Server reachable &amp; synchronized (SSOT Realtime / Spark Mode)
                        </h5>
                    </div>
                    <small class="text-muted">
                        Realtime connection health, background sync ledger and offline disconnection intervals.
                    </small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="/admin/offline-tracking-details" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Full Audit Details
                    </a>
                    <button class="btn btn-sm btn-primary" @onclick="() => Refresh(force: true)" disabled="@loading">
                        <i class="bi bi-arrow-clockwise @(loading ? "spin" : "") me-1"></i>@(loading ? "Synchronizing..." : "Refresh")
                    </button>
                </div>
            </div>

            <!-- 4 Metric Cards -->
            <div class="row g-2 mt-2">
                <div class="col-6 col-md-3">
                    <div class="metric-pill metric-pill-live">
                        <div class="small fw-semibold text-success">Live (&lt;5m)</div>
                        <div class="fs-4 fw-bold text-success">@liveCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-pill metric-pill-stale">
                        <div class="small fw-semibold text-warning-emphasis">Stale (5-15m)</div>
                        <div class="fs-4 fw-bold text-warning-emphasis">@staleCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-pill metric-pill-offline">
                        <div class="small fw-semibold text-danger">Offline (&gt;15m)</div>
                        <div class="fs-4 fw-bold text-danger">@offlineCount</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="metric-pill metric-pill-refreshed">
                        <div class="small fw-semibold text-secondary">Refreshed</div>
                        <div class="fs-5 fw-bold text-dark">@lastRefreshTime</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- LEFT COLUMN: Employee Connection Health Directory & Selected Employee Panel & Ledger -->
        <div class="col-12 col-xl-5">
            <!-- All Employees Connection Health Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0">All Employees Connection Health</h6>
                            <small class="text-muted">Tap an employee to inspect their offline periods and route</small>
                        </div>
                        <span class="badge bg-light text-dark border">@filteredEmployeeRows.Count() employees</span>
                    </div>

                    <!-- Search Box -->
                    <div class="input-group input-group-sm mt-3">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Search employee by name or ID..."
                               @bind="searchQuery" @bind:event="oninput" />
                    </div>

                    <!-- Status Filter Chips -->
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        <button class="filter-chip @(statusFilter == "ALL" ? "active" : "")" @onclick='() => SetStatusFilter("ALL")'>✓ All</button>
                        <button class="filter-chip @(statusFilter == "LIVE" ? "active" : "")" @onclick='() => SetStatusFilter("LIVE")'>🟢 Live</button>
                        <button class="filter-chip @(statusFilter == "STALE" ? "active" : "")" @onclick='() => SetStatusFilter("STALE")'>🟡 Stale</button>
                        <button class="filter-chip @(statusFilter == "OFFLINE" ? "active" : "")" @onclick='() => SetStatusFilter("OFFLINE")'>🔴 Offline</button>
                        <button class="filter-chip @(statusFilter == "PENDING_SYNC" ? "active" : "")" @onclick='() => SetStatusFilter("PENDING_SYNC")'>⏳ Pending Sync</button>
                    </div>
                </div>

                <div class="card-body p-2" style="max-height: 480px; overflow-y: auto;">
                    @if (!filteredEmployeeRows.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                            <div>No employees match the selected criteria.</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var emp in filteredEmployeeRows)
                        {
                            var isSelected = emp.EmployeeId == selectedEmployeeId;
                            <div class="employee-health-card @(isSelected ? "selected" : "") p-3 mb-2" @onclick="() => SelectEmployee(emp.EmployeeId)">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <div>
                                        <div class="fw-bold text-dark fs-6">@emp.EmployeeName</div>
                                        <div class="small text-muted">ID #@emp.EmployeeId</div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge @emp.SyncBadgeClass">@emp.SyncBadgeText</span>
                                        <span class="badge @emp.StatusBadgeClass">@emp.Status</span>
                                    </div>
                                </div>

                                <div class="punch-summary-line small my-1">
                                    @emp.PunchSummary
                                </div>

                                <div class="d-flex justify-content-between align-items-center small text-muted mt-2 pt-2 border-top">
                                    <div>
                                        <span>Last: @emp.LastSeenStr</span> · <span class="fw-semibold">@emp.AgeStr</span>
                                    </div>
                                    <div class="text-end">
                                        <span>@emp.MovementState</span> · <span>@emp.SpeedKmh.ToString("F1") km/h</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center small mt-1">
                                    <span class="coord-label">
                                        @if (emp.Latitude != 0)
                                        {
                                            <code>@emp.Latitude.ToString("F5"), @emp.Longitude.ToString("F5")</code>
                                            <span class="ms-1 @(emp.IsWithinRadius ? "text-success" : "text-danger")">
                                                @(emp.IsWithinRadius ? "• Within range" : "• Outside range")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">No GPS coordinates recorded</span>
                                        }
                                    </span>
                                    <span class="text-primary fw-semibold tap-inspect">
                                        Tap to inspect <i class="bi bi-chevron-right"></i>
                                    </span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Selected Employee Detail Panel -->
            @if (selectedEmployeeId > 0 && selectedEmployeeRow != null)
            {
                <div class="card border-primary shadow-sm mb-3 selected-emp-card">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                        <div>
                            <strong><i class="bi bi-person-check-fill me-1"></i>@selectedEmployeeRow.EmployeeName</strong>
                            <span class="small ms-2 opacity-75">ID #@selectedEmployeeRow.EmployeeId</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-dark">@selectedEmployeeRow.Status</span>
                            <button class="btn btn-sm btn-light py-0 px-2 text-dark" @onclick="ClearSelectedEmployee">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body p-3 small">
                        <!-- Section A: Attendance -->
                        <div class="mb-3">
                            <h6 class="fw-bold text-dark border-bottom pb-1 mb-2"><i class="bi bi-clock me-1 text-primary"></i>Today's Attendance Details</h6>
                            <div class="mb-1">@selectedEmployeeRow.PunchInDetail</div>
                            <div class="text-muted mb-1">Punch In Location: @selectedEmployeeRow.PunchInLocationDetail</div>
                            <div class="mb-1">@selectedEmployeeRow.PunchOutDetail</div>
                            <div class="fw-semibold text-secondary">@selectedEmployeeRow.WorkHoursDetail</div>
                        </div>

                        <!-- Section B: Live GPS & Telemetry -->
                        <div class="mb-3">
                            <h6 class="fw-bold text-dark border-bottom pb-1 mb-2"><i class="bi bi-geo-alt-fill me-1 text-danger"></i>Live Telemetry &amp; Perimeter</h6>
                            <div class="mb-1">📍 GPS: <code>@selectedEmployeeRow.Latitude.ToString("F6"), @selectedEmployeeRow.Longitude.ToString("F6")</code></div>
                            <div class="mb-1">Movement: <strong>@selectedEmployeeRow.MovementState</strong> · Speed: <strong>@selectedEmployeeRow.SpeedKmh.ToString("F1") km/h</strong></div>
                            <div class="mb-1 @(selectedEmployeeRow.IsWithinRadius ? "text-success" : "text-danger") fw-semibold">
                                🏢 Geofence: @(selectedEmployeeRow.IsWithinRadius ? "Inside allowed office zone" : "Outside office perimeter zone")
                                @if (officeLat != 0 && selectedEmployeeRow.Latitude != 0)
                                {
                                    <span>(@selectedEmployeeRow.DistanceToOfficeMeters.ToString("N0")m from center)</span>
                                }
                            </div>
                            <div class="text-muted">Last Update: @selectedEmployeeRow.LastSeenStr (@selectedEmployeeRow.AgeStr)</div>
                        </div>

                        <!-- Section C: Cloud & Offline Telemetry -->
                        <div class="mb-3">
                            <h6 class="fw-bold text-dark border-bottom pb-1 mb-2"><i class="bi bi-cloud-arrow-up-fill me-1 text-info"></i>Cloud &amp; Offline Telemetry</h6>
                            <div class="mb-1">☁️ Cloud Points Synced: <strong>@selectedEmployeeHistory.Count points</strong> synchronized to Firebase SSOT</div>
                            <div class="mb-1">✓ Local Queue: 0 points pending (Fully synchronized to Cloud)</div>
                            <div class="text-muted">
                                📴 Offline Intervals: @(selectedEmployeePeriods.Any() ? $"{selectedEmployeePeriods.Count} period(s) detected • All reconciled" : "None detected today. Realtime continuous stream.")
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-3 pt-2 border-top">
                            <button class="btn btn-sm btn-outline-primary" @onclick="ScrollToMap">
                                <i class="bi bi-compass me-1"></i>Focus on Map
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Refresh(force: true)">
                                <i class="bi bi-arrow-repeat me-1"></i>Reload Cloud History
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Device Local Ledger & Enterprise Event Log -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent py-3">
                    <h6 class="fw-bold mb-0"><i class="bi bi-hdd-network me-2 text-primary"></i>This Device's Local Ledger &amp; Event Stream</h6>
                    <small class="text-muted">Local capture, retries, and network connectivity switches</small>
                </div>
                <div class="card-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <small class="text-muted d-block">Pending sync</small>
                                <strong class="fs-5 text-warning">0</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <small class="text-muted d-block">Local ledger</small>
                                <strong class="fs-5 text-dark">@totalPointsCount</strong>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded bg-light text-center">
                                <small class="text-muted d-block">Session</small>
                                <strong class="fs-6 text-primary text-truncate d-block">@(activeSessions.FirstOrDefault()?.SessionId.ToString("N").Substring(0, 8) ?? "Online")…</strong>
                            </div>
                        </div>
                    </div>

                    <div class="small text-muted mb-2">
                        <div>Last local capture: <strong>@(lastCaptureTime.HasValue ? ToLocal(lastCaptureTime.Value).ToString("dd-MMM HH:mm:ss") : "—")</strong></div>
                        <div>Last sync: <strong>@lastRefreshTime IST</strong></div>
                    </div>

                    <h6 class="fw-bold text-dark mt-3 mb-2"><i class="bi bi-journal-text me-1"></i>Enterprise Event Log</h6>
                    <div class="event-stream-box p-2 border rounded bg-light-subtle" style="max-height: 250px; overflow-y: auto;">
                        @if (!enterpriseEventLogs.Any())
                        {
                            <div class="p-3 text-center text-muted small">
                                <i class="bi bi-check-circle text-success fs-4 d-block mb-1"></i>
                                Continuous connection active. No connectivity dropouts recorded.
                            </div>
                        }
                        else
                        {
                            @foreach (var ev in enterpriseEventLogs)
                            {
                                <div class="event-log-item p-2 mb-2 bg-white rounded border shadow-xs">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="fw-bold small text-dark">
                                            <span>@ev.Icon</span> <span>@ev.Title</span>
                                        </div>
                                        <span class="badge @ev.BadgeClass small">@ev.BadgeText</span>
                                    </div>
                                    <div class="small text-secondary mb-1">@ev.Message</div>
                                    <div class="text-muted very-small">
                                        <i class="bi bi-clock me-1"></i>@ToLocal(ev.Timestamp).ToString("dd-MMM, hh:mm:ss tt") IST · @(ev.IsOnline ? "🌐 Online" : "📴 Offline")
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Map, Filter, Offline Disconnection Intervals & 5-Step Audit, Journey Timeline -->
        <div class="col-12 col-xl-7">
            <!-- Offline / Reconnect Route Map -->
            <div class="card border-0 shadow-sm mb-3" id="offline-map-container-card">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-map me-2 text-primary"></i>Offline / Reconnect Route</h6>
                        <small class="text-muted">
                            @if (selectedEmployeeRow != null)
                            {
                                <span>Showing route for <strong>@selectedEmployeeRow.EmployeeName</strong> · @selectedEmployeeHistory.Count points</span>
                            }
                            else
                            {
                                <span>All Employees Overview · @liveCount employee(s) active on live map</span>
                            }
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="badge bg-success-subtle text-success">🟢 Punch In</span>
                        <span class="badge bg-primary-subtle text-primary">📍 GPS Route</span>
                        <span class="badge bg-warning-subtle text-warning-emphasis">📴 Offline Gap</span>
                        <span class="badge bg-danger-subtle text-danger">🔴 Punch Out</span>
                    </div>
                </div>

                <div class="card-body p-0">
                    <div id="offline-tracking-map" style="height: 380px; width: 100%;"></div>
                </div>

                <div class="card-footer bg-white d-flex justify-content-between align-items-center flex-wrap gap-2 py-2">
                    <small class="text-muted">
                        Cached map tiles + locally retained GPS ledger with SSOT Realtime Sync
                    </small>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Refresh(force: true)">
                            <i class="bi bi-arrow-repeat me-1"></i>Refresh
                        </button>
                        @if (selectedEmployeeId > 0)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedEmployee">
                                <i class="bi bi-x-circle me-1"></i>Show All Map Markers
                            </button>
                        }
                    </div>
                </div>
            </div>

            <!-- Inspect Employee Selector Dropdown -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-8">
                            <label class="form-label small text-muted mb-1 fw-semibold"><i class="bi bi-person-badge me-1"></i>Inspect Employee</label>
                            <select class="form-select" value="@selectedEmployeeId" @onchange="OnEmployeeDropdownChanged">
                                <option value="0">All Tracked Employees</option>
                                @foreach (var emp in allEmployees)
                                {
                                    <option value="@emp.EmployeeID">@emp.Name (#@emp.EmployeeID)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4 text-md-end mt-3 mt-md-0 pt-md-3">
                            <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                                @displayedPeriods.Count offline period@(displayedPeriods.Count == 1 ? "" : "s")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Offline Disconnection Intervals Section -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent py-3">
                    <h6 class="fw-bold mb-0">
                        <i class="bi bi-cloud-slash text-warning me-2"></i>Offline Disconnection Intervals (Missing Window Reconciliation)
                    </h6>
                    <small class="text-muted">
                        Missing windows (airplane mode, network off) synced to cloud and reconciled to live attendance.
                    </small>
                </div>
                <div class="card-body p-3">
                    @if (!displayedPeriods.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <div class="fs-1 mb-2">🛡️</div>
                            <h6 class="fw-bold text-dark">No Offline Disconnection Intervals Detected</h6>
                            <p class="text-muted small mb-0">
                                Continuous real-time GPS stream active. All tracking points were synchronized live with no missing intervals &gt; 15 mins.
                            </p>
                        </div>
                    }
                    else
                    {
                        @foreach (var period in displayedPeriods)
                        {
                            var isInspecting = selectedOfflinePeriodId == period.Id;
                            <div class="offline-interval-card border rounded p-3 mb-3 bg-white shadow-xs @(isInspecting ? "border-primary" : "")">
                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                    <div>
                                        <div class="fw-bold fs-6 text-dark">
                                            <i class="bi bi-person-fill text-secondary me-1"></i>@period.EmployeeName
                                        </div>
                                        <div class="small text-muted">
                                            Disconnected: <strong>@ToLocal(period.StartTimeUtc).ToString("dd MMM hh:mm tt")</strong> → Reconnected: <strong>@ToLocal(period.EndTimeUtc).ToString("hh:mm tt") IST</strong>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        <span class="badge bg-dark-subtle text-dark">⏱️ @FormatDuration(period.Duration)</span>
                                        <span class="badge @period.ShiftBadgeClass">@period.ShiftTag</span>
                                        <span class="badge @period.ReasonBadgeClass">@period.Reason</span>
                                        <span class="badge @period.SyncBadgeClass">@period.SyncStatus</span>
                                    </div>
                                </div>

                                <!-- Prominent Attendance Impact Status Box -->
                                <div class="alert @period.ImpactAlertClass border p-2 px-3 my-2 mb-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">@period.ImpactIcon</span>
                                        <div>
                                            <div class="fw-bold small">@period.ImpactTitle</div>
                                            <div class="small text-dark">@period.LiveImpactSummary</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- 5-Step Detailed Linear Audit Timeline -->
                                <div class="step-audit-timeline p-3 rounded bg-light-subtle border">
                                    <div class="small fw-bold text-uppercase text-secondary mb-3">
                                        <i class="bi bi-diagram-3-fill me-1 text-primary"></i>Timeline Audit of This Offline Period
                                    </div>

                                    <!-- Step 1: Disconnection Event -->
                                    <div class="step-item d-flex gap-2 mb-2">
                                        <div class="step-dot bg-warning"></div>
                                        <div>
                                            <strong class="small text-dark">Step 1 · Disconnection Event (When &amp; Why)</strong>
                                            <div class="text-muted very-small">
                                                Disconnected at <strong>@ToLocal(period.StartTimeUtc).ToString("hh:mm tt") IST</strong> · Cause: <strong>@period.Reason</strong> · Position: <strong>@period.Step1LocationDescription</strong>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 2: Journey Stops & Stay Points -->
                                    <div class="step-item d-flex gap-2 mb-2">
                                        <div class="step-dot bg-primary"></div>
                                        <div>
                                            <strong class="small text-dark">Step 2 · Journey Stops &amp; Stay Points (Where &amp; How Long Stayed)</strong>
                                            <div class="text-muted very-small">
                                                Traversed <strong>@FormatDistance(period.DistanceMeters)</strong> across <strong>@period.PointsCount points</strong> captured locally.
                                                @if (period.Stays.Any())
                                                {
                                                    <div class="mt-1 text-dark">
                                                        @foreach (var s in period.Stays)
                                                        {
                                                            <div>📍 Stayed <strong>@FormatDuration(s.Duration)</strong> (@ToLocal(s.StartUtc).ToString("hh:mm tt") – @ToLocal(s.EndUtc).ToString("hh:mm tt")): <strong>@s.LocationDescription</strong></div>
                                                        }
                                                    </div>
                                                }
                                                else if (period.DistanceMeters < 30)
                                                {
                                                    <span>Stationary at current location throughout entire disconnect window.</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 3: Geofence Perimeter Assessment -->
                                    <div class="step-item d-flex gap-2 mb-2">
                                        <div class="step-dot @(period.InRadiusCount == 0 ? "bg-danger" : "bg-success")"></div>
                                        <div>
                                            <strong class="small text-dark">Step 3 · Geofence Perimeter Assessment (Inside vs Outside Office)</strong>
                                            <div class="text-muted very-small">
                                                @if (period.PointsCount - period.InRadiusCount == 0)
                                                {
                                                    <span class="text-success">🟢 100% Inside Office Radius (@period.PointsCount points within boundary) · Remained on-premises</span>
                                                }
                                                else if (period.InRadiusCount == 0)
                                                {
                                                    <span class="text-danger">🔴 Outside Office Perimeter throughout entire disconnect window (@period.PointsCount points outside)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-warning-emphasis">⚠️ Perimeter Transition: @period.InRadiusCount points inside, @(period.PointsCount - period.InRadiusCount) points outside</span>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 4: Reconnection & Cloud Sync -->
                                    <div class="step-item d-flex gap-2 mb-2">
                                        <div class="step-dot bg-info"></div>
                                        <div>
                                            <strong class="small text-dark">Step 4 · Reconnection &amp; Cloud Sync</strong>
                                            <div class="text-muted very-small">
                                                Reconnected at <strong>@ToLocal(period.EndTimeUtc).ToString("hh:mm tt") IST</strong>.
                                                <span>✓ All @period.PointsCount offline breadcrumbs reconciled into Cloud SSOT.</span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Step 5: Live Attendance Impact -->
                                    <div class="step-item d-flex gap-2">
                                        <div class="step-dot bg-success"></div>
                                        <div>
                                            <strong class="small text-dark">Step 5 · Live Attendance Impact (Reconciled Result)</strong>
                                            <div class="text-muted very-small">
                                                @period.LiveImpactSummary
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                    <div class="very-small text-muted">
                                        @period.PointsCount points captured · @FormatDistance(period.DistanceMeters) · Within geofence: @period.InRadiusCount / Outside: @(period.PointsCount - period.InRadiusCount)
                                    </div>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => InspectPeriodOnMap(period)">
                                        <i class="bi bi-map me-1"></i>Inspect Offline Path on Map
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Offline Route / Point Ledger (ONLY OFFLINE DATA) -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <h6 class="fw-bold mb-0">
                            <i class="bi bi-map me-2 text-primary"></i>Offline Route / Point Ledger
                        </h6>
                        <small class="text-muted">
                            Dedicated ledger of breadcrumb points, dwell stops, and attendance impact captured during offline disconnection windows.
                        </small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrEmpty(selectedOfflinePeriodId))
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelectedOfflinePeriod">
                                <i class="bi bi-x-circle me-1"></i>Show All Offline Points
                            </button>
                        }
                        <span class="badge bg-warning text-dark px-3 py-2 fs-6">
                            @displayedLedgerRows.Count offline event@(displayedLedgerRows.Count == 1 ? "" : "s")
                        </span>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (!displayedLedgerRows.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <div class="fs-1 mb-2">🟢</div>
                            <h6 class="fw-bold text-dark">No Offline Disconnection Events Recorded</h6>
                            <p class="text-muted small mb-0">
                                All active employees are communicating online in real-time. Continuous GPS streams are synchronized with zero buffered points.
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Offline Time (IST)</th>
                                        <th>Employee</th>
                                        <th>Event / Reason</th>
                                        <th>Coordinates</th>
                                        <th>Office Dist</th>
                                        <th>Geofence</th>
                                        <th>State &amp; Dwell</th>
                                        <th>Impact on Live Attendance</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in displayedLedgerRows)
                                    {
                                        var isSelected = !string.IsNullOrEmpty(selectedOfflinePeriodId) && row.PeriodId == selectedOfflinePeriodId;
                                        <tr class="@(isSelected ? "table-warning fw-semibold" : "")">
                                            <td class="nowrap">
                                                <small class="fw-bold text-dark">@ToLocal(row.TimestampUtc).ToString("dd-MMM-yyyy")</small>
                                                <div class="text-muted very-small">@ToLocal(row.TimestampUtc).ToString("hh:mm:ss tt") IST</div>
                                            </td>
                                            <td>
                                                <strong>@row.EmployeeName</strong>
                                                <div class="text-muted very-small">#@row.EmployeeId</div>
                                            </td>
                                            <td>
                                                <span class="badge @row.EventBadgeClass">@row.EventType</span>
                                                <div class="text-muted very-small mt-1">@row.DisconnectReason</div>
                                            </td>
                                            <td>
                                                <code class="very-small">@row.Latitude.ToString("F6"), @row.Longitude.ToString("F6")</code>
                                            </td>
                                            <td class="nowrap very-small">
                                                @FormatDistance(row.DistanceFromOfficeMeters)
                                            </td>
                                            <td>
                                                @if (row.IsWithinRadius)
                                                {
                                                    <span class="badge bg-success-subtle text-success">🟢 IN (Safe)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">🔴 OUT (Breached)</span>
                                                }
                                            </td>
                                            <td class="very-small">
                                                @row.StateAndDwell
                                            </td>
                                            <td class="very-small">
                                                <span class="fw-semibold text-dark">@row.LiveImpact</span>
                                            </td>
                                            <td class="text-end nowrap">
                                                @if (!string.IsNullOrEmpty(row.PeriodId))
                                                {
                                                    var targetPeriod = allOfflinePeriods.FirstOrDefault(p => p.Id == row.PeriodId);
                                                    if (targetPeriod != null)
                                                    {
                                                        <button class="btn btn-xs btn-outline-primary py-0 px-2" @onclick="() => InspectPeriodOnMap(targetPeriod)">
                                                            <i class="bi bi-map me-1"></i>Map
                                                        </button>
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- Today's Journey & Sync Timeline -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-transparent py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Today's Journey &amp; Sync Timeline</h6>
                        <small class="text-muted">Chronological punches, live tracking &amp; offline sync</small>
                    </div>
                    <span class="badge bg-light text-dark border">
                        @(selectedEmployeeId > 0 ? $"{journeyTimelineSteps.Count} events" : "All Employees")
                    </span>
                </div>
                <div class="card-body p-3">
                    @if (selectedEmployeeId == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-hand-index-thumb fs-2 d-block mb-2 text-primary"></i>
                            <div>Tap any employee in the health directory above to view their chronological punch, tracking and sync timeline.</div>
                        </div>
                    }
                    else if (!journeyTimelineSteps.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                            <div>No journey events recorded today for this employee.</div>
                        </div>
                    }
                    else
                    {
                        <div class="timeline-journey-feed">
                            @foreach (var step in journeyTimelineSteps)
                            {
                                <div class="timeline-step-row d-flex align-items-start gap-3 mb-3">
                                    <div class="timeline-icon-box">@step.Icon</div>
                                    <div class="flex-grow-1 border-start ps-3 pb-2">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge @step.BadgeClass">@step.Badge</span>
                                            <small class="text-muted fw-semibold">@ToLocal(step.TimeUtc).ToString("hh:mm tt") IST</small>
                                        </div>
                                        <div class="fw-bold small text-dark">@step.Title</div>
                                        <div class="small text-secondary">@step.Description</div>
                                        <div class="very-small text-muted mt-1">@step.SyncStatus</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
