@page "/admin/attendance-event-monitoring"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseUserManagementService FirebaseUsers

@attribute [Authorize(Roles = "Admin,SuperAdmin")]

<PageTitle>Attendance Event Monitoring</PageTitle>

<AttendanceRefreshListener OnAttendanceChanged="LoadEvents" />
<ApplicationRealtimeRefreshListener OnApplicationDataChanged="LoadEvents" />

<div class="page-header-container mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="emoji-icon-badge emoji-icon-badge-info">
            🛰️
        </div>
        <div>
            <h2 class="page-header-title">
                Attendance Event & Device Security Monitoring
            </h2>
            <p class="page-header-subtitle">
                <span>📡 Login, logout & single-device session lifecycle with real-time biometric tamper monitoring</span>
            </p>
        </div>
    </div>

    <div class="d-flex align-items-center gap-2">
        <button class="action-pill-btn action-pill-btn-primary" @onclick="LoadEvents">
            <span>🔄 Refresh Event Logs</span>
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 p-md-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label small fw-bold text-muted">📅 Start Date</label><input type="date" class="form-control rounded-3" @bind="startDate" /></div>
            <div class="col-md-3"><label class="form-label small fw-bold text-muted">📅 End Date</label><input type="date" class="form-control rounded-3" @bind="endDate" /></div>
            <div class="col-md-3"><label class="form-label small fw-bold text-muted">🔍 Event Type Filter</label>
                <select class="form-select rounded-3" @bind="eventFilter">
                    <option value="">All Security Events</option>
                    <option>LOGIN_ATTEMPT</option><option>LOGIN_SUCCESS</option><option>LOGIN_FAILED</option>
                    <option>SECOND_DEVICE_ATTEMPT</option><option>FORCE_LOGOUT_REQUESTED</option><option>FORCED_SESSION_LOGOUT</option>
                    <option>LOGOUT_REQUESTED</option><option>DEVICE_LOCK_RELEASED</option><option>LOGOUT_COMPLETED</option>
                </select>
            </div>
            <div class="col-md-3"><button class="btn btn-primary rounded-3 w-100 fw-semibold" @onclick="LoadEvents">🔍 Search Logs</button></div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-3 text-muted fw-semibold">Loading security telemetry... 🛰️</p>
    </div>
}
else if (!events.Any())
{
    <div class="text-center p-5 bg-light rounded-4 border">
        <span class="fs-1 d-block mb-2">🛡️</span>
        <p class="mb-0 text-muted fw-semibold">No monitored events found for the selected period.</p>
    </div>
}
else
{
    <div class="table-responsive-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>⏱️ Timestamp</th>
                        <th>👤 User Identity</th>
                        <th>📌 Event Type</th>
                        <th>📋 Diagnostic Details</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in events)
                {
                    <tr>
                        <td style="white-space:nowrap">@ToIndiaTime(item.Timestamp).ToString("dd-MMM-yyyy HH:mm:ss")</td>
                        <td><div class="fw-semibold">@item.UserEmail</div><div class="small text-muted">@item.EntityID</div></td>
                        <td><span class="badge @Badge(item.EventType) rounded-pill">@item.EventType</span></td>
                        <td><pre class="small mb-0" style="white-space:pre-wrap;max-width:900px">@item.Details</pre></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<Row> events = new();
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;
    private string eventFilter = string.Empty;
    private bool loading;

    protected override async Task OnInitializedAsync() => await LoadEvents();

    private async Task LoadEvents()
    {
        loading = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var from = IndiaToUtc(startDate.Date);
            var to = IndiaToUtc(endDate.Date.AddDays(1));

            // REQUIREMENT: Monitor login/logout lifecycle across both Web and Android.
            // Android events use "AUTH_SESSION" as ActionType. Web also uses this.
            var raw = await db.AuditLogs.AsNoTracking()
                .Where(x => x.ActionType == "AUTH_SESSION" && x.Timestamp >= from && x.Timestamp < to)
                .OrderByDescending(x => x.Timestamp).Take(1000).ToListAsync();

            events = raw.Select(x => new Row(x.Timestamp, x.UserEmail, x.EntityID, ExtractEvent(x.Details), x.Details ?? string.Empty))
                .Where(x => string.IsNullOrWhiteSpace(eventFilter) || x.EventType.Equals(eventFilter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
        finally { loading = false; }
    }

    private static readonly TimeZoneInfo IndiaTimeZone =
        TimeZoneInfo.FindSystemTimeZoneById("Asia/Kolkata");

    private static DateTime ToIndiaTime(DateTime value) =>
        TimeZoneInfo.ConvertTimeFromUtc(
            DateTime.SpecifyKind(value, DateTimeKind.Utc),
            IndiaTimeZone);

    private static DateTime IndiaToUtc(DateTime indiaTime) =>
        TimeZoneInfo.ConvertTimeToUtc(
            DateTime.SpecifyKind(indiaTime, DateTimeKind.Unspecified),
            IndiaTimeZone);

    private static string ExtractEvent(string? details)
    {
        if (string.IsNullOrWhiteSpace(details)) return "UNKNOWN";
        try { using var doc = System.Text.Json.JsonDocument.Parse(details); return doc.RootElement.TryGetProperty("EventType", out var p) ? p.GetString() ?? "UNKNOWN" : "UNKNOWN"; }
        catch { return "UNKNOWN"; }
    }

    private static string Badge(string e) => e switch
    {
        "LOGIN_SUCCESS" or "LOGOUT_COMPLETED" => "bg-success",
        "SECOND_DEVICE_ATTEMPT" or "FORCE_LOGOUT_REQUESTED" => "bg-warning text-dark",
        "FORCED_SESSION_LOGOUT" or "LOGIN_FAILED" => "bg-danger",
        _ => "bg-secondary"
    };

    private sealed record Row(DateTime Timestamp, string UserEmail, string? EntityID, string EventType, string Details);
}
