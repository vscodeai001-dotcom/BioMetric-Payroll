@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using global::Payroll.Shared
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject ILogger<Home> _logger
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState
@inject GeoFeatureAccessService GeoAccess
@using global::Payroll.Web.Components.UI.Attendance
@attribute [Authorize]

<PageTitle>Admin Dashboard</PageTitle>

<style>
    .dashboard-container {
        animation: fadeIn .5s ease-in-out
    }

    .welcome-banner {
        background: linear-gradient(135deg,#1e3c72 0%,#2a5298 100%);
        color: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1rem;
        box-shadow: 0 4px 20px rgba(30,60,114,.2);
        position: relative;
        overflow: hidden
    }

        .welcome-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,.1);
            border-radius: 50%
        }

    .kpi-card {
        background: white;
        border: none;
        border-radius: 12px;
        padding: 1.5rem;
        height: 100%;
        transition: all .3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        box-shadow: 0 2px 10px rgba(0,0,0,.05)
    }

    body.dark .kpi-card {
        background: #1b222c;
        color: #f3f6fa;
        border-top-color: #3a4654;
        border-right-color: #3a4654;
        border-bottom-color: #3a4654;
        box-shadow: 0 10px 24px rgba(0,0,0,.22);
    }

    body.dark .kpi-card h1,
    body.dark .kpi-card h2,
    body.dark .kpi-card h3,
    body.dark .kpi-card h4,
    body.dark .kpi-card h5,
    body.dark .kpi-card h6 {
        color: #f8fafc !important;
    }

    body.dark .kpi-card .text-muted {
        color: #b8c3d0 !important;
    }

        .kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,.1)
        }

        .kpi-card.primary {
            border-left: 5px solid #0d6efd
        }

        .kpi-card.success {
            border-left: 5px solid #198754
        }

        .kpi-card.warning {
            border-left: 5px solid #ffc107
        }

        .kpi-card.danger {
            border-left: 5px solid #dc3545
        }

        .kpi-card.info {
            border-left: 5px solid #0dcaf0
        }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem
    }

    .shortcut-list .list-group-item {
        border: none;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: .5rem;
        background-color: #f8f9fa;
        transition: background-color .2s
    }

        .shortcut-list .list-group-item:hover {
            background-color: #e9ecef
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px)
        }

        to {
            opacity: 1;
            transform: translateY(0)
        }
    }
</style>

@if (!isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="height:60vh;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
        <p class="ms-3 text-muted mb-0">Gathering insights...</p>
    </div>
}
else
{
    <AttendanceRefreshListener OnAttendanceChanged="HandleLiveAttendanceChanged"
                               OnLocationChanged="HandleLiveLocationChanged"
                               OnSessionStarted="HandleLiveLocationChanged"
                               OnRegularizationChanged="HandleLiveRegularizationChanged" />
    <div class="dashboard-container">
        <div class="welcome-banner d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Dashboard Overview</h2>
                <p class="mb-0 opacity-75">Real-time insights for @DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-xl-3 col-md-6" @onclick='() => Navigation.NavigateTo("employees")'>
                <div class="kpi-card primary">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Total Workforce</p>
                            <h2 class="fw-bold text-dark mb-0">@totalEmployees</h2>
                            <small class="text-success"><i class="bi bi-person-check"></i>@activeEmployees Active</small>
                        </div>
                        <div class="kpi-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people-fill"></i></div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6" @onclick='() => Navigation.NavigateTo("attendancelogs")'>
                <div class="kpi-card success">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Present Today</p>
                            <h2 class="fw-bold text-dark mb-0">@presentToday <span class="text-muted fs-6 fw-normal">/ @activeEmployees</span></h2>
                            <small class="text-danger"><i class="bi bi-person-dash"></i>@absentTodayEst Absent</small>
                        </div>
                        <div class="kpi-icon bg-success bg-opacity-10 text-success"><i class="bi bi-clock-history"></i></div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6" @onclick='() => Navigation.NavigateTo("run-payroll")'>
                <div class="kpi-card warning">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Payroll (@DateTime.Now.ToString("MMM"))</p>
                            <h2 class="fw-bold text-dark mb-0">@(pendingPayrolls > 0 ? "Pending" : "Done")</h2>
                            <small class="text-muted">Current Cycle</small>
                        </div>
                        <div class="kpi-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-wallet2"></i></div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6" @onclick='() => Navigation.NavigateTo("salary-advances")'>
                <div class="kpi-card danger">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-uppercase text-muted small fw-bold mb-1">Unpaid Advances</p>
                            <h2 class="fw-bold text-dark mb-0">@totalUnpaidAdvanceAmount.ToString("C0", inrCulture)</h2>
                            <small class="text-muted">Needs Recovery</small>
                        </div>
                        <div class="kpi-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-cash-stack"></i></div>
                    </div>
                </div>
            </div>
        </div>



        @if (userIsSuperAdmin && geoFeatureAvailable)
        {
            <Payroll.Web.Components.UI.Attendance.LiveStaffLocationPanel />
        }
        
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                        <h5 class="fw-bold mb-0 text-secondary"><i class="bi bi-graph-up me-2"></i>Daily Operations</h5>
                    </div>
                    <div class="card-body px-4 pb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light h-100 d-flex align-items-center clickable" @onclick='() => Navigation.NavigateTo("schedule")' style="cursor:pointer">
                                    <div class="me-3 bg-white p-3 rounded shadow-sm text-info"><i class="bi bi-calendar-range fs-3"></i></div>
                                    <div>
                                        <h3 class="fw-bold mb-0">@shiftsScheduledToday</h3>
                                        <span class="text-muted small text-uppercase fw-bold">Shifts Scheduled Today</span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light h-100 d-flex align-items-center clickable" @onclick='() => Navigation.NavigateTo("company-attendance-report")' style="cursor:pointer">
                                    <div class="me-3 bg-white p-3 rounded shadow-sm text-primary"><i class="bi bi-stopwatch fs-3"></i></div>
                                    <div>
                                        <h3 class="fw-bold mb-0">@FormatTimeSpan(totalMonthScheduledNet)</h3>
                                        <span class="text-muted small text-uppercase fw-bold">Scheduled Hours (Month)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <h6 class="fw-bold text-muted small text-uppercase mb-3">Quick Actions</h6>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="attendance/regularization-approval" class="btn btn-outline-primary btn-sm rounded-pill px-3"><i class="bi bi-check2-square me-1"></i>Approve Regularizations</a>
                                <a href="admin/report-center" class="btn btn-outline-success btn-sm rounded-pill px-3"><i class="bi bi-file-earmark-bar-graph me-1"></i>Generate Reports</a>
                                <a href="employees" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-person-plus me-1"></i>Add Employee</a>
                                <a href="admin/feature-toggles" class="btn btn-outline-dark btn-sm rounded-pill px-3"><i class="bi bi-sliders me-1"></i>System Settings</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0 text-secondary">Recent Advances</h5>
                        <span class="badge bg-danger rounded-pill">@unpaidAdvances.Count</span>
                    </div>
                    <div class="card-body px-4 pb-4">
                        @if (unpaidAdvances.Any())
                        {
                            <div class="list-group list-group-flush shortcut-list">
                                @foreach (var adv in unpaidAdvances.Take(4))
                                {
                                    <div class="list-group-item bg-light border-0 mb-2 rounded">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <span class="fw-bold d-block text-dark">@GetEmployeeName(adv.EmployeeID)</span>
                                                <small class="text-muted">@adv.AdvanceDate?.ToString("dd-MMM") • @adv.AdvanceType</small>
                                            </div>
                                            <span class="fw-bold text-danger">@adv.Amount.ToString("C0", inrCulture)</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (unpaidAdvances.Count > 4)
                            {
                                <div class="text-center mt-3"><a href="salary-advances" class="text-decoration-none fw-bold small">View All</a></div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted"><i class="bi bi-check-circle display-4 d-block mb-2 text-success opacity-50"></i>No unpaid advances.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isLoaded = false;
    private bool geoFeatureAvailable;
    private bool userIsSuperAdmin = false;
    private int presentToday;
    private int absentTodayEst;
    private int totalEmployees;
    private int activeEmployees;
    private int pendingPayrolls;
    private int shiftsScheduledToday;
    private decimal totalUnpaidAdvanceAmount;
    private TimeSpan totalMonthScheduledNet = TimeSpan.Zero;
    private List<SalaryAdvance> unpaidAdvances = new();
    private List<Employee> employeeList = new();
    private CultureInfo inrCulture = new("en-IN");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthState.GetAuthenticationStateAsync();
            var user = authState.User;

            // ---------------------------------------------------------
            // ROLE CHECK
            // ---------------------------------------------------------
            userIsSuperAdmin = user.IsInRole("SuperAdmin");

            // Employee must never access Admin Dashboard
            if (user.IsInRole("Employee") &&
                !user.IsInRole("Admin") &&
                !userIsSuperAdmin)
            {
                Navigation.NavigateTo("/employee-home", true);
                return;
            }

            // ---------------------------------------------------------
            // GEO-FENCING
            //
            // IMPORTANT:
            // Only SuperAdmin can see/use the Live Staff Location panel.
            //
            // Even if Geo-Fencing is enabled in FeatureSettings,
            // Admin and Employee will NOT see this panel.
            // ---------------------------------------------------------
            if (userIsSuperAdmin)
            {
                geoFeatureAvailable = await GeoAccess.IsEnabledAsync();
            }
            else
            {
                geoFeatureAvailable = false;
            }

            await LoadAdminDashboard();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Admin dashboard initialization failed.");
            geoFeatureAvailable = false;
        }
    }

    private async Task LoadAdminDashboard()
    {
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            var today = DateOnly.FromDateTime(DateTime.Now);
            var todayStart = DateTime.Now.Date;
            var todayEnd = todayStart.AddDays(1);

            shiftsScheduledToday = await dbContext.ShiftSchedules.AsNoTracking().Where(s => s.ShiftDate == today).CountAsync();

            employeeList = await dbContext.Employees.AsNoTracking().ToListAsync();
            totalEmployees = employeeList.Count;
            activeEmployees = employeeList.Count(e => !e.TerminationDate.HasValue);

            var presentIds = await dbContext.AttendanceLogs.AsNoTracking().Where(l => l.PunchTime >= todayStart && l.PunchTime < todayEnd && l.EmployeeID.HasValue).Select(l => l.EmployeeID!.Value).Distinct().ToListAsync();
            presentToday = presentIds.Count(id => employeeList.Any(e => e.EmployeeID == id && !e.TerminationDate.HasValue));
            absentTodayEst = Math.Max(0, activeEmployees - presentToday);

            unpaidAdvances = await dbContext.SalaryAdvances.AsNoTracking().Where(adv => adv.PayrollID_Paid == null).OrderByDescending(adv => adv.AdvanceDate).ToListAsync();
            totalUnpaidAdvanceAmount = unpaidAdvances.Sum(adv => adv.Amount);

            var lastMonth = DateTime.Now.AddMonths(-1);
            var summaries = await dbContext.DailySummaries.Where(ds => ds.ShiftDate.Year == today.Year && ds.ShiftDate.Month == today.Month).AsNoTracking().ToListAsync();
            totalMonthScheduledNet = TimeSpan.FromTicks(summaries.Sum(s => s.ScheduledShiftDuration.Ticks));

            pendingPayrolls = await dbContext.PayrollHistories.AsNoTracking().AnyAsync(p => p.PayYear == lastMonth.Year && p.PayMonth == lastMonth.Month) ? 0 : 1;
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Dashboard loading error");
        }
        finally
        {
            isLoaded = true;
        }
    }

    private string GetEmployeeName(int id) => employeeList.FirstOrDefault(e => e.EmployeeID == id)?.Name ?? $"ID:{id}";

    private string FormatTimeSpan(TimeSpan ts)
    {
        if (ts < TimeSpan.Zero) ts = TimeSpan.Zero;
        ts = TimeSpan.FromMinutes(Math.Round(ts.TotalMinutes));
        int h = (int)Math.Floor(ts.TotalHours); 
        int m = ts.Minutes;
        return $"{h}h {m}m";
    }

    // ============================================================
    // REAL-TIME ATTENDANCE REFRESH
    // ============================================================

    private async Task HandleLiveAttendanceChanged()
    {
        try
        {
            await LoadAdminDashboard();

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live attendance dashboard refresh failed.");
        }
    }

    // ============================================================
    // REAL-TIME LOCATION REFRESH
    //
    // LiveStaffLocationPanel has its own live behaviour, but
    // refreshing the dashboard here keeps dashboard information
    // synchronized when a location event is received.
    // ============================================================

    private async Task HandleLiveLocationChanged()
    {
        try
        {
            await LoadAdminDashboard();

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live location dashboard refresh failed.");
        }
    }

    // ============================================================
    // REAL-TIME REGULARIZATION REFRESH
    // ============================================================

    private async Task HandleLiveRegularizationChanged()
    {
        try
        {
            await LoadAdminDashboard();

            await InvokeAsync(
                StateHasChanged);
        }
        catch (Exception ex)
        {
            _logger.LogWarning(
                ex,
                "Live regularization dashboard refresh failed.");
        }
    }
}