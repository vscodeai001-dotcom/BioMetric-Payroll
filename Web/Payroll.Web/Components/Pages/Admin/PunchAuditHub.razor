    private static string EscapeCsv(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "\"\"";
        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }

    private async Task ExportToCsv()
    {
        if (!filteredPunches.Any()) return;

        var sb = new StringBuilder();
        sb.AppendLine("LogID,Date,Time,EmployeeID,EmployeeName,Direction,SourceTier,DeviceID,BiometricID,IsAccepted,Status,RuleCategory,Reason");

        foreach (var p in filteredPunches)
        {
            var line = string.Join(",",
                p.LogId,
                p.PunchDate.ToString("yyyy-MM-dd"),
                p.PunchTime.ToString("HH:mm:ss"),
                p.EmployeeId,
                EscapeCsv(p.EmployeeName),
                p.IsIn ? "IN" : (p.IsOut ? "OUT" : p.RawDirection),
                p.SourceTier.ToString(),
                EscapeCsv(p.DeviceId),
                EscapeCsv(p.BiometricId),
                p.IsAccepted ? "true" : "false",
                p.EvaluationStatus,
                EscapeCsv(p.RuleCategory),
                EscapeCsv(p.Reason)
            );
            sb.AppendLine(line);
        }

        var bytes = Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"PunchAudit_{startDate:yyyyMMdd}_{endDate:yyyyMMdd}.csv";

        await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv", base64);
        ToastService.ShowSuccess("Punch audit export generated.");
    }
