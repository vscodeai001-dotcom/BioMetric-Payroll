@code {
    private bool isLoading = true;
    private string activeTab = "table"; // "table", "sequence", "intelligence"

    // Filter properties
    private DateOnly startDate = new DateOnly(2026, 10, 1);
    private DateOnly endDate = new DateOnly(2026, 10, 31);
    private int selectedEmployeeId = 0;
    private PunchSourceTier? sourceFilter = null;
    private bool? statusFilter = true; // Default to Accepted Only: suppresses duplicate/redundant entries
    private string? directionFilter = null;
    private string searchQuery = "";

    // Data lists
    private List<Employee> employees = new();
    private List<AttendanceLog> rawLogs = new();
    private List<EvaluatedPunchRecord> allEvaluatedPunches = new();
    private List<EvaluatedPunchRecord> filteredPunches = new();
    private List<DailyEmployeePunchSummary> dailySummaries = new();

    // Inspection Modal
    private EvaluatedPunchRecord? selectedPunchForInspection = null;

    // KPI Counters (computed across all evaluated punches in range)
    private int totalRawCount => allEvaluatedPunches.Count;
    private int acceptedCount => allEvaluatedPunches.Count(p => p.IsAccepted);
    private int suppressedCount => allEvaluatedPunches.Count(p => !p.IsAccepted);
    private int physicalCount => allEvaluatedPunches.Count(p => p.SourceTier == PunchSourceTier.PhysicalMachine);
    private int manualCount => allEvaluatedPunches.Count(p => p.SourceTier == PunchSourceTier.ManualAdmin);
    private int autoGeofenceCount => allEvaluatedPunches.Count(p => p.SourceTier == PunchSourceTier.GeofenceAuto);

    private async Task OnCriteriaChangedAsync()
    {
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesAsync();
        await LoadDataAsync();
    }

    private async Task LoadEmployeesAsync()
    {
        try
        {
            employees = await FirebaseEmployees.GetEmployeesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error fetching employee directory.");
            employees = new();
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Read raw punches from Firebase SSOT (with fallback to SQLite)
            rawLogs = await FirebaseAttendance.GetAttendancePunchesAsync(
                startDate,
                endDate,
                selectedEmployeeId > 0 ? selectedEmployeeId : null);

            // Run evaluation engine across all days and employees
            EvaluateAllPunches();

            ApplyFilter();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error executing punch audit telemetry.");
            ToastService.ShowError($"Error loading punches: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void EvaluateAllPunches()
    {
        allEvaluatedPunches.Clear();
        dailySummaries.Clear();

        if (rawLogs == null || !rawLogs.Any())
            return;

        var employeeMap = employees.ToDictionary(e => e.EmployeeID, e => e);

        // Group by (EmployeeID, PunchDate)
        var groupedByEmpAndDay = rawLogs
            .Where(l => l.EmployeeID.HasValue)
            .GroupBy(l => new { EmployeeID = l.EmployeeID!.Value, Day = DateOnly.FromDateTime(l.PunchTime.Date) })
            .OrderBy(g => g.Key.Day)
            .ThenBy(g => g.Key.EmployeeID);

        foreach (var group in groupedByEmpAndDay)
        {
            var empId = group.Key.EmployeeID;
            var dayDate = group.Key.Day;
            employeeMap.TryGetValue(empId, out var emp);

            var empName = emp?.Name ?? $"Employee #{empId}";
            var role = emp?.Role;

            // Resolve Shift Windows
            DateTime baseD = dayDate.ToDateTime(TimeOnly.MinValue);
            DateTime? shiftStartDt = emp?.ShiftStartTime.HasValue == true ? baseD.Add(emp.ShiftStartTime.Value.ToTimeSpan()) : null;
            DateTime? shiftEndDt = emp?.ShiftEndTime.HasValue == true ? baseD.Add(emp.ShiftEndTime.Value.ToTimeSpan()) : null;

            // Default shifts for known matrix employees if missing
            if (!shiftStartDt.HasValue && empId == 4) // Dinesh
            {
                shiftStartDt = baseD.AddHours(10).AddMinutes(30);
                shiftEndDt = baseD.AddHours(16).AddMinutes(30);
            }
            else if (!shiftStartDt.HasValue && empId == 3) // Nevetha
            {
                shiftStartDt = baseD.AddHours(6);
                shiftEndDt = baseD.AddHours(16);
            }

            // Deduplicate punches that share identical minute + direction + BiometricID (e.g. companion attendance session vs raw punch)
            var dayPunches = group
                .OrderBy(x => x.PunchTime)
                .ThenBy(x => AttendancePunchProcessor.GetPunchTier(x))
                .GroupBy(p =>
                {
                    bool isOut = AttendancePunchProcessor.IsExplicitOutPunch(p);
                    string dir = isOut ? "OUT" : "IN";
                    // If BiometricID starts with AUTO_ or GEOFENCE, group by employee + minute + dir
                    if (!string.IsNullOrEmpty(p.BiometricID) &&
                        (p.BiometricID.StartsWith("AUTO_", StringComparison.OrdinalIgnoreCase) ||
                         p.BiometricID.Equals("GEOFENCE_AUTO", StringComparison.OrdinalIgnoreCase)))
                    {
                        return $"{p.EmployeeID}_{p.PunchTime:yyyyMMdd_HHmm}_{dir}_{p.BiometricID.ToUpperInvariant()}";
                    }
                    return $"{p.EmployeeID}_{p.PunchTime:yyyyMMdd_HHmm}_{dir}_{(p.LogID > 0 ? p.LogID.ToString() : p.BiometricID)}";
                })
                .Select(g =>
                {
                    // Prefer genuine GeofenceAuto / Physical over fallback ManualCorrection
                    var preferred = g.FirstOrDefault(x =>
                        string.Equals(x.DeviceID, "AndroidGeofenceAuto", StringComparison.OrdinalIgnoreCase) ||
                        string.Equals(x.DeviceID, "GeofenceAuto", StringComparison.OrdinalIgnoreCase));
                    return preferred ?? g.First();
                })
                .OrderBy(x => x.PunchTime)
                .ToList();

            // Run deterministic AttendancePunchProcessor
            var processResult = PunchProcessor.ProcessPunches(
                dayPunches,
                baseD,
                shiftStartDt,
                shiftEndDt);

            var acceptedList = processResult.Ordered;

            // Build Daily Summary model
            var summary = new DailyEmployeePunchSummary
            {
                EmployeeId = empId,
                EmployeeName = empName,
                Date = dayDate,
                ShiftStart = emp?.ShiftStartTime ?? (shiftStartDt.HasValue ? TimeOnly.FromDateTime(shiftStartDt.Value) : null),
                ShiftEnd = emp?.ShiftEndTime ?? (shiftEndDt.HasValue ? TimeOnly.FromDateTime(shiftEndDt.Value) : null)
            };

            // Calculate accepted work hours
            double totalWorkedMinutes = 0;
            for (int i = 0; i < acceptedList.Count - 1; i += 2)
            {
                var span = acceptedList[i + 1].PunchTime - acceptedList[i].PunchTime;
                if (span.TotalMinutes > 0)
                    totalWorkedMinutes += span.TotalMinutes;
            }
            summary.TotalValidHoursWorked = totalWorkedMinutes / 60.0;

            double standardShiftHours = 8.0;
            if (summary.ShiftStart.HasValue && summary.ShiftEnd.HasValue)
            {
                standardShiftHours = Math.Max(1.0, (summary.ShiftEnd.Value - summary.ShiftStart.Value).TotalHours);
            }
            summary.OvertimeHours = Math.Max(0.0, summary.TotalValidHoursWorked - standardShiftHours);

            // Now evaluate each individual raw punch
            for (int idx = 0; idx < dayPunches.Count; idx++)
            {
                var raw = dayPunches[idx];
                var tier = AttendancePunchProcessor.GetPunchTier(raw);
                var rawDir = raw.LogType ?? "PUNCH";

                // Check if accepted in final sequence
                int acceptedIndex = -1;
                for (int a = 0; a < acceptedList.Count; a++)
                {
                    var acc = acceptedList[a];
                    if ((raw.LogID > 0 && acc.LogID == raw.LogID) ||
                        (acc.PunchTime == raw.PunchTime && acc.EmployeeID == raw.EmployeeID &&
                         string.Equals(acc.BiometricID, raw.BiometricID, StringComparison.OrdinalIgnoreCase)))
                    {
                        acceptedIndex = a;
                        break;
                    }
                }

                bool isAccepted = acceptedIndex >= 0;
                string reason = "";
                string category = "";

                if (isAccepted)
                {
                    if (acceptedIndex % 2 == 0)
                    {
                        reason = acceptedIndex == 0
                            ? "Accepted: Primary shift clock-in"
                            : "Accepted: Resumed work after break";
                        category = "Valid Check-IN";
                    }
                    else
                    {
                        reason = acceptedIndex == (acceptedList.Count - 1)
                            ? "Accepted: Final shift clock-out"
                            : "Accepted: Departure for break / transit";
                        category = "Valid Check-OUT";
                    }
                }
                else
                {
                    // Deduce exact reason for suppression
                    // 1. Same-minute priority collision
                    var collision = dayPunches.FirstOrDefault(o => o != raw &&
                        o.PunchTime == raw.PunchTime &&
                        AttendancePunchProcessor.GetPunchTier(o) < tier);

                    if (collision != null)
                    {
                        reason = $"Suppressed: Collided at {raw.PunchTime:HH:mm} with higher priority {AttendancePunchProcessor.GetPunchTier(collision)} (Physical > Manual > Geofence)";
                        category = "Priority Collision";
                    }
                    else
                    {
                        // 2. Authoritative Manual Correction window override
                        var mIns = dayPunches.Where(x => AttendancePunchProcessor.GetPunchTier(x) == PunchSourceTier.ManualAdmin && AttendancePunchProcessor.IsExplicitInPunch(x)).OrderBy(x => x.PunchTime).ToList();
                        var mOuts = dayPunches.Where(x => AttendancePunchProcessor.GetPunchTier(x) == PunchSourceTier.ManualAdmin && AttendancePunchProcessor.IsExplicitOutPunch(x)).OrderBy(x => x.PunchTime).ToList();

                        if (mIns.Count > 0 && mOuts.Count > 0 && raw.PunchTime > mIns.First().PunchTime && raw.PunchTime < mOuts.Last().PunchTime)
                        {
                            reason = $"Suppressed: Covered by authoritative Manual Correction window ({mIns.First().PunchTime:HH:mm} - {mOuts.Last().PunchTime:HH:mm}); intermediate punch ignored";
                            category = "Manual Shift Override";
                        }
                        else if (tier == PunchSourceTier.GeofenceAuto)
                        {
                            var authIn = dayPunches.FirstOrDefault(x => AttendancePunchProcessor.GetPunchTier(x) <= PunchSourceTier.ManualAdmin && AttendancePunchProcessor.IsExplicitInPunch(x));
                            var authOut = dayPunches.LastOrDefault(x => AttendancePunchProcessor.GetPunchTier(x) <= PunchSourceTier.ManualAdmin && AttendancePunchProcessor.IsExplicitOutPunch(x));

                            if (authIn != null && authOut != null && raw.PunchTime > authIn.PunchTime && raw.PunchTime < authOut.PunchTime)
                            {
                                reason = "Suppressed: GPS geofence drift suppressed during active authoritative shift";
                                category = "GPS Drift Suppression";
                            }
                            else if (AttendancePunchProcessor.IsExplicitOutPunch(raw))
                            {
                                reason = "Suppressed: Redundant geofence OUT — employee already clocked out";
                                category = "Redundant Exit";
                            }
                            else
                            {
                                reason = "Suppressed: Redundant consecutive geofence IN — employee already clocked in";
                                category = "Consecutive Entry";
                            }
                        }
                        else if (AttendancePunchProcessor.IsExplicitInPunch(raw))
                        {
                            reason = "Suppressed: Redundant consecutive IN punch — prior clock-in maintained";
                            category = "Consecutive Entry";
                        }
                        else if (AttendancePunchProcessor.IsExplicitOutPunch(raw))
                        {
                            reason = "Suppressed: Redundant OUT punch — employee already clocked out";
                            category = "Redundant Exit";
                        }
                        else
                        {
                            reason = "Suppressed: Discarded by alternating state machine (IN ↔ OUT)";
                            category = "Sequence Discard";
                        }
                    }
                }

                var record = new EvaluatedPunchRecord
                {
                    LogId = raw.LogID,
                    EmployeeId = empId,
                    EmployeeName = empName,
                    Role = role,
                    PunchTime = raw.PunchTime,
                    RawDirection = rawDir,
                    SourceTier = tier,
                    DeviceId = raw.DeviceID ?? "Terminal",
                    BiometricId = raw.BiometricID ?? string.Empty,
                    IsAccepted = isAccepted,
                    EvaluationStatus = isAccepted ? (acceptedIndex % 2 == 0 ? "ACCEPTED_IN" : "ACCEPTED_OUT") : "SUPPRESSED",
                    Reason = reason,
                    RuleCategory = category,
                    SequenceOrder = idx + 1
                };

                allEvaluatedPunches.Add(record);
                summary.RawPunches.Add(record);
            }

            dailySummaries.Add(summary);
        }
    }

    private void ApplyFilter()
    {
        var query = allEvaluatedPunches.AsEnumerable();

        if (selectedEmployeeId > 0)
            query = query.Where(p => p.EmployeeId == selectedEmployeeId);

        if (sourceFilter.HasValue)
            query = query.Where(p => p.SourceTier == sourceFilter.Value);

        if (statusFilter.HasValue)
            query = query.Where(p => p.IsAccepted == statusFilter.Value);

        if (!string.IsNullOrWhiteSpace(directionFilter))
        {
            if (directionFilter == "IN")
                query = query.Where(p => p.IsIn);
            else if (directionFilter == "OUT")
                query = query.Where(p => p.IsOut);
        }

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(p =>
                p.EmployeeName.ToLowerInvariant().Contains(q) ||
                p.EmployeeId.ToString().Contains(q) ||
                p.DeviceId.ToLowerInvariant().Contains(q) ||
                p.BiometricId.ToLowerInvariant().Contains(q) ||
                p.Reason.ToLowerInvariant().Contains(q) ||
                p.RuleCategory.ToLowerInvariant().Contains(q));
        }

        filteredPunches = query.OrderBy(p => p.PunchTime).ThenBy(p => p.EmployeeName).ToList();
        StateHasChanged();
    }

    private void SetSourceFilter(PunchSourceTier? tier)
    {
        sourceFilter = tier;
