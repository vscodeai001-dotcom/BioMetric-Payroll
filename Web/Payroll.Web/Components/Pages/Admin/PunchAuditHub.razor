    private List<(string Category, string SampleReason, int Count)> GetTopSuppressionReasons()
    {
        return allEvaluatedPunches
            .Where(p => !p.IsAccepted)
            .GroupBy(p => p.RuleCategory)
            .Select(g => (
                Category: g.Key,
                SampleReason: g.First().Reason,
                Count: g.Count()
            ))
            .OrderByDescending(x => x.Count)
            .ToList();
    }

    private string FormatHoursToHhMm(double hours)
    {
        if (hours <= 0) return "0h 00m";
        var ts = TimeSpan.FromHours(hours);
        return $"{(int)ts.TotalHours}h {ts.Minutes:D2}m";
    }

