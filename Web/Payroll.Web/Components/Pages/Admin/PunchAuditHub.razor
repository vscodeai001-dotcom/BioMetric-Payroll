@page "/admin/punch-audit-hub"
@page "/attendance/punch-inspector"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using System.Globalization
@using System.Text
@using global::Payroll.Shared
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using global::Payroll.Web.Services
@using global::Payroll.Web.Models
@using global::Payroll.Web.Components.UI.Attendance

@inject IDbContextFactory<AppDbContext> DbFactory
@inject FirebaseAttendanceService FirebaseAttendance
@inject FirebaseEmployeeManagementService FirebaseEmployees
@inject AttendancePunchProcessor PunchProcessor
@inject AttendanceRefreshService AttendanceRefresh
@inject AttendanceTestMatrixSeeder MatrixSeeder
@inject NavigationManager Navigation
@inject IToastService ToastService
@inject IJSRuntime JSRuntime
@inject ILogger<PunchAuditHub> Logger

@attribute [Authorize(Roles = "Admin, SuperAdmin")]

<PageTitle>Raw Punch Inspector & Multi-Mode Audit Hub</PageTitle>

<AttendanceRefreshListener OnAttendanceChanged="HandleDataRefreshAsync" />
<ApplicationRealtimeRefreshListener OnApplicationDataChanged="HandleDataRefreshAsync" />

<div class="punch-hub-wrapper">
    <!-- Top Header Banner -->
    <div class="hub-header card border-0 shadow-sm rounded-4 p-4 mb-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="hub-header-icon rounded-4 d-flex align-items-center justify-content-center">
                    <span class="fs-1">🛰️</span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <h2 class="fw-bold mb-0 text-hub-title">Raw Punch Inspector & Multi-Mode Hub</h2>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                            Enterprise Telemetry
                        </span>
                    </div>
                    <p class="text-hub-muted mb-0 mt-1">
                        Deep inspection of all raw punch events across <strong>📟 Physical Machine</strong>, <strong>✍️ Manual Correction</strong>, and <strong>📍 Android Auto-Geofence</strong> modes vs the final accepted sequence.
                    </p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <button class="btn btn-outline-warning rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                        @onclick="LoadOctoberMatrixPreset"
                        disabled="@isLoading"
                        title="Quick preset: Jump to October 2026 31-day hybrid test dataset">
                    <span>🧪</span>
                    <span>Oct 2026 Matrix</span>
                </button>

                <button class="btn btn-outline-success rounded-pill px-3 py-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                        @onclick="ExportToCsv"
                        disabled="@(filteredPunches == null || !filteredPunches.Any() || isLoading)">
                    <i class="bi bi-download"></i>
                    <span>Export CSV</span>
                </button>

                <button class="btn btn-primary rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-sm"
                        @onclick="LoadDataAsync"
                        disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status"></span>
                        <span>Analyzing...</span>
                    }
                    else
                    {
                        <i class="bi bi-arrow-clockwise"></i>
                        <span>Refresh Telemetry</span>
                    }
                </button>
            </div>
        </div>
    </div>

    <!-- Analytics & KPI Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Raw Punches -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-total">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-hub-muted">All Raw Punches</span>
                    <span class="fs-5">📊</span>
                </div>
                <div class="fs-3 fw-bold text-hub-title">@totalRawCount</div>
                <div class="small text-hub-muted">100% captured</div>
            </div>
        </div>

        <!-- Accepted / Valid -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-accepted">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-success">Accepted / Valid</span>
                    <span class="fs-5">✅</span>
                </div>
                <div class="fs-3 fw-bold text-success">@acceptedCount</div>
                <div class="small text-hub-muted">
                    @(totalRawCount > 0 ? $"{(acceptedCount * 100.0 / totalRawCount):F1}% acceptance" : "0%")
                </div>
            </div>
        </div>

        <!-- Suppressed / Filtered -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-suppressed">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-danger">Suppressed</span>
                    <span class="fs-5">🚫</span>
                </div>
                <div class="fs-3 fw-bold text-danger">@suppressedCount</div>
                <div class="small text-hub-muted">
                    @(totalRawCount > 0 ? $"{(suppressedCount * 100.0 / totalRawCount):F1}% suppressed" : "0%")
                </div>
            </div>
        </div>

        <!-- Physical Machine -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-physical">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-info">Physical Machine</span>
                    <span class="fs-5">📟</span>
                </div>
                <div class="fs-3 fw-bold text-info">@physicalCount</div>
                <div class="small text-hub-muted">Tier 1 Hardware</div>
            </div>
        </div>

        <!-- Manual Correction -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-manual">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-warning">Manual Correction</span>
                    <span class="fs-5">✍️</span>
                </div>
                <div class="fs-3 fw-bold text-warning">@manualCount</div>
                <div class="small text-hub-muted">Tier 2 Overrides</div>
            </div>
        </div>

        <!-- Auto Geofence -->
        <div class="col-6 col-md-4 col-xl-2">
            <div class="kpi-card card border-0 shadow-sm rounded-4 p-3 h-100 kpi-border-auto">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small fw-semibold text-primary">Auto Geofence</span>
                    <span class="fs-5">📍</span>
                </div>
                <div class="fs-3 fw-bold text-primary">@autoGeofenceCount</div>
                <div class="small text-hub-muted">Tier 3 Dynamic GPS</div>
            </div>
        </div>
    </div>

    <!-- Filter Station Card -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 filter-station-card">
        <div class="row g-3">
            <!-- Start Date -->
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small fw-bold text-hub-muted mb-1">📅 Start Date</label>
                <input type="date" class="form-control rounded-3 hub-input" @bind="startDate" @bind:after="OnCriteriaChangedAsync" />
            </div>

            <!-- End Date -->
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small fw-bold text-hub-muted mb-1">📅 End Date</label>
                <input type="date" class="form-control rounded-3 hub-input" @bind="endDate" @bind:after="OnCriteriaChangedAsync" />
            </div>

            <!-- Employee Dropdown -->
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small fw-bold text-hub-muted mb-1">👤 Employee</label>
                <select class="form-select rounded-3 hub-input" @bind="selectedEmployeeId" @bind:after="OnCriteriaChangedAsync">
                    <option value="0">All Employees (@employees.Count)</option>
                    @foreach (var emp in employees.OrderBy(e => e.Name))
                    {
                        <option value="@emp.EmployeeID">@emp.Name (#@emp.EmployeeID)</option>
                    }
                </select>
            </div>

            <!-- Search Box -->
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small fw-bold text-hub-muted mb-1">🔍 Search Telemetry</label>
                <div class="input-group">
                    <span class="input-group-text hub-input border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text"
                           class="form-control rounded-end-3 hub-input border-start-0"
                           placeholder="Filter reason, ID, device..."
                           @bind="searchQuery"
                           @bind:event="oninput"
                           @bind:after="ApplyFilter" />
                </div>
            </div>
        </div>

        <!-- Filter Chips Row -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mt-3 pt-3 border-top">
            <!-- Source Filter Chips -->
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                <span class="small fw-bold text-hub-muted me-2">Modes:</span>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(sourceFilter == null ? "btn-primary" : "btn-outline-secondary")"
                        @onclick="() => SetSourceFilter(null)">
                    All Modes
                </button>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(sourceFilter == PunchSourceTier.PhysicalMachine ? "btn-info text-white" : "btn-outline-info")"
                        @onclick="() => SetSourceFilter(PunchSourceTier.PhysicalMachine)">
                    📟 Physical Machine
                </button>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(sourceFilter == PunchSourceTier.ManualAdmin ? "btn-warning text-dark" : "btn-outline-warning")"
                        @onclick="() => SetSourceFilter(PunchSourceTier.ManualAdmin)">
                    ✍️ Manual Correction
                </button>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(sourceFilter == PunchSourceTier.GeofenceAuto ? "btn-primary" : "btn-outline-primary")"
                        @onclick="() => SetSourceFilter(PunchSourceTier.GeofenceAuto)">
                    📍 Auto Geofence
                </button>
            </div>

            <!-- Status Filter Chips -->
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                <span class="small fw-bold text-hub-muted me-2">Status:</span>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(statusFilter == true ? "btn-success" : "btn-outline-success")"
                        @onclick="() => SetStatusFilter(true)">
                    ✅ Accepted Only
                </button>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(statusFilter == null ? "btn-secondary" : "btn-outline-secondary")"
                        @onclick="() => SetStatusFilter(null)">
                    All (Inc. Duplicates)
                </button>
                <button class="btn btn-sm rounded-pill px-3 py-1 @(statusFilter == false ? "btn-danger" : "btn-outline-danger")"
                        @onclick="() => SetStatusFilter(false)">
                    🚫 Suppressed Only
                </button>
            </div>

            <!-- Direction Filter Chips -->
            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                <span class="small fw-bold text-hub-muted me-2">Direction:</span>
                <button class="btn btn-sm rounded-pill px-2.5 py-1 @(directionFilter == null ? "btn-dark" : "btn-outline-secondary")"
                        @onclick="() => SetDirectionFilter(null)">
                    All
                </button>
                <button class="btn btn-sm rounded-pill px-2.5 py-1 @(directionFilter == "IN" ? "btn-success" : "btn-outline-success")"
                        @onclick='() => SetDirectionFilter("IN")'>
                    📥 IN
                </button>
                <button class="btn btn-sm rounded-pill px-2.5 py-1 @(directionFilter == "OUT" ? "btn-warning text-dark" : "btn-outline-warning")"
                        @onclick='() => SetDirectionFilter("OUT")'>
                    📤 OUT
                </button>
            </div>
        </div>

        <!-- Quick Date Range Presets -->
        <div class="d-flex align-items-center gap-2 flex-wrap mt-3 pt-2">
            <span class="small fw-bold text-hub-muted me-1">⚡ Quick Ranges:</span>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" @onclick="SetDateToday">Today</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" @onclick="SetDateYesterday">Yesterday</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" @onclick="SetDateLast7Days">Last 7 Days</button>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" @onclick="SetDateLast30Days">Last 30 Days</button>
            <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 fw-semibold" @onclick="SetDateOctober2026">
                🗓️ October 2026 (Full Month)
            </button>
        </div>
    </div>

    <!-- View Mode Switcher -->
    <div class="d-flex align-items-center justify-content-between gap-3 mb-3 flex-wrap">
        <ul class="nav nav-pills hub-nav-pills gap-2 p-1 rounded-pill shadow-sm">
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "table" ? "active" : "")"
                        @onclick='() => SetActiveTab("table")'>
                    <i class="bi bi-table me-1.5"></i>
                    <span>Chronological Audit Grid (@(filteredPunches?.Count ?? 0))</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "sequence" ? "active" : "")"
                        @onclick='() => SetActiveTab("sequence")'>
                    <i class="bi bi-diagram-3 me-1.5"></i>
                    <span>Sequence Flow Reconstructor (@dailySummaries.Count Days)</span>
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link rounded-pill @(activeTab == "intelligence" ? "active" : "")"
                        @onclick='() => SetActiveTab("intelligence")'>
                    <i class="bi bi-pie-chart me-1.5"></i>
                    <span>Mode &amp; Rule Intelligence</span>
                </button>
            </li>
        </ul>

        <div class="text-hub-muted small fw-semibold">
            Showing @(filteredPunches?.Count ?? 0) of @totalRawCount punches (@(dailySummaries?.Count ?? 0) employee-days)
        </div>
    </div>

    <!-- Main Content Area -->
    @if (isLoading)
    {
        <div class="text-center p-5 card border-0 shadow-sm rounded-4">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="fw-bold text-hub-title">Running Multi-Mode Punch Telemetry Engine...</h5>
            <p class="text-hub-muted mb-0">Analyzing physical machine logs, manual corrections, and geofence state machines across SQLite and Firebase SSOT.</p>
        </div>
    }
    else if (!filteredPunches.Any())
    {
        <div class="text-center p-5 card border-0 shadow-sm rounded-4">
            <span class="fs-1 d-block mb-3">🔍</span>
            <h4 class="fw-bold text-hub-title">No punches found for the selected criteria</h4>
            <p class="text-hub-muted mb-3">Adjust your date range, employee selector, or filter chips to view punch logs.</p>
            <button class="btn btn-primary rounded-pill px-4 py-2" @onclick="LoadOctoberMatrixPreset">
                🧪 Load October 2026 Test Dataset
            </button>
        </div>
    }
    else
    {
        @if (activeTab == "table")
        {
            <!-- Tab 1: Chronological Table Grid -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 hub-table-card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 hub-table">
                        <thead>
                            <tr>
                                <th style="width: 130px;">📅 Date</th>
                                <th style="width: 110px;">⏰ Time</th>
                                <th style="min-width: 180px;">👤 Employee</th>
                                <th style="width: 120px;">🧭 Direction</th>
                                <th style="min-width: 170px;">⚡ Punch Source</th>
                                <th style="min-width: 150px;">📟 Terminal / ID</th>
                                <th style="width: 140px;">🎯 Result</th>
                                <th style="min-width: 280px;">🧠 Hybrid Rule Reason</th>
                                <th style="width: 80px;" class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var punch in filteredPunches)
                            {
                                <tr class="@(punch.IsAccepted ? "row-accepted" : "row-suppressed")">
                                    <!-- Date -->
                                    <td class="fw-semibold">
                                        @punch.PunchDate.ToString("dd-MMM-yyyy")
                                    </td>

                                    <!-- Time -->
                                    <td>
                                        <span class="fw-bold font-monospace fs-6">
                                            @punch.PunchTime.ToString("HH:mm:ss")
                                        </span>
                                    </td>

                                    <!-- Employee -->
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="emp-avatar rounded-circle d-flex align-items-center justify-content-center fw-bold">
                                                @(string.IsNullOrWhiteSpace(punch.EmployeeName) ? "?" : punch.EmployeeName.Substring(0, 1).ToUpperInvariant())
                                            </div>
                                            <div>
                                                <div class="fw-bold text-hub-title">@punch.EmployeeName</div>
                                                <div class="small text-hub-muted">ID: #@punch.EmployeeId | @(punch.Role ?? "Staff")</div>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Direction (IN vs OUT) -->
                                    <td>
                                        @if (punch.IsIn)
                                        {
                                            <span class="badge badge-in rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                <span>📥</span> <strong>IN</strong>
                                            </span>
                                        }
                                        else if (punch.IsOut)
                                        {
                                            <span class="badge badge-out rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                <span>📤</span> <strong>OUT</strong>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill px-3 py-1.5">
                                                <span>🔄</span> @punch.RawDirection
                                            </span>
                                        }
                                    </td>

                                    <!-- Punch Source Tier -->
                                    <td>
                                        @switch (punch.SourceTier)
                                        {
                                            case PunchSourceTier.PhysicalMachine:
                                                <span class="badge tier-badge-physical rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5">
                                                    <span>📟</span>
                                                    <span>Physical Machine</span>
                                                </span>
                                                break;
                                            case PunchSourceTier.ManualAdmin:
                                                <span class="badge tier-badge-manual rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5">
                                                    <span>✍️</span>
                                                    <span>Manual Correction</span>
                                                </span>
                                                break;
                                            case PunchSourceTier.GeofenceAuto:
                                                <span class="badge tier-badge-auto rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1.5">
                                                    <span>📍</span>
                                                    <span>Android Geofence</span>
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <!-- Terminal / Biometric ID -->
                                    <td>
                                        <div class="text-truncate" style="max-width: 160px;" title="@punch.DeviceId">
                                            <span class="fw-semibold font-monospace small">@punch.DeviceId</span>
                                        </div>
                                        <div class="text-hub-muted font-monospace small text-truncate" style="max-width: 160px;" title="@punch.BiometricId">
                                            @punch.BiometricId
                                        </div>
                                    </td>

                                    <!-- Result -->
                                    <td>
                                        @if (punch.IsAccepted)
                                        {
                                            <span class="badge status-badge-accepted rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-check-circle-fill"></i>
                                                <strong>VALID</strong>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge status-badge-suppressed rounded-pill px-3 py-1.5 d-inline-flex align-items-center gap-1">
                                                <i class="bi bi-slash-circle-fill"></i>
                                                <strong>SUPPRESSED</strong>
                                            </span>
                                        }
                                    </td>

                                    <!-- Hybrid Rule Reason -->
                                    <td>
                                        <div class="d-flex align-items-start gap-1.5">
                                            <span class="rule-reason-text small @(punch.IsAccepted ? "text-success-emphasis" : "text-danger-emphasis")">
                                                @punch.Reason
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Action (Inspect) -->
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary rounded-circle p-1.5"
                                                @onclick="() => InspectPunch(punch)"
                                                title="View detailed telemetry inspector">
                                            <i class="bi bi-info-circle-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (activeTab == "sequence")
        {
            <!-- Tab 2: Sequence Flow Reconstructor -->
            <div class="d-flex flex-column gap-4 mb-4">
                @foreach (var dayGroup in dailySummaries)
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden sequence-card">
                        <!-- Card Header -->
                        <div class="card-header bg-transparent p-3.5 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-2">
                            <div class="d-flex align-items-center gap-3">
                                <div class="emp-avatar-lg rounded-circle d-flex align-items-center justify-content-center fw-bold fs-5">
                                    @(string.IsNullOrWhiteSpace(dayGroup.EmployeeName) ? "?" : dayGroup.EmployeeName.Substring(0, 1).ToUpperInvariant())
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <h5 class="fw-bold mb-0 text-hub-title">@dayGroup.EmployeeName</h5>
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5 py-0.5 small">ID: #@dayGroup.EmployeeId</span>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 py-0.5 small">📅 @dayGroup.Date.ToString("dd-MMM-yyyy (ddd)")</span>
                                        <span class="badge bg-info-subtle text-info rounded-pill px-2.5 py-0.5 small">⏰ Shift: @dayGroup.ShiftName</span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <div class="text-end">
                                    <div class="small text-hub-muted">Effective Work Duration</div>
                                    <div class="fw-bold fs-5 text-success">@FormatHoursToHhMm(dayGroup.TotalValidHoursWorked)</div>
                                </div>
                                @if (dayGroup.OvertimeHours > 0)
                                {
                                    <div class="text-end ps-3 border-start">
                                        <div class="small text-hub-muted">Approved Overtime</div>
                                        <div class="fw-bold fs-5 text-warning">@FormatHoursToHhMm(dayGroup.OvertimeHours)</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Card Body: Sequence Comparison -->
                        <div class="card-body p-4">
                            <!-- Stream 1: Raw Ingest Sequence -->
                            <div class="mb-4">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="fw-bold text-hub-muted mb-0 small text-uppercase letter-spacing-1">
                                        📥 Raw Ingest Stream (@dayGroup.RawPunches.Count raw punches logged)
                                    </h6>
                                    <span class="small text-hub-muted">Chronological order of arrival from all sources</span>
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-wrap p-3 rounded-3 raw-stream-box">
                                    @for (int i = 0; i < dayGroup.RawPunches.Count; i++)
                                    {
                                        var p = dayGroup.RawPunches[i];
                                        <div class="raw-punch-node @(p.IsAccepted ? "node-accepted" : "node-suppressed")"
                                             @onclick="() => InspectPunch(p)"
                                             role="button"
                                             title="Click to inspect: @p.Reason">
                                            <div class="node-time">@p.PunchTime.ToString("HH:mm")</div>
                                            <div class="node-dir">@(p.IsIn ? "IN" : "OUT")</div>
                                            <div class="node-tier">
                                                @switch (p.SourceTier)
                                                {
                                                    case PunchSourceTier.PhysicalMachine:
                                                        <span>📟 Machine</span>
                                                        break;
                                                    case PunchSourceTier.ManualAdmin:
                                                        <span>✍️ Manual</span>
                                                        break;
                                                    case PunchSourceTier.GeofenceAuto:
                                                        <span>📍 Geofence</span>
                                                        break;
                                                }
                                            </div>
                                            @if (!p.IsAccepted)
                                            {
                                                <div class="node-badge-x">🚫</div>
                                            }
                                        </div>

                                        @if (i < dayGroup.RawPunches.Count - 1)
                                        {
                                            <div class="stream-arrow text-hub-muted">→</div>
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Stream 2: Accepted Sequence Flow -->
                            <div>
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <h6 class="fw-bold text-success mb-0 small text-uppercase letter-spacing-1">
                                        ✅ Accepted Sequence Chain (@dayGroup.AcceptedPunches.Count accepted punches)
                                    </h6>
                                    <span class="small text-success fw-semibold">Deterministic IN ↔ OUT Alternating Pairs</span>
                                </div>

                                <div class="d-flex align-items-center gap-2 flex-wrap p-3 rounded-3 accepted-stream-box">
                                    @if (!dayGroup.AcceptedPunches.Any())
                                    {
                                        <div class="text-hub-muted small fst-italic">No valid attendance punches formed for this day.</div>
                                    }
                                    else
                                    {
                                        @for (int i = 0; i < dayGroup.AcceptedPunches.Count; i++)
                                        {
                                            var ap = dayGroup.AcceptedPunches[i];
                                            <div class="accepted-punch-pill @(ap.IsIn ? "pill-in" : "pill-out")"
                                                 @onclick="() => InspectPunch(ap)"
                                                 role="button">
                                                <span class="pill-icon">@(ap.IsIn ? "📥" : "📤")</span>
                                                <span class="pill-time">@ap.PunchTime.ToString("HH:mm")</span>
                                                <span class="pill-dir">@(ap.IsIn ? "IN" : "OUT")</span>
                                                <span class="pill-source">
                                                    @(ap.SourceTier == PunchSourceTier.PhysicalMachine ? "📟 Machine" : (ap.SourceTier == PunchSourceTier.ManualAdmin ? "✍️ Manual" : "📍 Auto"))
                                                </span>
                                            </div>

                                            @if (i < dayGroup.AcceptedPunches.Count - 1)
                                            {
                                                <div class="accepted-chain-link text-success">
                                                    @(i % 2 == 0 ? "— (working session) →" : "··· (break/transit) ···>")
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            </div>

                            <!-- Suppressed Breakdown if any -->
                            @if (dayGroup.SuppressedPunches.Any())
                            {
                                <div class="mt-3 pt-3 border-top">
                                    <div class="d-flex align-items-center gap-2 text-danger small fw-semibold mb-2">
                                        <i class="bi bi-exclamation-circle-fill"></i>
                                        <span>Suppressed Punches In This Day (@dayGroup.SuppressedPunches.Count):</span>
                                    </div>
                                    <div class="d-flex flex-column gap-1.5 ps-3">
                                        @foreach (var sp in dayGroup.SuppressedPunches)
                                        {
                                            <div class="small d-flex align-items-center gap-2">
                                                <span class="badge bg-danger-subtle text-danger rounded-pill px-2 py-0.5 font-monospace">
                                                    @sp.PunchTime.ToString("HH:mm") @(sp.IsIn ? "IN" : "OUT")
                                                </span>
                                                <span class="text-hub-muted font-monospace">(@sp.DeviceId):</span>
                                                <span class="text-hub-title">@sp.Reason</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (activeTab == "intelligence")
        {
            <!-- Tab 3: Mode & Rule Intelligence -->
            <div class="row g-4 mb-4">
                <!-- Source Distribution Card -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h5 class="fw-bold text-hub-title mb-3 d-flex align-items-center gap-2">
                            <span>📊</span>
                            <span>Punch Source Distribution</span>
                        </h5>

                        <div class="d-flex flex-column gap-3">
                            <!-- Physical Machine Bar -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-info d-flex align-items-center gap-1.5">
                                        <span>📟</span> Physical Machine (Tier 1)
                                    </span>
                                    <span class="fw-bold">@physicalCount (@(totalRawCount > 0 ? (physicalCount * 100.0 / totalRawCount).ToString("F1") : "0")%)</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 10px;">
                                    <div class="progress-bar bg-info" style="width: @(totalRawCount > 0 ? (physicalCount * 100.0 / totalRawCount) : 0)%"></div>
                                </div>
                            </div>

                            <!-- Manual Correction Bar -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-warning d-flex align-items-center gap-1.5">
                                        <span>✍️</span> Manual Correction (Tier 2)
                                    </span>
                                    <span class="fw-bold">@manualCount (@(totalRawCount > 0 ? (manualCount * 100.0 / totalRawCount).ToString("F1") : "0")%)</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 10px;">
                                    <div class="progress-bar bg-warning" style="width: @(totalRawCount > 0 ? (manualCount * 100.0 / totalRawCount) : 0)%"></div>
                                </div>
                            </div>

                            <!-- Auto Geofence Bar -->
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-semibold text-primary d-flex align-items-center gap-1.5">
                                        <span>📍</span> Android Auto Geofence (Tier 3)
                                    </span>
                                    <span class="fw-bold">@autoGeofenceCount (@(totalRawCount > 0 ? (autoGeofenceCount * 100.0 / totalRawCount).ToString("F1") : "0")%)</span>
                                </div>
                                <div class="progress rounded-pill" style="height: 10px;">
                                    <div class="progress-bar bg-primary" style="width: @(totalRawCount > 0 ? (autoGeofenceCount * 100.0 / totalRawCount) : 0)%"></div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 p-3 rounded-3 bg-light-subtle border">
                            <h6 class="fw-bold mb-1 small text-uppercase">Hierarchy Resolution Rules</h6>
                            <ul class="small text-hub-muted mb-0 ps-3">
                                <li><strong>Tier 1: Physical Machine</strong> always wins collisions and breaks intermediate sessions.</li>
                                <li><strong>Tier 2: Manual Correction</strong> defines authoritative shifts and suppresses intermediate drift.</li>
                                <li><strong>Tier 3: Auto Geofence</strong> acts as dynamic arrival/departure fallback outside shifts.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Suppression Reasons Card -->
                <div class="col-12 col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                        <h5 class="fw-bold text-hub-title mb-3 d-flex align-items-center gap-2">
                            <span>🛡️</span>
                            <span>Rule Engine Filtering Breakdown</span>
                        </h5>

                        <div class="d-flex flex-column gap-2.5">
                            @foreach (var reasonGroup in GetTopSuppressionReasons())
                            {
                                <div class="d-flex align-items-center justify-content-between p-2.5 rounded-3 bg-light-subtle border">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fs-5">🚫</span>
                                        <div>
                                            <div class="fw-semibold text-hub-title small">@reasonGroup.Category</div>
                                            <div class="text-hub-muted text-xs">@reasonGroup.SampleReason</div>
                                        </div>
                                    </div>
                                    <span class="badge bg-danger rounded-pill px-3 py-1.5 fw-bold">@reasonGroup.Count punches</span>
                                </div>
                            }

                            @if (!GetTopSuppressionReasons().Any())
                            {
                                <div class="text-center p-4 text-hub-muted">
                                    <span>🎉 No punches have been suppressed under current filter criteria!</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

