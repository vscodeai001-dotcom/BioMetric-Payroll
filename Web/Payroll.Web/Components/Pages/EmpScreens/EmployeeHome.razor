@page "/employee-home"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using global::Payroll.Shared.Data
@using Microsoft.EntityFrameworkCore
@using global::Payroll.Web.Components.UI.Leave
@using global::Payroll.Web.Components.UI.Attendance
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Employee Home</PageTitle>

<style>
    .app-tile {
        background: white;
        border: 1px solid #eee;
        border-radius: 16px;
        padding: 1rem;
        text-align: center;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        height: 100%;
        box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    }

    body.dark .app-tile {
        background: #1b222c;
        color: #f3f6fa;
        border-color: #3a4654;
        box-shadow: 0 10px 24px rgba(0,0,0,.22);
    }

    body.dark .app-tile .text-muted,
    body.dark .app-tile small {
        color: #b8c3d0 !important;
    }

        .app-tile:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            border-color: #cce5ff;
        }

    .tile-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin: 0 auto .65rem auto;
    }

    .card-gradient-blue {
        background: linear-gradient(135deg, #0061ff 0%, #60efff 100%);
        color: white;
        border: none;
    }

    .card-gradient-purple {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }

    .employee-summary-card {
        min-height: 205px;
    }

    .employee-dashboard-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        align-items: start;
    }

    .employee-dashboard-summary {
        grid-column: 1;
        margin-bottom: 0 !important;
    }

    .employee-dashboard-quick {
        grid-column: 1;
        grid-row: auto;
    }

    .employee-dashboard-applications {
        grid-column: 1;
    }

</style>

<AuthorizeView>
    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold text-dark mb-0">
                    Hello, @(linkedEmployee?.Name ?? context.User.Identity?.Name)!
                </h2>
                <p class="text-muted mb-0">
                    Welcome to your self-service portal.
                </p>
            </div>

            <div class="d-none d-md-block">
                <span class="badge bg-white text-dark border px-3 py-2 rounded-pill shadow-sm">
                    <i class="bi bi-calendar-check me-2 text-primary"></i>
                    @DateTime.Now.ToString("dd MMMM yyyy")
                </span>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

@if (isLoading)
{
    <div class="text-center p-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Loading your profile...</p>
    </div>
}
else
{
    <div class="employee-dashboard-layout">
    <div class="row g-4 align-items-start employee-overview-row employee-dashboard-summary">

        @* ============================================================
           1. SALARY CARD
           ============================================================ *@

        @if (featureSettings?.EnablePayroll == true &&
            featureSettings?.EmployeeCanViewPayslip == true)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card card-gradient-blue shadow-sm employee-summary-card">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="text-uppercase small fw-bold opacity-75">
                                Current Salary
                            </div>

                            @if (linkedEmployee != null)
                            {
                                <h2 class="fw-bold mb-0 mt-2">
                                    @linkedEmployee.MonthlySalary.ToString(
                                    "C0",
                                                new System.Globalization.CultureInfo("en-IN"))
                    </h2>

                    <small class="opacity-75">
                        / Month (Gross)
                    </small>
                                        }
                        </div>

                        <div class="mt-4">
                            <a href="my-payslips"
                               class="btn btn-light text-primary fw-bold rounded-pill px-4 w-100">
                                View Payslips
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============================================================
           2. LEAVE BALANCES
           ============================================================ *@

        @if (featureSettings?.EnableLeaveManagement == true &&
            featureSettings?.EmployeeCanViewLeave == true)
        {
            <div class="col-md-6 col-xl-4">

                @if (linkedEmployee != null)
                {
                    <div class="card border-0 shadow-sm employee-summary-card">
                        <div class="card-body p-4">

                            <h6 class="fw-bold text-secondary mb-4">
                                Leave Balance
                            </h6>

                            <div class="mb-4">
                                <div class="d-flex justify-content-between align-items-end mb-1">
                                    <span class="fw-bold text-primary">
                                        Paid Leave
                                    </span>

                                    <span class="fw-bold">
                                        @linkedEmployee.PaidLeaveBalance
                                    </span>
                                </div>

                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-primary"
                                         style="width: @(Math.Min(linkedEmployee.PaidLeaveBalance * 10, 100))%">
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-end mb-1">
                                    <span class="fw-bold text-success">
                                        Sick Leave
                                    </span>

                                    <span class="fw-bold">
                                        @linkedEmployee.SickLeaveBalance
                                    </span>
                                </div>

                                <div class="progress" style="height: 8px;">
                                    <div class="progress-bar bg-success"
                                         style="width: @(Math.Min(linkedEmployee.SickLeaveBalance * 10, 100))%">
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                }
                else
                {
                    <div class="card border-0 shadow-sm d-flex align-items-center justify-content-center bg-light">
                        <span class="text-muted">
                            Leave info unavailable
                        </span>
                    </div>
                }

            </div>
        }

        @* ============================================================
           3. QUICK ATTENDANCE
           
           IMPORTANT:
           MobilePunchWidget handles ONLY the punch operation.
           
           Persistent employee GPS is NOT started here.
           EmployeeGpsTracker lives in EmployeeLayout.
           ============================================================ *@

        @if (featureSettings?.EmployeeCanViewAttendance == true)
        {
            <div class="employee-dashboard-quick">

                @if (linkedEmployee != null)
                {
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body p-4">

                            <h6 class="fw-bold text-secondary mb-3">
                                Quick Attendance
                            </h6>

                            <MobilePunchWidget EmployeeId="@linkedEmployee.EmployeeID" EmployeeName="@linkedEmployee.Name" />

                            <div class="mt-3 text-center">
                                <a href="my-attendance"
                                   class="small text-decoration-none fw-bold">
                                    View Attendance Logs &rarr;
                                </a>
                            </div>

                        </div>
                    </div>
                }

            </div>
        }

    </div>

    @* ============================================================
       4. APPLICATION GRID
       ============================================================ *@

    <div class="employee-dashboard-applications">
    <h5 class="fw-bold text-secondary mb-3">
        Applications
    </h5>

    <div class="row g-3 row-cols-2 row-cols-md-3">

        @* Attendance *@
        @if (featureSettings?.EmployeeCanViewAttendance == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-attendance")'>
                    <div class="tile-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Attendance
                    </h6>

                    <small class="text-muted">
                        Logs & History
                    </small>
                </div>
            </div>
        }

        @* Leave *@
        @if (featureSettings?.EnableLeaveManagement == true &&
            featureSettings?.EmployeeCanViewLeave == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-leave-request")'>
                    <div class="tile-icon bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-calendar-plus"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Apply Leave
                    </h6>

                    <small class="text-muted">
                        Request Off
                    </small>
                </div>
            </div>
        }

        @* Payslips *@
        @if (featureSettings?.EnablePayroll == true &&
            featureSettings?.EmployeeCanViewPayslip == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-payslips")'>
                    <div class="tile-icon bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-receipt"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Payslips
                    </h6>

                    <small class="text-muted">
                        Download
                    </small>
                </div>
            </div>
        }

        @* Shifts *@
        @if (featureSettings?.EnableShiftScheduling == true &&
            featureSettings?.EmployeeCanViewShifts == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-shifts")'>
                    <div class="tile-icon bg-info bg-opacity-10 text-info">
                        <i class="bi bi-calendar-range"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Roster
                    </h6>

                    <small class="text-muted">
                        My Shifts
                    </small>
                </div>
            </div>
        }

        @* Salary Advances *@
        @if (featureSettings?.EnableSalaryAdvance == true &&
            featureSettings?.EmployeeCanViewAdvance == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-salary-advances")'>
                    <div class="tile-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-cash"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Advances
                    </h6>

                    <small class="text-muted">
                        Request/View
                    </small>
                </div>
            </div>
        }

        @* Bonuses *@
        @if (featureSettings?.EnableBonusManagement == true &&
            featureSettings?.EmployeeCanViewBonus == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-bonuses")'>
                    <div class="tile-icon bg-success bg-opacity-10 text-success">
                        <i class="bi bi-gift"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Bonuses
                    </h6>

                    <small class="text-muted">
                        History
                    </small>
                </div>
            </div>
        }

        @* Tax *@
        @if (featureSettings?.EnableTaxDeclarations == true &&
            featureSettings?.EmployeeCanViewTax == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-tax-declaration")'>
                    <div class="tile-icon bg-secondary bg-opacity-10 text-secondary">
                        <i class="bi bi-bank"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Tax Proofs
                    </h6>

                    <small class="text-muted">
                        Declarations
                    </small>
                </div>
            </div>
        }

        @* Regularization *@
        @if (featureSettings?.EnablePunchCorrection == true &&
            featureSettings?.EnableRegularizationRequest == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-regularization")'>
                    <div class="tile-icon bg-dark bg-opacity-10 text-dark">
                        <i class="bi bi-tools"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Correction
                    </h6>

                    <small class="text-muted">
                        Fix Punch
                    </small>
                </div>
            </div>
        }

        @* Reports *@
        @if (featureSettings?.EnableCustomReporting == true &&
            featureSettings?.EmployeeCanViewReports == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-reports")'>
                    <div class="tile-icon bg-info bg-opacity-10 text-primary">
                        <i class="bi bi-file-earmark-bar-graph"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Reports
                    </h6>

                    <small class="text-muted">
                        My Stats
                    </small>
                </div>
            </div>
        }

        @* Resignation *@
        @if (featureSettings?.EnableResignationModule == true &&
            featureSettings?.EmployeeCanViewResignation == true)
        {
            <div class="col">
                <div class="app-tile"
                     @onclick='() => Navigation.NavigateTo("my-resignation")'>
                    <div class="tile-icon bg-danger bg-opacity-10 text-danger">
                        <i class="bi bi-door-open"></i>
                    </div>

                    <h6 class="fw-bold text-dark mb-1">
                        Resignation
                    </h6>

                    <small class="text-muted">
                        Exit Process
                    </small>
                </div>
            </div>
        }

        @* Profile / Settings *@
        <div class="col">
            <div class="app-tile"
                 @onclick='() => Navigation.NavigateTo("Identity/Account/Manage")'>
                <div class="tile-icon bg-light text-dark border">
                    <i class="bi bi-person-gear"></i>
                </div>

                <h6 class="fw-bold text-dark mb-1">
                    Settings
                </h6>

                <small class="text-muted">
                    Account
                </small>
            </div>
        </div>

    </div>
    </div>
    </div>
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code
{
    private Employee? linkedEmployee;
    private bool isLoading = true;
    private FeatureSettings? featureSettings;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            var authState =
                await Auth.GetAuthenticationStateAsync();

            var user =
                authState.User;

            if (user.Identity?.IsAuthenticated != true)
            {
                return;
            }

            var email =
                user.Identity.Name;

            if (string.IsNullOrWhiteSpace(email))
            {
                return;
            }

            await using var dbContext =
                await DbFactory.CreateDbContextAsync();

            // ----------------------------------------------------
            // Load feature settings
            // ----------------------------------------------------

            featureSettings =
                await dbContext.FeatureSettings
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        f => f.Id == 1);

            // ----------------------------------------------------
            // Load employee
            // ----------------------------------------------------

            linkedEmployee =
                await dbContext.Employees
                    .AsNoTracking()
                    .FirstOrDefaultAsync(
                        e => e.Email == email);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine(
                $"Employee Home loading failed: {ex}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}