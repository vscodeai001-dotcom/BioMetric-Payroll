@page "/my-bonuses"
@using Microsoft.AspNetCore.Authorization
@using global::Payroll.Shared
@using Microsoft.AspNetCore.Components.Authorization
@inject FirebaseBonusService FirebaseBonuses
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Navigation
@inject IToastService toastService
@attribute [Authorize(Roles = "Employee, SuperAdmin")]

<PageTitle>My Bonuses</PageTitle>

@if (isAccessDenied)
{
    <div class="container mt-5">
        <div class="alert alert-danger shadow-sm" role="alert">
            <h4 class="alert-heading"><i class="bi bi-exclamation-octagon-fill me-2"></i>Access Denied</h4>
            <p>The <strong>Bonus Management</strong> module is currently disabled or you do not have permission to view bonuses.</p>
            <hr>
            <p class="mb-0">Please contact your administrator or <a href="/" class="alert-link">return to the dashboard</a>.</p>
        </div>
    </div>
}
else
{
    <h3>My Bonuses</h3>
    <p>History of performance bonuses and ex-gratia payments received.</p>

    @if (isLoading)
    {
        <p><em>Loading...</em></p>
    }
    else if (bonuses == null || !bonuses.Any())
    {
        <div class="alert alert-info">No bonus records found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in bonuses)
                    {
                        <tr>
                            <td>@b.BonusDate.ToString("dd-MMM-yyyy")</td>
                            <td>@b.Description</td>
                            <td class="text-end fw-bold text-success">@b.Amount.ToString("C", new System.Globalization.CultureInfo("en-IN"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<AttendanceRefreshListener OnAttendanceChanged="HandleRealtimeRefresh" />

@code {
    private List<BonusRecord>? bonuses;
    private bool isLoading = true;
    private bool isAccessDenied = false;

    protected override async Task OnInitializedAsync()
    {
        await CheckPermissionsAndLoadData();
    }

    private async Task CheckPermissionsAndLoadData()
    {
        isLoading = true;
        try
        {
            if (!await FirebaseBonuses.IsEnabledAsync() || !await FirebaseBonuses.CanEmployeeViewAsync())
            {
                isAccessDenied = true;
                return;
            }

            var auth = await AuthState.GetAuthenticationStateAsync();
            var claim = auth.User.FindFirst("employee_id")?.Value;
            if (!int.TryParse(claim, out var employeeId) || employeeId <= 0)
            {
                isAccessDenied = true;
                return;
            }

            bonuses = await FirebaseBonuses.GetAsync(employeeId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Bonus load failed: {ex.Message}");
            bonuses = new List<BonusRecord>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleRealtimeRefresh()
    {
        try
        {
            await CheckPermissionsAndLoadData();
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Realtime refresh failed: {ex}");
        }
    }
}