@using System.Globalization
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@using global::Payroll.Web.Models

@if (PreviewList != null)
{
    <h4>Payroll Preview for @(new DateTime(Year, Month, 1).ToString("MMMM yyyy"))</h4>
    <p>Review the calculations. @(CompanySettings?.EnablePfEsiSystem == true ? "Statutory deductions are applied." : "")</p>

    <div class="table-responsive mb-3">
        <table class="table table-striped table-hover table-sm" style="font-size: 0.9em;">
            <thead class="table-dark">
                <tr>
                    <th>Employee</th>
                    <th class="text-end d-none-mobile">Base Salary</th>
                    <th class="text-end d-none-mobile">Hourly Rate</th>
                    <th class="text-center d-none-mobile">Leave/Absent</th>
                    <th class="text-center d-none-mobile">Earned (HH:MM)</th>
                    <th class="text-end">Earned Pay</th>

                    @* --- STATUTORY DEDUCTIONS (PF/ESI/PT) --- *@
                    @if (CompanySettings?.EnablePfEsiSystem == true)
                    {
                        <th class="text-end text-warning" title="Provident Fund">PF</th>
                        <th class="text-end text-warning" title="Employee State Insurance">ESI</th>
                    }
                    @if (CompanySettings?.EnableProfessionalTax == true)
                    {
                        <th class="text-end text-info" title="Professional Tax">PT</th>
                    }

                    @* --- NEW: TDS HEADER --- *@
                    @if (CompanySettings?.EnableTdsDeduction == true)
                    {
                        <th class="text-end text-danger" title="Tax Deduction at Source">TDS</th>
                    }

                    <th class="text-center d-none-mobile">Penalty (HH:MM)</th>
                    <th class="text-end">Penalty Ded.</th>

                    <th class="text-center d-none-mobile">OT (HH:MM)</th>
                    <th class="text-end">OT Pay</th>

                    @* --- SHIFT ALLOWANCE HEADER --- *@
                    @if (CompanySettings?.EnableShiftAllowance == true)
                    {
                        <th class="text-end text-primary">Night Allow.</th>
                    }

                    <th class="text-end">Advance Ded.</th>
                    <th class="text-end">Bonus</th>
                    <th class="text-end ">Net Payable</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var row in PreviewList)
                {
                    <tr>
                        <td>@row.EmployeeName</td>
                        <td class="text-end d-none-mobile">@(row.BaseSalary.HasValue && row.BaseSalary > 0 ? row.BaseSalary.Value.ToString("C", InrCulture) : "---")</td>
                        <td class="text-end d-none-mobile">@row.HourlyRate.ToString("C", InrCulture)</td>
                        <td class="text-center d-none-mobile" title="Manual Leave / Absent Days">@($"M:{row.LeaveDays} / A:{row.AbsentDays}")</td>

                        <td class="text-center d-none-mobile">@FormatTimeSpan(TimeSpan.FromHours((double)row.EarnedStandardHours))</td>
                        <td class="text-end">@row.EarnedPay.ToString("C", InrCulture)</td>

                        @* --- STATUTORY BODY --- *@
                        @if (CompanySettings?.EnablePfEsiSystem == true)
                        {
                            <td class="text-end text-muted">@(row.IsPfEnabled? row.PfDeduction.ToString("N0") : "--")</td>
                            <td class="text-end text-muted">@(row.IsEsiEnabled? row.EsiDeduction.ToString("N0") : "--")</td>
                        }
                        @if (CompanySettings?.EnableProfessionalTax == true)
                        {
                            <td class="text-end text-muted">@row.PtDeduction.ToString("N0")</td>
                        }

                        @* --- NEW: TDS BODY --- *@
                        @if (CompanySettings?.EnableTdsDeduction == true)
                        {
                            <td class="text-end text-danger">(@row.TdsDeduction.ToString("N0"))</td>
                        }

                        <td class="text-center d-none-mobile">@FormatTimeSpan(row.PenaltyDuration)</td>
                        <td class="text-end text-danger">(@row.PenaltyDeduction.ToString("C", InrCulture))</td>

                        <td class="text-center d-none-mobile">@FormatTimeSpan(row.OvertimeDuration)</td>
                        <td class="text-end">@row.OvertimePay.ToString("C", InrCulture)</td>

                        @* --- SHIFT ALLOWANCE BODY --- *@
                        @if (CompanySettings?.EnableShiftAllowance == true)
                        {
                            <td class="text-end text-primary">@row.TotalShiftAllowance.ToString("N0")</td>
                        }

                        <td class="text-end text-danger">(@row.AdvanceDeduction.ToString("C", InrCulture))</td>
                        <td class="text-end" style="width: 120px;">
                            <input type="number"
                                   class="form-control form-control-sm text-end"
                                   @bind="row.Bonus"
                                   @bind:event="oninput"
                                   @onchange="() => OnBonusChanged.InvokeAsync(row)"
                                   step="0.01" min="0" />
                        </td>

                        <td class="text-end "><strong>@row.NetPayable.ToString("C", InrCulture)</strong></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-end">
        <button class="btn btn-success btn-lg" @onclick="OnSave" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm"></span>
                <span> Saving...</span>
            }
            else
            {
                <span class="bi bi-save"></span>
                <span> Save & Finalize Payroll</span>
            }
        </button>
    </div>
}

@code {
    [Parameter] public List<global::Payroll.Web.Models.PayrollDisplayRow>? PreviewList { get; set; }
    [Parameter] public global::Payroll.Shared.Data.CompanySetting? CompanySettings { get; set; }
    [Parameter] public int Month { get; set; }
    [Parameter] public int Year { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback<global::Payroll.Web.Models.PayrollDisplayRow> OnBonusChanged { get; set; }

    private CultureInfo InrCulture = new CultureInfo("en-IN");
    private string FormatTimeSpan(TimeSpan ts) => $"{Math.Floor(ts.TotalHours):00}:{ts.Minutes:00}";
}