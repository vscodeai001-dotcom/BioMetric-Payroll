@using global::Payroll.Shared.Data

<div class="row">
    <div class="col-md-6 border-end">
        <h6 class="text-primary border-bottom pb-2 mb-3">Company Details</h6>
        <div class="mb-2"><label class="small fw-bold">Company Name</label> <input class="form-control form-control-sm" @bind="Settings.CompanyName" /></div>
        <div class="mb-2"><label class="small fw-bold">Address Line 1</label> <input class="form-control form-control-sm" @bind="Settings.AddressLine1" /></div>
        <div class="mb-2"><label class="small fw-bold">City, State, Pincode</label> <input class="form-control form-control-sm" @bind="Settings.CityStatePincode" /></div>
    </div>
   
    <div class="col-md-6">
        <h6 class="text-info border-bottom pb-2 mb-3">Payroll Rules & Device</h6>

        <div class="row g-2 mb-3">
            <div class="col-12">
                <label class="small fw-bold">Calc. Method</label>
                <select class="form-select form-select-sm" @bind="Settings.SalaryCalculationMethod">
                    <option value="Days in Month">Days in Month</option>
                    <option value="Fixed 30-Day">Fixed 30-Day</option>
                    <option value="Pro-Rata Hourly">Pro-Rata Hourly</option>
                </select>
            </div>
            <div class="col-4">
                <label class="small fw-bold">Cutoff Hr</label>
                <input type="number" class="form-control form-control-sm" @bind="Settings.WorkDayCutoffHour" placeholder="22" />
            </div>
            <div class="col-4">
                <label class="small fw-bold">Late Grace</label>
                <input type="number" class="form-control form-control-sm" @bind="Settings.LateGraceMinutes" placeholder="Mins" />
            </div>
            <div class="col-4">
                <label class="small fw-bold">Early Grace</label>
                <input type="number" class="form-control form-control-sm" @bind="Settings.EndTimeGraceMinutes" placeholder="Mins" />
            </div>
            <div class="col-12">
                <div class="border rounded p-2 bg-body-tertiary">
                    <label class="small fw-bold text-primary">GPS Playback Capture Interval</label>
                    <select class="form-select form-select-sm" value="@TrackingIntervalSeconds" @onchange="OnTrackingIntervalChanged">
                        <option value="30">30 seconds</option>
                        <option value="60">1 minute</option>
                        <option value="120">2 minutes</option>
                        <option value="300">5 minutes</option>
                    </select>
                    <small class="text-muted">Controls recorded GPS history/playback sampling. Live map updates remain independent.</small>
                </div>
            </div>
            <div class="col-12">
                <div class="border rounded p-2 bg-body-tertiary">
                    <label class="small fw-bold text-primary">Scheduled Auto-Backup Interval</label>
                    <select class="form-select form-select-sm" @bind="Settings.AutoBackupIntervalHours">
                        <option value="1">1 hour</option>
                        <option value="6">6 hours</option>
                        <option value="12">12 hours</option>
                        <option value="24">24 hours (1 Day) - Default</option>
                        <option value="48">48 hours (2 Days)</option>
                        <option value="168">7 Days (Weekly)</option>
                    </select>
                    <small class="text-muted">Controls scheduled automatic database backups. Default: 24 hours.</small>
                </div>
            </div>
            <div class="col-12">
                <div class="border rounded p-2 bg-body-tertiary">
                    <label class="small fw-bold text-primary">Location Stay Minimum Dwell Time</label>
                    <select class="form-select form-select-sm" @bind="Settings.StayDwellMinutes">
                        <option value="2">2 minutes</option>
                        <option value="5">5 minutes</option>
                        <option value="10">10 minutes (Default)</option>
                        <option value="30">30 minutes</option>
                        <option value="60">1 hour</option>
                        <option value="120">2 hours</option>
                        <option value="300">5 hours</option>
                        <option value="720">12 hours</option>
                        <option value="1440">24 hours</option>
                    </select>
                    <small class="text-muted">Minimum duration an employee must halt within the cluster radius to be recorded as a stay.</small>
                </div>
            </div>
            <div class="col-12">
                <div class="border rounded p-2 bg-body-tertiary">
                    <label class="small fw-bold text-primary">Location Stay Cluster Radius</label>
                    <select class="form-select form-select-sm" @bind="Settings.StayClusterRadiusMeters">
                        <option value="5">5 metres</option>
                        <option value="10">10 metres</option>
                        <option value="15">15 metres</option>
                        <option value="20">20 metres</option>
                        <option value="30">30 metres</option>
                        <option value="50">50 metres (Default)</option>
                        <option value="100">100 metres</option>
                        <option value="200">200 metres</option>
                    </select>
                    <small class="text-muted">Distance threshold to cluster consecutive GPS points into a single stationary halt.</small>
                </div>
            </div>
            <div class="row g-2 border-top pt-2 mt-2">
                <div class="col-12 mb-1">
                    <label class="small fw-bold text-primary">Geo-Fencing (Office Location)</label>
                    <a href="https://www.google.com/maps" target="_blank" class="float-end small text-decoration-none"><i class="bi bi-map"></i> Open Maps</a>
                </div>
                <div class="col-4">
                    <label class="small fw-bold">Latitude</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="Settings.OfficeLatitude" placeholder="12.xxx" />
                </div>
                <div class="col-4">
                    <label class="small fw-bold">Longitude</label>
                    <input type="number" step="any" class="form-control form-control-sm" @bind="Settings.OfficeLongitude" placeholder="80.xxx" />
                </div>
                <div class="col-4">
                    <label class="small fw-bold">Radius (m)</label>
                    <input type="number" class="form-control form-control-sm" @bind="Settings.GeoRadiusMeters" placeholder="100" />
                </div>
            </div>
        </div>

        <div class="row g-2 border-top pt-2">
            <div class="col-6">
                <label class="small fw-bold">Device IP</label>
                <input class="form-control form-control-sm" @bind="Settings.ZktecoIP" />
            </div>
            <div class="col-3">
                <label class="small fw-bold">Port</label>
                <input type="number" class="form-control form-control-sm" @bind="Settings.ZktecoPort" />
            </div>
            <div class="col-3">
                <label class="small fw-bold">Machine No</label>
                <input type="number" class="form-control form-control-sm" @bind="Settings.ZktecoMachineNumber" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public CompanySetting Settings { get; set; } = new();
    [Parameter] public int TrackingIntervalSeconds { get; set; } = 30;
    [Parameter] public EventCallback<int> TrackingIntervalSecondsChanged { get; set; }

    private async Task OnTrackingIntervalChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var seconds))
            await TrackingIntervalSecondsChanged.InvokeAsync(seconds);
    }
}