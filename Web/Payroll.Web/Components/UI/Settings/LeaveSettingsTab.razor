@using Microsoft.EntityFrameworkCore
@using global::Payroll.Shared.Data
@using global::Payroll.Shared.Services
@inject IToastService toastService
@inject IDbContextFactory<AppDbContext> DbFactory

@if (Features?.EnableLeaveManagement != true && !IsSuperAdmin)
{
    <div class="alert alert-warning">
        <i class="bi bi-lock-fill me-2"></i> Leave Management Module is disabled.
    </div>
}
else
{
    <div class="row">
        @* --- LEFT COL: RULES CONFIGURATION --- *@
        <div class="col-md-5 border-end">
            <h5 class="text-primary mb-3">Leave Rules</h5>

            @{
                bool anyRuleVisible = false;
            }

            @* --- ACCRUAL RULE --- *@
            @if (IsSuperAdmin || Features?.EnableLeaveAccrual == true)
            {
                anyRuleVisible = true;
                <div class="card bg-light border-0 mb-3 shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark">Automatic Accrual</h6>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableLeaveAccrual">
                                <disabled="@(!Settings.EnableLeaveManagement)" id="c_accrual" />
                                <label class="form-check-label" for="c_accrual">Leave Accrual (Credits)</label>
                            </div>
                        </div>
                        <div class="mb-2">
                            <label class="small fw-bold text-secondary">Days Credited Monthly</label>
                            <input type="number" step="0.1" class="form-control form-control-sm" @bind="Settings.LeaveAccrualRate" disabled="@(!Settings.EnableLeaveAccrual)" />
                            <small class="text-muted" style="font-size:0.75em">Typically 1.5 days/month.</small>
                        </div>
                    </div>
                </div>
            }

            @* --- SANDWICH RULE --- *@
            @if (IsSuperAdmin || Features?.EnableSandwichRule == true)
            {
                anyRuleVisible = true;
                <div class="card bg-light border-0 shadow-sm">
                    <div class="card-body p-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold mb-0 text-dark">Sandwich Rule</h6>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="Settings.EnableSandwichRule">
                                <disabled="@(!Settings.EnableLeaveManagement)" id="c_sandwich" />
                                <label class="form-check-label" for="c_sandwich">Sandwich Rule Logic</label>
                            </div>
                        </div>
                        <p class="small text-muted mb-0">
                            If enabled, weekends/holidays sandwiched between two leave days will be deducted from the leave balance.
                        </p>
                    </div>
                </div>
            }

            @* --- FALLBACK IF NO RULES VISIBLE --- *@
            @if (!anyRuleVisible)
            {
                <div class="alert alert-light border text-center text-muted">
                    <i class="bi bi-info-circle d-block fs-4 mb-2"></i>
                    No advanced rules (Accrual/Sandwich) are enabled. <br/>
                    <small>Employees can still apply for leave manually.</small>
                </div>
            }
        </div>

        @* --- RIGHT COL: EMPLOYEE BALANCES MANAGER --- *@
        <div class="col-md-7">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-secondary mb-0">Employee Balances</h5>
                <button class="btn btn-sm btn-success" @onclick="SaveBalances" disabled="@isSavingBalances">
                    @if (isSavingBalances)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <i class="bi bi-save me-1"></i>
                    }
                    Update Balances
                </button>
            </div>

            <div class="alert alert-info py-2 px-3 small mb-3">
                <i class="bi bi-info-circle-fill me-2"></i> 
                Use this table to manually adjust opening balances or correct discrepancies.
            </div>

            @if (isLoadingEmployees)
            {
                <p class="text-center text-muted my-5"><em>Loading employee list...</em></p>
            }
            else
            {
                <div class="table-responsive border rounded bg-white" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-sm table-hover small mb-0 align-middle">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th class="ps-3">Employee</th>
                                <th style="width: 120px;">Paid Bal</th>
                                <th style="width: 120px;">Sick Bal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Employees)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <strong>@emp.Name</strong><br />
                                        <span class="text-muted" style="font-size:0.85em">ID: @emp.BiometricID</span>
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" class="form-control form-control-sm text-end" @bind="emp.PaidLeaveBalance" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.5" class="form-control form-control-sm text-end" @bind="emp.SickLeaveBalance" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public CompanySetting Settings { get; set; } = new();
    [Parameter] public FeatureSettings? Features { get; set; }
    [Parameter] public bool IsSuperAdmin { get; set; }

    private List<Employee> Employees = new();
    private bool isLoadingEmployees = false;
    private bool isSavingBalances = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployees();
    }

    private async Task LoadEmployees()
    {
        // Only load if module is enabled OR user is SuperAdmin
        if (Features?.EnableLeaveManagement != true && !IsSuperAdmin) return;

        isLoadingEmployees = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();
            Employees = await dbContext.Employees
                .Where(e => !e.TerminationDate.HasValue) // Active Only
                .OrderBy(e => e.Name)
                .ToListAsync();
        }
        catch (Exception) { /* Ignore for UI component */ }
        finally { isLoadingEmployees = false; }
    }

    private async Task SaveBalances()
    {
        isSavingBalances = true;
        try
        {
            await using var dbContext = await DbFactory.CreateDbContextAsync();

            foreach (var emp in Employees)
            {
                dbContext.Employees.Attach(emp);
                dbContext.Entry(emp).Property(e => e.PaidLeaveBalance).IsModified = true;
                dbContext.Entry(emp).Property(e => e.SickLeaveBalance).IsModified = true;
            }

            await dbContext.SaveChangesAsync();
            toastService.ShowSuccess("Employee leave balances updated.");
        }
        catch (Exception ex)
        {
            toastService.ShowError($"Error updating balances: {ex.Message}");
        }
        finally
        {
            isSavingBalances = false;
        }
    }
}