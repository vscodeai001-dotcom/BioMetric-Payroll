@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Routing 
@using Microsoft.AspNetCore.Mvc.Infrastructure 
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject IUrlHelperFactory UrlHelperFactory 
@inject IActionContextAccessor ActionContextAccessor 


<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(HttpContextAccessor.HttpContext!.User))
    {
        <li class="nav-item">
            <a id="manage" class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Manage" title="Manage">Hello @(UserManager.GetUserName(HttpContextAccessor.HttpContext!.User)!)!</a>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@(UrlHelperFactory.GetUrlHelper(ActionContextAccessor.ActionContext!).Page("/Index", new { area = "" }) ?? "/")">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>