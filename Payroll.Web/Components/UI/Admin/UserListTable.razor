@using global::Payroll.Web.Models
@using Microsoft.AspNetCore.Components.Web

<div class="card shadow-sm h-100">
    <div class="card-body">
        <h5 class="text-primary border-bottom pb-2 mb-3">Existing Users</h5>

        @if (IsLoading)
        {
            <p><em>Loading users...</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Email</th>
                            <th>Employee</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!UserList.Any())
                        {
                            <tr><td colspan="4"><em>No users found.</em></td></tr>
                        }

                        @foreach (var user in UserList.OrderBy(u => u.Email))
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@user.EmployeeName</td>
                                <td>
                                    <span class="badge @(user.CurrentRole == "SuperAdmin" ? "bg-danger" :
                                                                                                   user.CurrentRole == "Admin" ? "bg-info text-dark" :
                                                                                                   "bg-primary")">
                                        @user.CurrentRole
                                    </span>
                                </td>

                                <td style="white-space:nowrap;">
                                    <button class="btn btn-sm btn-outline-primary me-1"
                                            @onclick="() => HandleEditClick(user)" disabled="@IsSaving">
                                        <i class="bi bi-person-badge"></i>
                                    </button>

                                    @if (user.CurrentRole != "SuperAdmin")
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => OnDeleteUser.InvokeAsync(user)" disabled="@IsSaving">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (ShowEditRoleModal && UserToEditRole != null)
{
    <div class="modal fade show" style="display:block;background:#00000088;">
        <div class="modal-dialog modal-sm modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Edit Role – @UserToEditRole.Email</h5>
                    <button class="btn-close" @onclick="OnCloseEditRole" disabled="@IsSaving"></button>
                </div>

                <div class="modal-body">
                    <label>New Role</label>
                    <select class="form-select" @bind="NewRoleForUser">
                        <option>Employee</option>
                        <option>Admin</option>
                        <option>SuperAdmin</option>
                    </select>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="OnCloseEditRole" disabled="@IsSaving">Cancel</button>
                    <button class="btn btn-primary" @onclick="UpdateRole" disabled="@IsSaving">Update</button>
                </div>

            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public List<UserRoleViewModel> UserList { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public bool IsSaving { get; set; }

    [Parameter] public EventCallback<UserRoleViewModel> OnEditRoleRequested { get; set; }
    [Parameter] public EventCallback<UserRoleViewModel> OnDeleteUser { get; set; }
    [Parameter] public EventCallback UpdateUserRole { get; set; }

    [Parameter] public bool ShowEditRoleModal { get; set; }
    [Parameter] public EventCallback<bool> ShowEditRoleModalChanged { get; set; }

    [Parameter] public UserRoleViewModel? UserToEditRole { get; set; }
    [Parameter] public EventCallback<UserRoleViewModel?> UserToEditRoleChanged { get; set; }

    [Parameter] public string NewRoleForUser { get; set; } = "Employee";
    [Parameter] public EventCallback<string> NewRoleForUserChanged { get; set; }

    private async Task HandleEditClick(UserRoleViewModel user)
    {
        await OnEditRoleRequested.InvokeAsync(user);
    }

    private async Task OnCloseEditRole()
    {
        await ShowEditRoleModalChanged.InvokeAsync(false);
        await UserToEditRoleChanged.InvokeAsync(null);
    }

    private async Task UpdateRole()
    {
        await UpdateUserRole.InvokeAsync();
    }
}