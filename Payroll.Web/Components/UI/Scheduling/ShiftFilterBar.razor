@using global::Payroll.Shared.Data
@using Microsoft.AspNetCore.Components.Forms

<div class="row p-3 mb-3 border rounded bg-light align-items-end">
    <div class="col-md-4">
        <label class="form-label small fw-bold">Filter by Employee</label>
        <select class="form-select form-select-sm" @bind="FilterEmployeeId">
            <option value="0">-- All Employees --</option>
            @if (Employees != null)
            {
                @foreach (var emp in Employees)
                {
                    <option value="@emp.EmployeeID">@emp.Name</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-bold">Filter Start Date</label>
        <input type="date" class="form-control form-control-sm" @bind="CurrentStartDate" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <label class="form-label small fw-bold">Filter End Date</label>
        <input type="date" class="form-control form-control-sm" @bind="CurrentEndDate" @bind:event="oninput" />
    </div>
    <div class="col-md-2">
        <button class="btn btn-primary btn-sm w-100" @onclick="OnSearch" disabled="@IsLoading">
            @if (IsLoading)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-search"></i>
            }
            Search
        </button>
    </div>
</div>

@code {
    [Parameter] public List<Employee>? Employees { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnSearch { get; set; }

    // Two-way binding for Employee ID
    [Parameter] public int FilterEmployeeId { get; set; }
    [Parameter] public EventCallback<int> FilterEmployeeIdChanged { get; set; }

    // Two-way binding for Start Date
    [Parameter] public DateTime? StartDate { get; set; }
    [Parameter] public EventCallback<DateTime?> StartDateChanged { get; set; }

    // Two-way binding for End Date
    [Parameter] public DateTime? EndDate { get; set; }
    [Parameter] public EventCallback<DateTime?> EndDateChanged { get; set; }

    // Helper properties for safe binding and invoking change events
    private DateTime? CurrentStartDate
    {
        get => StartDate;
        set => StartDateChanged.InvokeAsync(value);
    }
    private DateTime? CurrentEndDate
    {
        get => EndDate;
        set => EndDateChanged.InvokeAsync(value);
    }
}