@using global::Payroll.Shared
@using global::Payroll.Shared.Data

<div class="card shadow-sm">
    <div class="card-body">
        @if (IsLoading)
        {
            <p><em>Loading schedules...</em></p>
        }
        else if (ScheduleList == null || !ScheduleList.Any())
        {
            <p class="text-muted"><em>No schedules found for the selected filters.</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Scheduled Shift</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var schedule in ScheduleList.OrderBy(s => s.ShiftDate).ThenBy(s => s.StartTime))
                        {
                            <tr>
                                <td>@(Employees?.FirstOrDefault(e => e.EmployeeID == schedule.EmployeeID)?.Name ?? "Unknown")</td>
                                <td>
                                    @if (schedule.IsRecurringPattern)
                                    {
                                        <span class="fw-bold text-info">Pattern: @schedule.AppliesToDayOfWeek</span> @* <-- NEW: Show DayOfWeek for Pattern *@
                                    }
                                    else
                                    {
                                        @schedule.ShiftDate.ToString("dd-MMM-yyyy (ddd)")@* <-- EXISTING: Show specific date *@
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@schedule.StartTime.ToString("hh:mm tt") - @schedule.EndTime.ToString("hh:mm tt")</span>
                                    @if (schedule.IsRecurringPattern)
                                    {
                                        <span class="badge bg-warning text-dark ms-2">RECURRING</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(schedule)" title="Delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<ShiftSchedule>? ScheduleList { get; set; }
    [Parameter] public List<Employee>? Employees { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<ShiftSchedule> OnDelete { get; set; }
}