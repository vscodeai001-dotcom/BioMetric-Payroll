@using System.Globalization
@using global::Payroll.Shared
@using global::Payroll.Shared.Data

<h5>Unpaid Advances</h5>
<p class="text-muted small">Advances shown here will be deducted in the next payroll run.</p>

@if (IsLoading)
{
    <p><em>Loading unpaid advances...</em></p>
}
else if (UnpaidAdvances == null || !UnpaidAdvances.Any())
{
    <p><em>No unpaid advances found for the selected filters.</em></p>
}
else
{
    <table class="table table-sm table-striped">
        <thead class="table-dark">
            <tr>
                <th>Employee</th>
                <th>Date</th>
                <th>Type</th>
                <th class="text-end">Amount</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var advance in UnpaidAdvances.OrderBy(a => a.AdvanceDate))
            {
                <tr>
                    <td>
                        @(Employees?.FirstOrDefault(e => e.EmployeeID == advance.EmployeeID)?.Name ?? "Unknown")
                    </td>
                    <td>@advance.AdvanceDate?.ToString("dd-MMM-yyyy")</td>
                    <td>@advance.AdvanceType</td>
                    <td class="text-end">@advance.Amount.ToString("C", InrCulture)</td>
                    <td>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OnDeleteAdvance.InvokeAsync(advance)">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Parameter] public List<SalaryAdvance>? UnpaidAdvances { get; set; }
    [Parameter] public List<Employee>? Employees { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback<SalaryAdvance> OnDeleteAdvance { get; set; }

    private CultureInfo InrCulture = new CultureInfo("en-IN");
}