@using global::Payroll.Shared.Data

<div class="card mb-4 shadow-sm">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0"><i class="bi bi-wallet2 me-2"></i> Leave Balances</h5>
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-6 border-end">
                <h2 class="text-primary mb-0">@Employee?.PaidLeaveBalance.ToString("0.0")</h2>
                <small class="text-muted fw-bold">PAID LEAVE</small>
            </div>
            <div class="col-6">
                <h2 class="text-success mb-0">@Employee?.SickLeaveBalance.ToString("0.0")</h2>
                <small class="text-muted fw-bold">SICK LEAVE</small>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Employee? Employee { get; set; }
}