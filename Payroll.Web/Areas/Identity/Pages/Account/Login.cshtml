@page
@model Payroll.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-center">
    <div class="col-12 col-sm-9 col-md-6 col-lg-5 identity-login-shell">
        <div class="card shadow-sm border-0 identity-login-card">
            <div class="card-body p-4">
                <h1 class="h4 mb-4">Log in</h1>

                <form method="post">
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Password" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input type="hidden" name="Input.RememberMe" value="false" />
                        <input id="rememberMe" name="Input.RememberMe" type="checkbox" class="form-check-input" value="true" checked="@(Model.Input.RememberMe ? "checked" : null)" />
                        <label for="rememberMe" class="form-check-label">Remember me</label>
                    </div>

                    @if (Model.ShowForceLogout)
                    {
                        <div class="alert alert-warning" role="alert">
                            This account is active on another device. Check the option below only if you want to log out that device and continue here.
                        </div>
                        <div class="form-check mb-3">
                            <input asp-for="ForceLogoutExisting" class="form-check-input" />
                            <label asp-for="ForceLogoutExisting" class="form-check-label">Log out previous device and continue</label>
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100">Log in</button>
                </form>
            </div>
        </div>
    </div>
</div>

