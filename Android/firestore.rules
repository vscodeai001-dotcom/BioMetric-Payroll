rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN'];
    }

    // Legacy profile mirror. No public reads or collection listing.
    match /userProfiles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role in ['STAFF', 'ADMIN', 'SUPER_ADMIN'];
      allow update: if isSignedIn() && (isAdmin() ||
        (request.auth.uid == uid && request.resource.data.uid == uid &&
         request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }

    // Legacy route replay collection. Employees can create/read only their own
    // route points; Admin/SuperAdmin can read the collection for replay.
    match /location_tracking/{trackId} {
      allow create: if isSignedIn() &&
        request.resource.data.staffId == request.auth.uid;
      allow read: if isSignedIn() &&
        (isAdmin() || resource.data.staffId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // All other Firestore paths are denied. Firebase RTDB is the application SSOT.
  }
}
