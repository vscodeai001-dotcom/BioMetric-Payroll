    <string name="title_reliability_setup">Reliability Setup 🛰️</string>
    <string name="desc_reliability_setup">To ensure accurate 24/7 tracking, please complete these essential steps.</string>
    <string name="step_location_title">Always Tracking 🛰️</string>
    <string name="step_location_desc">Enable \"Allow all the time\" location access to keep your work status accurate even in background.</string>
    <string name="step_battery_title">Continuous Power ⚡</string>
    <string name="step_battery_desc">Exempt BioMetric from battery optimization to prevent the system from stopping the tracker.</string>
    <string name="step_permission_title">Permission Lock 🛡️</string>
    <string name="step_permission_desc">Disable \"Remove permissions if app is unused\" to ensure tracking never stops unexpectedly.</string>
    <string name="btn_configure">Configure</string>
    <string name="btn_finish_setup">Finish Setup ✨</string>
    <string name="msg_setup_complete">Reliability setup completed successfully! ✅</string>

