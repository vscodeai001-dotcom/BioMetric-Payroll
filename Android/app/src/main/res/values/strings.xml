    <string name="troubleshoot_step_bg_location_desc">Must be set to \"Allow all the time\" for 24/7 background tracking.</string>
    <string name="troubleshoot_step_bg_usage_title">Unrestricted Data/Battery</string>
    <string name="troubleshoot_step_bg_usage_desc">Ensure \"Allow background usage\" is ON to prevent tracking from being paused.</string>
    <string name="troubleshoot_step_alarms_title">Alarms</string>
    <string name="troubleshoot_step_alarms_desc">Required to maintain tracking frequency and background sync.</string>
    <string name="troubleshoot_step_battery_title">Disable Battery Optimization</string>
    <string name="troubleshoot_step_battery_desc">Required to run in the background 24/7/365.</string>
