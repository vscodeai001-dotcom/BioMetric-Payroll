    <string name="troubleshoot_step_notifications_title">Notifications</string>
    <string name="troubleshoot_step_notifications_desc">Required to alert on tracking status and system updates.</string>
    <string name="troubleshoot_step_gps_title">Location Services (GPS)</string>
    <string name="troubleshoot_step_gps_desc">Required to accurately track your workspace presence.</string>
