<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PremiumCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon, Staff Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/red_light"
                android:gravity="center"
                android:text="🚪"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Vikram Seth" />

                <TextView
                    android:id="@+id/tvStaffMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Staff ID #104 • Submitted 12 Oct 2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/amber_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING"
                android:textColor="@color/amber_900"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PENDING" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:alpha="0.25"
            android:background="?attr/colorOutlineVariant" />

        <!-- Resignation Reason -->
        <TextView
            android:id="@+id/tvReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            tools:text="Reason: Relocation to hometown for family responsibilities." />

        <!-- Timeline / Dates -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDesiredLastDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.75"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                tools:text="Desired Exit: 15 Nov 2026" />

            <TextView
                android:id="@+id/tvApprovedLastDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_700"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Approved Last Day: 15 Nov 2026"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Bottom Action Row -->
        <LinearLayout
            android:id="@+id/llActionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <!-- Step 1 Button: Review & Approve -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReviewApproval"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="14dp"
                android:text="📝 Review &amp; Approve"
                android:textSize="11sp"
                app:cornerRadius="18dp" />

            <!-- Step 2 Button: Calculate FnF -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateFnF"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/green_700"
                android:paddingHorizontal="14dp"
                android:text="💰 Calculate &amp; Settle FnF"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:visibility="gone"
                app:cornerRadius="18dp"
                tools:visibility="visible" />

            <!-- Settled Tag -->
            <TextView
                android:id="@+id/tvSettledNotice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/green_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🏁 SETTLED &amp; CLOSED"
                android:textColor="@color/green_700"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
