<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_background"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="4dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="Live Staff Operations 🛰️" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <HorizontalScrollView
            android:id="@+id/filterScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="?attr/colorSurface"
            android:elevation="4dp"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    app:singleSelection="true"
                    app:selectionRequired="true">
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="All"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLive"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStale"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stale" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOffline"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offline" />
                </com.google.android.material.chip.ChipGroup>

                <View android:layout_width="1dp" android:layout_height="24dp" android:background="@color/divider" android:layout_gravity="center_vertical" android:layout_marginHorizontal="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="180dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    app:hintEnabled="false"
                    app:startIconDrawable="@drawable/ic_search"
                    app:startIconTint="@color/text_secondary"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:endIconMode="clear_text">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMapSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Search staff..."
                        android:textSize="12sp"
                        android:padding="8dp"
                        android:background="@android:color/transparent"
                        android:maxLines="1"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectedLocationRail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="7dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/filterScroll">

            <HorizontalScrollView
                android:id="@+id/selectedLocationRailScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="ifContentScrolls"
                android:background="@drawable/bg_premium_card">

                <LinearLayout
                    android:id="@+id/selectedLocationRail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="7dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardSelectedEmployee"
                        android:layout_width="170dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="9dp">
                            <TextView
                                android:id="@+id/tvSelectedEmployeeInitials"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:gravity="center"
                                android:text="E"
                                android:textColor="@android:color/white"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:background="@drawable/bg_selected_employee_avatar" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tvSelectedEmployeeName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:text="Employee"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/tvSelectedEmployeeStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="● LIVE"
                                    android:textColor="@color/green_700"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="230dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="9dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT LOCATION" android:textColor="?attr/colorPrimary" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.08" />
                            <TextView android:id="@+id/tvSelectedLocationAddress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="GPS location selected" android:textColor="?attr/colorOnSurface" android:textSize="11sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvSelectedLocationCoords" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="Lat / Long" android:textColor="@color/text_secondary" android:textSize="8sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="150dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AT THIS LOCATION" android:textColor="?attr/colorPrimary" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.08" />
                            <TextView android:id="@+id/tvSelectedStayDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="--" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Current GPS session" android:textColor="@color/text_secondary" android:textSize="8sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="135dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPS ACCURACY" android:textColor="?attr/colorPrimary" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.08" />
                            <TextView android:id="@+id/tvSelectedAccuracy" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="--" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Precision" android:textColor="@color/text_secondary" android:textSize="8sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="165dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DISTANCE FROM OFFICE" android:textColor="?attr/colorPrimary" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.06" />
                            <TextView android:id="@+id/tvSelectedDistance" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="--" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:id="@+id/tvSelectedRadiusStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Radius status" android:textColor="@color/text_secondary" android:textSize="8sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="150dp"
                        android:layout_height="68dp"
                        android:layout_marginEnd="7dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/divider">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LAST UPDATED" android:textColor="?attr/colorPrimary" android:textSize="8sp" android:textStyle="bold" android:letterSpacing="0.08" />
                            <TextView android:id="@+id/tvSelectedLastUpdated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="--:--:--" android:textColor="?attr/colorOnSurface" android:textSize="15sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Realtime GPS" android:textColor="@color/text_secondary" android:textSize="8sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>
        </com.google.android.material.card.MaterialCardView>

        <org.osmdroid.views.MapView
            android:id="@+id/mapview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/cardSelectedLocationRail"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLiveStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_marginEnd="12dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="@drawable/bg_premium_card">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE OPERATIONS" android:textSize="9sp" android:textStyle="bold" android:letterSpacing="0.08" android:textColor="@color/text_secondary"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:orientation="horizontal">
                    <TextView android:id="@+id/tvLiveCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 Live" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/green_700"/>
                    <TextView android:id="@+id/tvOutsideCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="0 Outside" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/red_700"/>
                </LinearLayout>
                <TextView android:id="@+id/tvMapSync" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Realtime sync" android:textSize="9sp" android:textColor="@color/text_secondary"/>
                <TextView android:id="@+id/tvTrackingPolicy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tracking policy • loading" android:textSize="9sp" android:textStyle="bold" android:textColor="@color/text_secondary"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:id="@+id/mapCommandRailScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:scrollbars="none"
            android:background="@drawable/bg_premium_card"
            android:elevation="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapFit"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="⌖"
                    android:textSize="17sp"
                    android:contentDescription="Fit all staff"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminMapOffice"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="⌂"
                    android:textSize="17sp"
                    android:contentDescription="Focus office"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminMapFollow"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="⦿"
                    android:textSize="17sp"
                    android:contentDescription="Follow selected"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminMapZone"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="◎"
                    android:textSize="17sp"
                    android:contentDescription="Toggle zone"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdminMapTrail"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="〰"
                    android:textSize="17sp"
                    android:contentDescription="Toggle trails"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapLayer"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="▦"
                    android:textSize="17sp"
                    android:contentDescription="Change map layer"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMapFullscreen"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:minWidth="0dp"
                    android:text="⛶"
                    android:textSize="17sp"
                    android:contentDescription="Full screen layout"
                    app:cornerRadius="12dp"
                    style="@style/Widget.Material3.Button.TextButton"/>

            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLegend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_circle" android:backgroundTint="#3B82F6" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Within Range" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">
                    <View android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/shape_circle" android:backgroundTint="#EF4444" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Outside Range" android:textSize="11sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
