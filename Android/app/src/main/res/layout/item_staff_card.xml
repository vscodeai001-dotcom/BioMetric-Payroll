<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStaffRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/staff_card_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/staff_card_stroke">

    <LinearLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header: #ID, Avatar Initial, Name, Biometric ID, Role Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- # Employee ID -->
            <TextView
                android:id="@+id/tvEmployeeIdBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_clickable"
                android:backgroundTint="#124F46E5"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:textColor="@color/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="#4" />

            <!-- Circular Avatar with Initial -->
            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_small"
                android:backgroundTint="#204F46E5"
                android:gravity="center"
                android:textColor="@color/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="D" />

            <!-- Name and Biometric Tag -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Dinesh" />

                <TextView
                    android:id="@+id/tvBiometricIdBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="🧬 1524" />

            </LinearLayout>

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tvStaffRoleName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_clickable"
                android:backgroundTint="#152563EB"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#2563EB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Sales Officer" />

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            app:dividerColor="#10000000" />

        <!-- 1:1 Mirror Data Grid: Pay & Dates, Shift & Break, Off & OT, Tracking -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Column 1: Pay + Hire Date + Weekly Off -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="6dp">

                <!-- 💵 Pay -->
                <TextView
                    android:id="@+id/tvPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="₹15,000/mo" />

                <!-- 🗓️ Hire Date -->
                <TextView
                    android:id="@+id/tvHireDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="🗓️ 24-Jun-26" />

                <!-- 🏖️ Off & OT -->
                <TextView
                    android:id="@+id/tvOffAndOt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="🏖️ Sunday • ⚡ 1.0x" />

            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#10000000" />

            <!-- Column 2: Shift + Break + Shift Mode + Tracking Mode -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <!-- ⏰ Shift Time -->
                <TextView
                    android:id="@+id/tvShiftTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="⏰ 10:30 am – 04:30 pm" />

                <!-- ☕ Break & Shift Mode -->
                <TextView
                    android:id="@+id/tvBreakAndMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="☕ 60m • Single Day" />

                <!-- 🛰️ Tracking Mode -->
                <TextView
                    android:id="@+id/tvTrackingMode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="🛰️ 24/7 Tracking" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            app:dividerColor="#10000000" />

        <!-- Actions Row: View, Edit, Delete (Matching Web 1:1) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 👁️ View Details -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewRecords"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="View 👁️"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:textColor="#0284C7"
                app:backgroundTint="#120284C7" />

            <!-- ✏️ Edit Profile -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditStaff"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                android:text="Edit ✏️"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:textColor="@color/colorPrimary"
                app:backgroundTint="#154F46E5" />

            <!-- 🗑️ Delete Staff -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteStaff"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Delete 🗑️"
                android:textSize="11sp"
                app:cornerRadius="10dp"
                android:textColor="#EF4444"
                app:backgroundTint="#15EF4444" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
