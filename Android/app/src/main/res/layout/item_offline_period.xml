<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Employee + Disconnected & Reconnected Interval + Duration Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivPeriodIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_clock"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPeriodTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurface"
                    android:text="Employee Name" />

                <TextView
                    android:id="@+id/tvPeriodWindow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:text="Disconnected: 10:15:30 → Reconnected: 11:00:15 IST" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvPeriodDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/bg_rounded_card_outline"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="?attr/colorPrimary"
                android:text="44m 45s" />
        </LinearLayout>

        <!-- Disconnection Cause & Sync Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPeriodReason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:text="✈️ Airplane Mode" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/tvPeriodSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:text="✓ Reconciled into Live Data" />
        </LinearLayout>

        <!-- Offline Attendance Punches Section -->
        <LinearLayout
            android:id="@+id/llOfflinePunchesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_rounded_card_outline"
            android:padding="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attendance Punches during this Disconnection Gap:"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tvPeriodPunches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textSize="11sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="No attendance punches taken during this gap" />
        </LinearLayout>

        <!-- Live Reconciliation Impact / Changes Summary -->
        <TextView
            android:id="@+id/tvPeriodLiveImpact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="11sp"
            android:textColor="#1565C0"
            android:text="Live Impact: Punches &amp; breadcrumbs synced to cloud upon reconnection" />

        <!-- Movement Breadcrumbs Stats -->
        <TextView
            android:id="@+id/tvPeriodStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:text="18 points captured • 2.4 km • Within office: 14 / Outside: 4" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewPeriodRoute"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:text="Inspect Offline Path on Map" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
