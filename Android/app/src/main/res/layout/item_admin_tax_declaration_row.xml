<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PremiumCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Employee Info & Regime/Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/blue_light"
                android:gravity="center"
                android:text="📑"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmployeeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Alex Morgan" />

                <TextView
                    android:id="@+id/tvEmployeeMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="EMP #101 • FY 2025-2026" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRegimeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_small"
                    android:backgroundTint="@color/blue_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="NEW REGIME"
                    android:textColor="@color/blue_900"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:background="@drawable/bg_pill_small"
                    android:backgroundTint="@color/amber_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="PENDING"
                    android:textColor="@color/amber_900"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:alpha="0.25"
            android:background="?attr/colorOutlineVariant" />

        <!-- Deductions breakdown chips -->
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp">

            <!-- 80C -->
            <TextView
                android:id="@+id/chip80C"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🛡️ 80C: ₹1,50,000" />

            <!-- 80D -->
            <TextView
                android:id="@+id/chip80D"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏥 80D: ₹25,000" />

            <!-- HRA / Rent Paid -->
            <TextView
                android:id="@+id/chipHra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏠 Rent: ₹1,20,000" />

            <!-- Other Exemptions -->
            <TextView
                android:id="@+id/chipOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🪙 Other: ₹10,000" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Admin Remarks Text (if any) -->
        <TextView
            android:id="@+id/tvRemarks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.8"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Remarks: Approved based on rent receipts submitted."
            tools:visibility="visible" />

        <!-- Actions Row (Approve / Reject) -->
        <LinearLayout
            android:id="@+id/llActionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:text="❌ Reject"
                android:textColor="@color/red_700"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/red_700" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="@color/green_700"
                android:paddingHorizontal="12dp"
                android:text="✅ Approve"
                android:textColor="@color/white"
                android:textSize="11sp"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
