<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/clAdminAttendanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:title="Attendance Logs &amp; Reports 📊" app:navigationIcon="@drawable/ic_arrow_back"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="12dp">
<TextView android:id="@+id/tvFrom" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@drawable/bg_premium_card" android:layout_marginEnd="6dp"/>
<TextView android:id="@+id/tvTo" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:gravity="center" android:textStyle="bold" android:background="@drawable/bg_premium_card" android:layout_marginStart="6dp"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnGenerate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="12dp" android:text="Generate Attendance Report"/>
<TextView android:id="@+id/tvSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:textStyle="bold" android:textColor="@color/text_primary"/>
<ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone"/>
<TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="24dp" android:gravity="center" android:text="No attendance summaries found." android:visibility="gone"/>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAttendance" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="12dp" android:clipToPadding="false"/>
</LinearLayout>
