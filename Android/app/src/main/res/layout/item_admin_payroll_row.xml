<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PremiumCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Employee info & Net Salary Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAvatarIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/blue_light"
                android:gravity="center"
                android:text="👤"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvEmployeeName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Alex Morgan" />

                <TextView
                    android:id="@+id/tvEmployeeId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="EMP #101 • Hourly: ₹250/h" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNetPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/green_700"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="₹45,200" />

                <TextView
                    android:id="@+id/tvRowStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_pill_small"
                    android:backgroundTint="@color/green_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="NET PAY"
                    android:textColor="@color/green_900"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:alpha="0.25"
            android:background="?attr/colorOutlineVariant" />

        <!-- Key Metrics Strip: Base, Worked, OT, Penalties, Absent -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="BASE / EARNED"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEarnedPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="₹42,000" />

                <TextView
                    android:id="@+id/tvHoursWorked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.75"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="⏱️ 168.0h" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="OVERTIME / PENALTY"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOvertimePay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/green_700"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="+₹3,200 (12h)" />

                <TextView
                    android:id="@+id/tvPenaltyDed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/red_700"
                    android:textSize="11sp"
                    tools:text="-₹400 (45m)" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:text="ATTENDANCE"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLeavesAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="M: 1 • A: 0" />

                <TextView
                    android:id="@+id/tvGrossPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.85"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    tools:text="Gross: ₹48,400" />
            </LinearLayout>
        </LinearLayout>

        <!-- Chips Container: Statutory Deductions & Additions -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupBreakdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="4dp">

            <!-- PF -->
            <TextView
                android:id="@+id/chipPf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/amber_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/amber_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🛡️ PF: ₹1,800" />

            <!-- ESI -->
            <TextView
                android:id="@+id/chipEsi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/amber_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/amber_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏥 ESI: ₹315" />

            <!-- PT -->
            <TextView
                android:id="@+id/chipPt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/blue_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/blue_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏛️ PT: ₹200" />

            <!-- TDS -->
            <TextView
                android:id="@+id/chipTds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/red_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/red_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🏷️ TDS: ₹1,200" />

            <!-- Advance Deduction -->
            <TextView
                android:id="@+id/chipAdvanceDed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/red_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/red_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="💳 Adv: -₹2,000" />

            <!-- Bonus (Clickable to adjust in Preview mode) -->
            <TextView
                android:id="@+id/chipBonus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_clickable"
                android:backgroundTint="@color/green_light"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/green_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🎁 Bonus: +₹1,500 ✏️" />

            <!-- Shift Allowance -->
            <TextView
                android:id="@+id/chipShiftAllowance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/blue_light"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="@color/blue_900"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="🌙 Shift Allow: +₹800" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Bottom Action Bar (History Mode: Payslip & CSV) -->
        <LinearLayout
            android:id="@+id/llRowActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRowViewPayslip"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:text="📄 View Payslip"
                android:textSize="11sp"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
