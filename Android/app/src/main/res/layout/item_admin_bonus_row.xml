<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/PremiumCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Avatar, Staff Name, Amount -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/green_light"
                android:gravity="center"
                android:text="🎁"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Priya Sharma" />

                <TextView
                    android:id="@+id/tvBonusMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.75"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    tools:text="Staff ID #105 • 24 Oct 2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvBonusAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_700"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="+₹5,000" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:alpha="0.25"
            android:background="?attr/colorOutlineVariant" />

        <!-- Description / Note -->
        <TextView
            android:id="@+id/tvBonusDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.85"
            android:textColor="?attr/colorOnSurface"
            android:textSize="12sp"
            tools:text="Reason: Festival Bonus (Diwali Celebration)" />

        <!-- Bottom Row: Status Badge & Delete Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_small"
                android:backgroundTint="@color/amber_light"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="PENDING PAYROLL INCLUSION"
                android:textColor="@color/amber_900"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="PENDING PAYROLL" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteBonus"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:text="🗑️ Delete"
                android:textColor="@color/red_700"
                android:textSize="11sp"
                app:cornerRadius="18dp"
                app:strokeColor="@color/red_700" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
